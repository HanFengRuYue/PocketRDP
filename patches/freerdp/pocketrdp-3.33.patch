+BOOL rdpudp_test_v1_lossy_skip_missing(UINT32 initialSeq, UINT32 arrivedSeq, UINT32* recvSeqOut,
+                                       UINT32* recvReadSeqOut, UINT64* droppedOut)
+{
+	rdpUdpConnection* conn = (rdpUdpConnection*)calloc(1, sizeof(*conn));
+	if (!conn)
+		return FALSE;
+
+	rdpUdpClientBootstrapResult result = WINPR_C_ARRAY_INIT;
+	conn->sock = INVALID_SOCKET;
+	conn->negotiatedVersion = RDPUDP_PROTOCOL_VERSION_2;
+	conn->lossy = TRUE;
+	conn->wireMtu = RDPUDP_DEFAULT_MTU;
+	conn->receivedData = TRUE;
+	conn->recvSequence = initialSeq;
+	conn->recvReadSequence = initialSeq;
+	conn->recvAckHigh = initialSeq;
+	conn->ackVectorStart = initialSeq + 1u;
+	conn->result = &result;
+
+	const BYTE sample[4] = { 1, 2, 3, 4 };
+	BOOL ok = rdpudp1_queue_source_payload(conn, arrivedSeq, sample, sizeof(sample));
+	if (ok)
+	{
+		/* Simulate out-of-order timeout having elapsed. */
+		conn->lossyOutOfOrderSinceMs =
+		    GetTickCount64() > (RDPUDP1_LOSSY_OUT_OF_ORDER_TIMEOUT_MS + 10u)
+		        ? GetTickCount64() - (RDPUDP1_LOSSY_OUT_OF_ORDER_TIMEOUT_MS + 10u)
+		        : 1u;
+		BYTE out[8] = { 0 };
+		const int delivered = rdpudp1_read_buffered_payload(conn, out, sizeof(out));
+		ok = delivered == (int)sizeof(sample) && memcmp(out, sample, sizeof(sample)) == 0;
+		if (recvSeqOut)
+			*recvSeqOut = conn->recvSequence;
+		if (recvReadSeqOut)
+			*recvReadSeqOut = conn->recvReadSequence;
+		if (droppedOut)
+			*droppedOut = result.droppedPackets;
+	}
+
+	rdpudp_connection_free(conn);
+	return ok;
+}
