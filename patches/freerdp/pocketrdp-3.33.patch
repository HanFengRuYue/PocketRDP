+static INT64 rdpudp_timeval_to_ms_clamped(const struct timeval* tv)
+{
+	if (!tv || tv->tv_sec < 0 || tv->tv_usec < 0)
+		return 0;
+	if (tv->tv_sec == 0 && tv->tv_usec == 0)
+		return 0;
+	const INT64 maxSecs = (INT64_MAX / 1000LL) - 1LL;
+	const INT64 secs = (INT64)tv->tv_sec > maxSecs ? maxSecs : (INT64)tv->tv_sec;
+	return (secs * 1000LL) + ((INT64)tv->tv_usec / 1000LL);
+}
+
+static UINT64 rdpudp_next_timeout_deadline_ms(const struct timeval* tv)
+{
+	if (!tv || tv->tv_sec < 0 || tv->tv_usec < 0 || (tv->tv_sec == 0 && tv->tv_usec == 0))
+		return 0;
+
+	const UINT64 nowMono = GetTickCount64();
+#if !defined(_WIN32)
+	/* OpenSSL passes an absolute wall-clock struct timeval to BIO_CTRL_DGRAM_SET_NEXT_TIMEOUT.
+	 * Distinguish absolute epoch timestamps from small relative durations used in tests. */
+	if (tv->tv_sec >= 86400)
+	{
+		struct timeval nowTv = WINPR_C_ARRAY_INIT;
+		if (gettimeofday(&nowTv, nullptr) == 0)
+		{
+			const INT64 diffSec = (INT64)tv->tv_sec - (INT64)nowTv.tv_sec;
+			const INT64 diffUsec = (INT64)tv->tv_usec - (INT64)nowTv.tv_usec;
+			if (diffSec > (INT64_MAX / 1000LL) - 2LL)
+				return nowMono + 60000ULL;
+			const INT64 deltaMs = (diffSec * 1000LL) + (diffUsec / 1000LL);
+			return deltaMs <= 0 ? nowMono : (nowMono + (UINT64)deltaMs);
+		}
+	}
+#endif
+	const INT64 relMs = rdpudp_timeval_to_ms_clamped(tv);
+	return nowMono + (UINT64)(relMs > 0 ? relMs : 1);
+}
