+BOOL rdpudp_test_v1_encode_ack_vector(BOOL receivedData, UINT32 ackVectorStart, UINT32 recvSequence,
+                                      UINT32 recvAckHigh, const UINT32* presentSeqs,
+                                      size_t presentCount, size_t maxRoom, BYTE* out,
+                                      size_t outCapacity, size_t* outLength)
+{
+	if (!out || !outLength)
+		return FALSE;
+	*outLength = 0;
+
+	rdpUdpConnection* conn = (rdpUdpConnection*)calloc(1, sizeof(*conn));
+	if (!conn)
+		return FALSE;
+
+	conn->sock = INVALID_SOCKET;
+	conn->wireMtu = RDPUDP_DEFAULT_MTU;
+	conn->receivedData = receivedData;
+	conn->ackVectorStart = ackVectorStart;
+	conn->recvSequence = recvSequence;
+	conn->recvAckHigh = recvAckHigh;
+
+	for (size_t i = 0; i < presentCount && i < ARRAYSIZE(conn->recvSegments); i++)
+	{
+		conn->recvSegments[i].inUse = TRUE;
+		conn->recvSegments[i].channelSequence = presentSeqs[i];
+	}
+
+	wStream* s = Stream_New(nullptr, outCapacity > 16 ? outCapacity : 16);
+	BOOL ok = s != nullptr && rdpudp1_write_ack_vector(s, conn, maxRoom);
+	if (ok)
+	{
+		const size_t pos = Stream_GetPosition(s);
+		if (pos <= outCapacity)
+		{
+			memcpy(out, Stream_Buffer(s), pos);
+			*outLength = pos;
+		}
+		else
+			ok = FALSE;
+	}
+
+	Stream_Free(s, TRUE);
+	rdpudp_connection_free(conn);
+	return ok;
+}
