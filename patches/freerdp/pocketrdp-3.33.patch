+BOOL rdpudp_test_v1_send_segment_large_ack_vector(UINT16 negotiatedMtu, size_t alternatingGaps,
+                                                  size_t payloadLen, size_t* wireLenOut)
+{
+	rdpUdpConnection* conn = (rdpUdpConnection*)calloc(1, sizeof(*conn));
+	if (!conn)
+		return FALSE;
+
+	conn->sock = INVALID_SOCKET;
+	conn->negotiatedVersion = RDPUDP_PROTOCOL_VERSION_2;
+	conn->wireMtu = rdpudp_clamp_mtu(negotiatedMtu);
+	conn->receivedData = TRUE;
+	conn->ackVectorStart = 100u;
+	conn->recvSequence = 99u;
+	conn->codedSequence = 1000u;
+
+	const size_t maxSegs = ARRAYSIZE(conn->recvSegments);
+	const size_t pairs = alternatingGaps > maxSegs ? maxSegs : alternatingGaps;
+	UINT32 highest = 99u;
+	for (size_t i = 0; i < pairs; i++)
+	{
+		const UINT32 seq = 100u + (UINT32)(i * 2u + 1u);
+		conn->recvSegments[i].inUse = TRUE;
+		conn->recvSegments[i].channelSequence = seq;
+		highest = seq;
+	}
+	conn->recvAckHigh = highest;
+
+	BYTE* payload = payloadLen > 0 ? (BYTE*)malloc(payloadLen) : nullptr;
+	if (payloadLen > 0 && !payload)
+	{
+		rdpudp_connection_free(conn);
+		return FALSE;
+	}
+	if (payload)
+		memset(payload, 0x5A, payloadLen);
+
+	wStream* s = Stream_New(nullptr, conn->wireMtu);
+	BOOL ok = s != nullptr && rdpudp1_build_source_segment(conn, s, 500u, payload, payloadLen);
+	if (ok && wireLenOut)
+		*wireLenOut = Stream_GetPosition(s);
+
+	Stream_Free(s, TRUE);
+	free(payload);
+	rdpudp_connection_free(conn);
+	return ok;
+}
