+BOOL rdpudp_test_v1_decode_ack_vector(UINT32 sourceAck, const BYTE* vector, size_t vectorSize,
+                                      const UINT32* pendingSeqs, size_t pendingCount,
+                                      BOOL* ackedOut)
+{
+	if ((!vector && vectorSize > 0) || (!pendingSeqs && pendingCount > 0) ||
+	    (!ackedOut && pendingCount > 0) || pendingCount > ARRAYSIZE(((rdpUdpConnection*)0)->pending))
+		return FALSE;
+
+	rdpUdpConnection* conn = (rdpUdpConnection*)calloc(1, sizeof(*conn));
+	if (!conn)
+		return FALSE;
+
+	conn->sock = INVALID_SOCKET;
+	conn->wireMtu = RDPUDP_DEFAULT_MTU;
+	for (size_t i = 0; i < pendingCount; i++)
+	{
+		conn->pending[i].inUse = TRUE;
+		conn->pending[i].dataSequence = pendingSeqs[i];
+	}
+
+	const BOOL ok = rdpudp1_process_ack_vector(conn, sourceAck, vector, vectorSize, FALSE);
+	if (ok)
+	{
+		for (size_t i = 0; i < pendingCount; i++)
+			ackedOut[i] = !conn->pending[i].inUse;
+	}
+
+	rdpudp_connection_free(conn);
+	return ok;
+}
