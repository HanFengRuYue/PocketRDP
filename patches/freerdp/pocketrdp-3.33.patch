+	const DWORD status = WaitForSingleObject(deferred->worker, INFINITE);
+	if (status == WAIT_OBJECT_0)
+		android_finalize_instance(deferred->instance, deferred->worker);
+	else
+		WLog_ERR(TAG, "deferred native cleanup wait failed; leaking context to avoid use-after-free");
+	free(deferred);
+	return status;
