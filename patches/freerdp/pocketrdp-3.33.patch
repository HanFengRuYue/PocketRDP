+static INIT_ONCE g_RdpUdpBioOnce = INIT_ONCE_STATIC_INIT;
+static BIO_METHOD* g_RdpUdpStreamBioMethods = nullptr;
+static BIO_METHOD* g_RdpUdpDgramBioMethods = nullptr;
+
+static BIO_METHOD* bio_rdpudp_create_method(BOOL datagram)
+{
+	BIO_METHOD* method = BIO_meth_new(datagram ? BIO_TYPE_DGRAM : BIO_TYPE_SOURCE_SINK,
+	                                  datagram ? "RDPUDP-DGRAM" : "RDPUDP");
+	if (!method)
+		return nullptr;
+	BIO_meth_set_write(method, bio_rdpudp_write);
+	BIO_meth_set_read(method, bio_rdpudp_read);
+	BIO_meth_set_puts(method, bio_rdpudp_puts);
+	BIO_meth_set_gets(method, bio_rdpudp_gets);
+	BIO_meth_set_ctrl(method, bio_rdpudp_ctrl);
+	BIO_meth_set_create(method, bio_rdpudp_new);
+	BIO_meth_set_destroy(method, bio_rdpudp_free);
+	return method;
+}
+
+static BOOL CALLBACK bio_rdpudp_init_once(PINIT_ONCE once, PVOID param, PVOID* context)
+{
+	WINPR_UNUSED(once);
+	WINPR_UNUSED(param);
+	WINPR_UNUSED(context);
+
+	g_RdpUdpStreamBioMethods = bio_rdpudp_create_method(FALSE);
+	g_RdpUdpDgramBioMethods = bio_rdpudp_create_method(TRUE);
+	return (g_RdpUdpStreamBioMethods != nullptr) && (g_RdpUdpDgramBioMethods != nullptr);
+}
+
+static BIO_METHOD* BIO_s_rdpudp(BOOL datagram)
+{
+	if (!InitOnceExecuteOnce(&g_RdpUdpBioOnce, bio_rdpudp_init_once, nullptr, nullptr))
+		return nullptr;
+	return datagram ? g_RdpUdpDgramBioMethods : g_RdpUdpStreamBioMethods;
+}
+
+static BIO* rdpudp_connection_new_bio(rdpUdpConnection* connection, BOOL datagram)
+{
+	BIO_METHOD* method = BIO_s_rdpudp(datagram);
+	if (!method)
+		return nullptr;
+	BIO* bio = BIO_new(method);
+	if (!bio)
+		return nullptr;
+
+	BIO_RDPUDP* ptr = (BIO_RDPUDP*)BIO_get_data(bio);
+	if (!ptr)
+	{
+		BIO_free(bio);
+		return nullptr;
+	}
+
+	ptr->connection = connection;
+	ptr->datagram = datagram;
+	return bio;
+}
