+BOOL rdpudp_test_v1_recv_edge_cases(void)
+{
+	rdpUdpConnection* conn = (rdpUdpConnection*)calloc(1, sizeof(*conn));
+	if (!conn)
+		return FALSE;
+
+	rdpUdpClientBootstrapResult result = WINPR_C_ARRAY_INIT;
+	result.negotiatedVersion = RDPUDP_PROTOCOL_VERSION_2;
+	result.initialSequence = 50u;
+	result.serverInitialSequence = 0xFFFFFFFDu;
+	result.upstreamMtu = 1132u;
+	conn->sock = INVALID_SOCKET;
+	conn->lossy = TRUE;
+	conn->result = &result;
+	rdpudp_connection_init_sequences(conn, &result);
+
+	BOOL ok = conn->wireMtu == 1132u && rdpudp_connection_max_payload(conn) == 1132u - 48u;
+
+	/* 1. Short (<8 B) datagram must be ignored (return 0), NOT kill the tunnel (-1). */
+	const BYTE shortPkt[3] = { 0xDE, 0xAD, 0xBE };
+	BYTE out[32] = { 0 };
+	if (rdpudp1_process_datagram(conn, shortPkt, sizeof(shortPkt), out, sizeof(out), FALSE) != 0)
+		ok = FALSE;
+
+	/* 2. Retransmitted SYN+ACK must return 0 (not fail). */
+	BYTE synAck[16] = { 0 };
+	wStream sb = WINPR_C_ARRAY_INIT;
+	wStream* s = Stream_StaticInit(&sb, synAck, sizeof(synAck));
+	Stream_Write_UINT32_BE(s, 50u);
+	Stream_Write_UINT16_BE(s, 1024u);
+	Stream_Write_UINT16_BE(s, RDPUDP_FLAG_SYN | RDPUDP_FLAG_ACK);
+	if (rdpudp1_process_datagram(conn, synAck, sizeof(synAck), out, sizeof(out), FALSE) != 0)
+		ok = FALSE;
+
+	/* 3. Sequence wrap across 0xFFFFFFFE -> 0xFFFFFFFF -> 0 -> 1 (sourceSeq == 0 delivered!). */
+	const UINT32 seqs[4] = { 0xFFFFFFFEu, 0xFFFFFFFFu, 0u, 1u };
+	for (size_t i = 0; i < 4 && ok; i++)
+	{
+		BYTE pkt[24] = { 0 };
+		wStream psb = WINPR_C_ARRAY_INIT;
+		wStream* ps = Stream_StaticInit(&psb, pkt, sizeof(pkt));
+		Stream_Write_UINT32_BE(ps, 50u);
+		Stream_Write_UINT16_BE(ps, 1024u);
+		Stream_Write_UINT16_BE(ps, RDPUDP_FLAG_DATA);
+		Stream_Write_UINT32_BE(ps, (UINT32)(100u + i));
+		Stream_Write_UINT32_BE(ps, seqs[i]);
+		Stream_Write_UINT8(ps, (BYTE)(0xA0u + i));
+		const int n =
+		    rdpudp1_process_datagram(conn, pkt, Stream_GetPosition(ps), out, sizeof(out), FALSE);
+		if (n != 1 || out[0] != (BYTE)(0xA0u + i))
+			ok = FALSE;
+	}
+
+	/* 4. ACK_OF_ACKS advances ackVectorStart (and lossy recvSequence). */
+	BYTE aoaPkt[12] = { 0 };
+	wStream asb = WINPR_C_ARRAY_INIT;
+	wStream* as = Stream_StaticInit(&asb, aoaPkt, sizeof(aoaPkt));
+	Stream_Write_UINT32_BE(as, 50u);
+	Stream_Write_UINT16_BE(as, 1024u);
+	Stream_Write_UINT16_BE(as, RDPUDP_FLAG_ACK_OF_ACKS);
+	Stream_Write_UINT32_BE(as, 5u);
+	if (rdpudp1_process_datagram(conn, aoaPkt, sizeof(aoaPkt), out, sizeof(out), FALSE) != 0 ||
+	    conn->recvSequence != 5u || conn->ackVectorStart != 6u)
+		ok = FALSE;
+
+	rdpudp_connection_free(conn);
+	return ok;
+}
+
+BOOL rdpudp_test_v3_sequence_and_wire(void)
+{
+	rdpUdpConnection* conn = (rdpUdpConnection*)calloc(1, sizeof(*conn));
+	if (!conn)
+		return FALSE;
+
+	rdpUdpClientBootstrapResult result = WINPR_C_ARRAY_INIT;
+	result.negotiatedVersion = RDPUDP_PROTOCOL_VERSION_3;
+	result.initialSequence = 0x12345678u;
+	result.serverInitialSequence = 0xCAFEBABEu;
+	result.upstreamMtu = RDPUDP_DEFAULT_MTU;
+	conn->sock = INVALID_SOCKET;
+	conn->result = &result;
+	rdpudp_connection_init_sequences(conn, &result);
+
+	BOOL ok = conn->sendSequence == RDPUDP2_INITIAL_SEQUENCE && conn->channelSequence == 1u &&
+	          conn->recvChannelSequence == 1u && !conn->recvSequenceInitialized;
+
+	/* 1. Short (<8 B) datagram ignored (returns 0). */
+	BYTE shortPkt[4] = { 0x01, 0x02, 0x03, 0x04 };
+	BYTE out[32] = { 0 };
+	if (rdpudp2_process_datagram(conn, shortPkt, sizeof(shortPkt), out, sizeof(out), FALSE) != 0)
+		ok = FALSE;
+
+	/* 2. Valid Windows UDP2 first DATA packet with 0xE0 prefix, AOA=498, dataSeq=500, chanSeq=1. */
+	BYTE wire[32] = { 0 };
+	wStream sb = WINPR_C_ARRAY_INIT;
+	wStream* s = Stream_StaticInit(&sb, wire, sizeof(wire));
+	if (!Stream_SetPosition(s, 1))
+		ok = FALSE;
+	const UINT16 hdr =
+	    (UINT16)((RDPUDP2_FLAG_DATA | RDPUDP2_FLAG_AOA) | (RDPUDP2_LOG_WINDOW << 12u));
+	Stream_Write_UINT16(s, hdr);
+	Stream_Write_UINT16(s, 498u); /* AOA */
+	Stream_Write_UINT16(s, 500u); /* DataSeqNum */
+	Stream_Write_UINT16(s, 1u);   /* ChannelSeqNum */
+	const BYTE msg[5] = { 'H', 'E', 'L', 'L', 'O' };
+	Stream_Write(s, msg, sizeof(msg));
+	if (!rdpudp2_finalize_wire_packet(s, RDPUDP2_PACKET_TYPE_DATA))
+		ok = FALSE;
+	/* Byte 7 holds the prefix byte on the wire: shortLength=7, type=0 -> 0xE0. */
+	if (wire[7] != 0xE0u)
+		ok = FALSE;
+
+	const int delivered =
+	    rdpudp2_process_datagram(conn, wire, Stream_GetPosition(s), out, sizeof(out), FALSE);
+	if (delivered != (int)sizeof(msg) || memcmp(out, msg, sizeof(msg)) != 0 ||
+	    !conn->recvSequenceInitialized || (UINT16)conn->recvSequence != 497u ||
+	    (UINT16)conn->recvAckHigh != 500u || conn->recvChannelSequence != 2u)
+		ok = FALSE;
+
+	/* 3. Dummy packet (packetType=8) with DATA dataSeq=501 must be accepted without channelSeq. */
+	BYTE dummy[16] = { 0 };
+	wStream dsb = WINPR_C_ARRAY_INIT;
+	wStream* ds = Stream_StaticInit(&dsb, dummy, sizeof(dummy));
+	if (!Stream_SetPosition(ds, 1))
+		ok = FALSE;
+	Stream_Write_UINT16(ds, (UINT16)(RDPUDP2_FLAG_DATA | (RDPUDP2_LOG_WINDOW << 12u)));
+	Stream_Write_UINT16(ds, 501u);
+	if (!rdpudp2_finalize_wire_packet(ds, RDPUDP2_PACKET_TYPE_DUMMY))
+		ok = FALSE;
+	/* layout = 4 -> shortLength=4, type=8 -> (4<<5)|(8<<1) = 0x80 | 0x10 = 0x90. */
+	if (dummy[7] != 0x90u)
+		ok = FALSE;
+	if (rdpudp2_process_datagram(conn, dummy, Stream_GetPosition(ds), out, sizeof(out), FALSE) !=
+	        0 ||
+	    (UINT16)conn->recvAckHigh != 501u || conn->recvChannelSequence != 2u)
+		ok = FALSE;
+
+	/* 4. Reserved bit 0 set in prefix byte must be ignored. */
+	BYTE badPrefix[12] = { 0 };
+	badPrefix[7] = 0xE1u;
+	if (rdpudp2_process_datagram(conn, badPrefix, sizeof(badPrefix), out, sizeof(out), FALSE) != 0)
+		ok = FALSE;
+
+	/* 5. Channel sequence wrap 0xFFFF -> 1 skips 0. */
+	conn->recvChannelSequence = 0xFFFFu;
+	const BYTE wrapMsg[2] = { 0x11, 0x22 };
+	if (!rdpudp2_queue_channel_payload(conn, 0xFFFFu, wrapMsg, 1) ||
+	    !rdpudp2_queue_channel_payload(conn, 1u, &wrapMsg[1], 1) ||
+	    rdpudp2_read_buffered_payload(conn, out, 1) != 1 || out[0] != 0x11 ||
+	    conn->recvChannelSequence != 1u ||
+	    rdpudp2_read_buffered_payload(conn, out, 1) != 1 || out[0] != 0x22 ||
+	    conn->recvChannelSequence != 2u)
+		ok = FALSE;
+
+	rdpudp_connection_free(conn);
+	return ok;
+}
+
+BOOL rdpudp_test_dtls_bio_timers(void)
+{
+	rdpUdpConnection* conn = (rdpUdpConnection*)calloc(1, sizeof(*conn));
+	if (!conn)
+		return FALSE;
+
+	conn->sock = INVALID_SOCKET;
+	conn->lossy = TRUE;
+	conn->readTimeoutMs = 0;
+	conn->wireMtu = RDPUDP_DEFAULT_MTU;
+	conn->mtu = RDPUDP_DEFAULT_MTU - RDPUDP1_MAX_WIRE_OVERHEAD;
+
+	BIO* bio = rdpudp_connection_new_bio(conn, TRUE);
+	if (!bio)
+	{
+		rdpudp_connection_free(conn);
+		return FALSE;
+	}
+
+	BOOL ok = TRUE;
+#ifdef BIO_CTRL_DGRAM_SET_RECV_TIMEOUT
+	/* 1. Setting a positive DTLS recv timeout must NOT touch readTimeoutMs (stays 0). */
+	struct timeval tv = { .tv_sec = 4, .tv_usec = 500000 };
+	if (BIO_ctrl(bio, BIO_CTRL_DGRAM_SET_RECV_TIMEOUT, 0, &tv) != 1 || conn->readTimeoutMs != 0 ||
+	    conn->dtlsRecvTimeoutMs != 4500LL || conn->dtlsTimeoutDeadlineMs == 0)
+		ok = FALSE;
+
+	/* 2. Clearing with {0, 0} clears deadline and recv timeout. */
+	struct timeval zero = { .tv_sec = 0, .tv_usec = 0 };
+	if (BIO_ctrl(bio, BIO_CTRL_DGRAM_SET_RECV_TIMEOUT, 0, &zero) != 1 ||
+	    conn->readTimeoutMs != 0 || conn->dtlsRecvTimeoutMs != 0 ||
+	    conn->dtlsTimeoutDeadlineMs != 0)
+		ok = FALSE;
+#endif
+#ifdef BIO_CTRL_DGRAM_SET_NEXT_TIMEOUT
+	/* 3. Next timeout never blocks readTimeoutMs; expired deadline reports 1 then resets to 0. */
+	struct timeval nextTv = { .tv_sec = 2, .tv_usec = 0 };
+	if (BIO_ctrl(bio, BIO_CTRL_DGRAM_SET_NEXT_TIMEOUT, 0, &nextTv) != 1 ||
+	    conn->readTimeoutMs != 0 || conn->dtlsTimeoutDeadlineMs == 0)
+		ok = FALSE;
+	conn->dtlsTimeoutDeadlineMs = 1u; /* force past deadline */
+#ifdef BIO_CTRL_DGRAM_GET_RECV_TIMER_EXP
+	if (BIO_ctrl(bio, BIO_CTRL_DGRAM_GET_RECV_TIMER_EXP, 0, nullptr) != 1)
+		ok = FALSE;
+	if (BIO_ctrl(bio, BIO_CTRL_DGRAM_GET_RECV_TIMER_EXP, 0, nullptr) != 0)
+		ok = FALSE;
+#endif
+	if (BIO_ctrl(bio, BIO_CTRL_DGRAM_SET_NEXT_TIMEOUT, 0, &zero) != 1 ||
+	    conn->dtlsTimeoutDeadlineMs != 0)
+		ok = FALSE;
+#endif
+
+	BIO_free(bio);
+	rdpudp_connection_free(conn);
+	return ok;
+}
+
+BOOL rdpudp_test_rdpemt_wire_frames(size_t framePayloadLen, BOOL withSubHeader,
+                                    size_t* queuedFramesOut, size_t* queuedBytesOut,
+                                    size_t* autoDetectCountOut)
+{
+	if (framePayloadLen > UINT16_MAX)
+		return FALSE;
+
+	rdpUdpTunnel* tunnel = (rdpUdpTunnel*)calloc(1, sizeof(*tunnel));
+	if (!tunnel)
+		return FALSE;
+	InitializeCriticalSection(&tunnel->lock);
+	tunnel->lockInitialized = TRUE;
+	tunnel->state = RDPUDP_TUNNEL_STATE_ACTIVE;
+
+	const BYTE subHeader[4] = { 4, RDPTUNNEL_SUBHEADER_AUTODETECT_REQUEST, 0x12, 0x34 };
+	const size_t subLen = withSubHeader ? sizeof(subHeader) : 0;
+	const size_t totalLen = RDPTUNNEL_HEADER_LENGTH + subLen + framePayloadLen;
+	wStream* s = Stream_New(nullptr, totalLen);
+	if (!s)
+	{
+		rdpudp_tunnel_free(tunnel);
+		return FALSE;
+	}
+
+	BOOL ok = rdpemt_write_tunnel_header_ex(s, RDPTUNNEL_ACTION_DATA,
+	                                        withSubHeader ? subHeader : nullptr, subLen,
+	                                        (UINT16)framePayloadLen);
+	if (ok && framePayloadLen > 0)
+	{
+		if (!Stream_EnsureRemainingCapacity(s, framePayloadLen))
+			ok = FALSE;
+		else
+		{
+			memset(Stream_Pointer(s), 0x42, framePayloadLen);
+			Stream_Seek(s, framePayloadLen);
+		}
+	}
+
+	if (ok)
+	{
+		/* Exercise the actual rdpudp_async_read_plaintext growth path past 61,699 bytes and EOF. */
+		BIO* memBio = BIO_new(BIO_s_mem());
+		if (!memBio)
+			ok = FALSE;
+		else
+		{
+			rdpTls fakeTls = WINPR_C_ARRAY_INIT;
+			fakeTls.bio = memBio;
+			tunnel->tls = &fakeTls;
+
+			const BYTE* src = Stream_Buffer(s);
+			size_t offset = 0;
+			(void)BIO_set_mem_eof_return(memBio, -1);
+			while (offset < totalLen && ok)
+			{
+				const size_t step = (totalLen - offset > 4096u) ? 4096u : (totalLen - offset);
+				if (BIO_write(memBio, src + offset, WINPR_ASSERTING_INT_CAST(int, step)) !=
+				    WINPR_ASSERTING_INT_CAST(int, step))
+				{
+					ok = FALSE;
+					break;
+				}
+				offset += step;
+				if (!rdpudp_async_read_plaintext(tunnel))
+					ok = FALSE;
+			}
+			/* Verify EOF (rc == 0, no retry) returns FALSE instead of treating tunnel as alive. */
+			if (ok)
+			{
+				(void)BIO_set_mem_eof_return(memBio, 0);
+				if (rdpudp_async_read_plaintext(tunnel))
+					ok = FALSE;
+			}
+			tunnel->tls = nullptr;
+			BIO_free(memBio);
+		}
+	}
+
+	if (ok)
+	{
+		if (tunnel->wireLength != 0)
+			ok = FALSE;
+		if (queuedFramesOut)
+			*queuedFramesOut = tunnel->rxQueuedFrames;
+		if (queuedBytesOut)
+			*queuedBytesOut = tunnel->rxQueuedBytes;
+		if (autoDetectCountOut)
+			*autoDetectCountOut = tunnel->autoDetectQueuedFrames;
+	}
+
+	Stream_Free(s, TRUE);
+	rdpudp_tunnel_free(tunnel);
+	return ok;
+}
+
+size_t rdpudp_test_lossy_max_dvc_pdu_size(UINT16 negotiatedMtu)
+{
+	return rdpudp_lossy_dvc_pdu_budget_for_mtu(negotiatedMtu);
 }
