+size_t rdpudp_tunnel_max_dvc_pdu_size(const rdpUdpTunnel* tunnel)
+{
+	if (!tunnel || !tunnel->connection)
+		return CHANNEL_CHUNK_LENGTH;
+	rdpUdpTunnel* mutableTunnel = (rdpUdpTunnel*)tunnel;
+	EnterCriticalSection(&mutableTunnel->lock);
+	const BOOL lossy = tunnel->connection->lossy;
+	const UINT16 wireMtu = tunnel->connection->wireMtu;
+	LeaveCriticalSection(&mutableTunnel->lock);
+	if (!lossy)
+		return CHANNEL_CHUNK_LENGTH;
+	return rdpudp_lossy_dvc_pdu_budget_for_mtu(wireMtu);
+}
