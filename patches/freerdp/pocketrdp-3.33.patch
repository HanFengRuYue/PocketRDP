+static long bio_rdpudp_ctrl(BIO* bio, int cmd, long arg1, void* arg2)
+{
+	BIO_RDPUDP* ptr = (BIO_RDPUDP*)BIO_get_data(bio);
+	rdpUdpConnection* connection = ptr ? ptr->connection : nullptr;
+
+	switch (cmd)
+	{
+		case BIO_CTRL_FLUSH:
+		case BIO_CTRL_DUP:
+			return 1;
+		case BIO_CTRL_PENDING:
+		case BIO_CTRL_WPENDING:
+			return 0;
+		case BIO_CTRL_GET_CLOSE:
+			return BIO_get_shutdown(bio);
+		case BIO_CTRL_SET_CLOSE:
+			BIO_set_shutdown(bio, (int)arg1);
+			return 1;
+#ifdef BIO_CTRL_DGRAM_QUERY_MTU
+		case BIO_CTRL_DGRAM_QUERY_MTU:
+#endif
+#ifdef BIO_CTRL_DGRAM_GET_MTU
+		case BIO_CTRL_DGRAM_GET_MTU:
+#endif
+#ifdef BIO_CTRL_DGRAM_GET_FALLBACK_MTU
+		case BIO_CTRL_DGRAM_GET_FALLBACK_MTU:
+#endif
+			return connection ? connection->mtu : (RDPUDP_DEFAULT_MTU - RDPUDP1_MAX_WIRE_OVERHEAD);
+#ifdef BIO_CTRL_DGRAM_SET_MTU
+		case BIO_CTRL_DGRAM_SET_MTU:
+			if (connection && arg1 > 0)
+				connection->mtu = arg1;
+			return arg1;
+#endif
+#ifdef BIO_CTRL_DGRAM_MTU_DISCOVER
+		case BIO_CTRL_DGRAM_MTU_DISCOVER:
+			return 1;
+#endif
+#ifdef BIO_CTRL_DGRAM_SET_RECV_TIMEOUT
+		case BIO_CTRL_DGRAM_SET_RECV_TIMEOUT:
+			/* Async BIO stays strictly non-blocking (readTimeoutMs == 0); record DTLS deadline. */
+			if (connection && arg2)
+			{
+				const struct timeval* tv = (const struct timeval*)arg2;
+				const INT64 timeoutMs = rdpudp_timeval_to_ms_clamped(tv);
+				connection->dtlsRecvTimeoutMs = timeoutMs;
+				connection->dtlsTimerExpired = FALSE;
+				if (timeoutMs <= 0)
+					connection->dtlsTimeoutDeadlineMs = 0;
+				else
+					connection->dtlsTimeoutDeadlineMs = GetTickCount64() + (UINT64)timeoutMs;
+			}
+			return 1;
+#endif
+#ifdef BIO_CTRL_DGRAM_GET_RECV_TIMEOUT
+		case BIO_CTRL_DGRAM_GET_RECV_TIMEOUT:
+			if (connection && arg2)
+			{
+				struct timeval* tv = (struct timeval*)arg2;
+				const INT64 ms =
+				    connection->dtlsRecvTimeoutMs > 0 ? connection->dtlsRecvTimeoutMs : 0;
+				tv->tv_sec = (long)(ms / 1000LL);
+				tv->tv_usec = (long)((ms % 1000LL) * 1000LL);
+			}
+			return 1;
+#endif
+#ifdef BIO_CTRL_DGRAM_SET_NEXT_TIMEOUT
+		case BIO_CTRL_DGRAM_SET_NEXT_TIMEOUT:
+			if (connection && arg2)
+			{
+				const struct timeval* tv = (const struct timeval*)arg2;
+				connection->dtlsTimerExpired = FALSE;
+				connection->dtlsTimeoutDeadlineMs = rdpudp_next_timeout_deadline_ms(tv);
+			}
+			return 1;
+#endif
+#ifdef BIO_CTRL_DGRAM_GET_RECV_TIMER_EXP
+		case BIO_CTRL_DGRAM_GET_RECV_TIMER_EXP:
+			if (connection)
+			{
+				if (connection->dtlsTimeoutDeadlineMs != 0 &&
+				    GetTickCount64() >= connection->dtlsTimeoutDeadlineMs)
+				{
+					connection->dtlsTimerExpired = TRUE;
+					connection->dtlsTimeoutDeadlineMs = 0;
+				}
+				const long expired = connection->dtlsTimerExpired ? 1 : 0;
+				connection->dtlsTimerExpired = FALSE;
+				return expired;
+			}
+			return 0;
+#endif
+#ifdef BIO_CTRL_DGRAM_MTU_EXCEEDED
+		case BIO_CTRL_DGRAM_MTU_EXCEEDED:
+			return 0;
+#endif
+		default:
+			return 0;
+	}
+}
