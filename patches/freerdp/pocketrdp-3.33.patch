+BOOL rdpudp_tunnel_write_data(rdpUdpTunnel* tunnel, const BYTE* data, size_t length)
+{
+	if (!tunnel || (!data && (length > 0)) || length > UINT16_MAX)
+		return FALSE;
+
+	BOOL ok = FALSE;
+	wStream* s = Stream_New(nullptr, RDPTUNNEL_HEADER_LENGTH + length);
+	if (!s)
+		return FALSE;
+
+	if (!rdpemt_write_tunnel_header(s, RDPTUNNEL_ACTION_DATA, (UINT16)length))
+		goto out;
+	if (length > 0)
+		Stream_Write(s, data, length);
+
+	EnterCriticalSection(&tunnel->lock);
+	if (tunnel->tls && !tunnel->aborted && tunnel->state == RDPUDP_TUNNEL_STATE_ACTIVE)
+	{
+		const int written =
+		    freerdp_tls_write_all(tunnel->tls, Stream_Buffer(s), Stream_GetPosition(s));
+		ok = written == WINPR_ASSERTING_INT_CAST(int, Stream_GetPosition(s));
+	}
+	LeaveCriticalSection(&tunnel->lock);
+
+out:
+	Stream_Free(s, TRUE);
+	return ok;
+}
+
+BOOL rdpudp_tunnel_write_subheader(rdpUdpTunnel* tunnel, const BYTE* subHeader,
+                                   size_t subHeaderLength)
+{
+	if (!tunnel || !subHeader || subHeaderLength == 0 ||
+	    subHeaderLength > UINT8_MAX - RDPTUNNEL_HEADER_LENGTH)
+		return FALSE;
+
+	BOOL ok = FALSE;
+	wStream* s = Stream_New(nullptr, RDPTUNNEL_HEADER_LENGTH + subHeaderLength);
+	if (!s)
+		return FALSE;
+
+	if (!rdpemt_write_tunnel_header_ex(s, RDPTUNNEL_ACTION_DATA, subHeader, subHeaderLength, 0))
+		goto out;
+
+	EnterCriticalSection(&tunnel->lock);
+	if (tunnel->tls && !tunnel->aborted &&
+	    (tunnel->state == RDPUDP_TUNNEL_STATE_READY ||
+	     tunnel->state == RDPUDP_TUNNEL_STATE_ACTIVE))
+	{
+		const int written =
+		    freerdp_tls_write_all(tunnel->tls, Stream_Buffer(s), Stream_GetPosition(s));
+		ok = written == WINPR_ASSERTING_INT_CAST(int, Stream_GetPosition(s));
+	}
+	LeaveCriticalSection(&tunnel->lock);
+
+out:
+	Stream_Free(s, TRUE);
+	return ok;
+}
