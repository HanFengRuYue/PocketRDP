+static pthread_mutex_t gHomeEnvLock = PTHREAD_MUTEX_INITIALIZER;
+static BOOL gHomeEnvInitialized = FALSE;
+
+static BOOL android_ensure_home_env(const char* homeDir)
+{
+	if (!homeDir || homeDir[0] == '\0')
+		return FALSE;
+
+	pthread_mutex_lock(&gHomeEnvLock);
+	if (gHomeEnvInitialized)
+	{
+		pthread_mutex_unlock(&gHomeEnvLock);
+		return TRUE;
+	}
+
+	const char* existing = getenv("HOME");
+	if (existing && strcmp(existing, homeDir) == 0)
+	{
+		gHomeEnvInitialized = TRUE;
+		pthread_mutex_unlock(&gHomeEnvLock);
+		return TRUE;
+	}
+
+	const int rc = setenv("HOME", homeDir, 1);
+	if (rc == 0)
+	{
+		gHomeEnvInitialized = TRUE;
+	}
+	else
+	{
+		char ebuffer[256] = WINPR_C_ARRAY_INIT;
+		WLog_FATAL(TAG, "Failed to set environment HOME=%s %s [%d]", homeDir,
+		           winpr_strerror(errno, ebuffer, sizeof(ebuffer)), errno);
+	}
+	pthread_mutex_unlock(&gHomeEnvLock);
+	return rc == 0;
+}
