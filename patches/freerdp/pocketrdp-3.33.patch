+static BOOL multitransport_parse_dvc_data_id(const BYTE* data, size_t length, UINT32* channelId)
+{
+	if (!data || !channelId || length < 2)
+		return FALSE;
+	const UINT8 command = data[0] >> 4u;
+	if (command != DATA_FIRST_PDU && command != DATA_PDU &&
+	    command != DATA_FIRST_COMPRESSED_PDU && command != DATA_COMPRESSED_PDU)
+		return FALSE;
+	const UINT8 cbChannelId = data[0] & 0x03u;
+	const size_t idBytes = cbChannelId == 0 ? 1u : (cbChannelId == 1 ? 2u : 4u);
+	if (cbChannelId == 3 || length < 1u + idBytes)
+		return FALSE;
+	wStream buffer = WINPR_C_ARRAY_INIT;
+	wStream* s = Stream_StaticConstInit(&buffer, data + 1, length - 1);
+	switch (idBytes)
+	{
+		case 1:
+		{
+			UINT8 id = 0;
+			Stream_Read_UINT8(s, id);
+			*channelId = id;
+			break;
+		}
+		case 2:
+		{
+			UINT16 id = 0;
+			Stream_Read_UINT16(s, id);
+			*channelId = id;
+			break;
+		}
+		default:
+			Stream_Read_UINT32(s, *channelId);
+			break;
+	}
+	return TRUE;
+}
