+static DVCMAN_CHANNEL* dvcman_create_static_tunnel_channel(
+    drdynvcPlugin* drdynvc, IWTSVirtualChannelManager* pChannelMgr, UINT32 ChannelId,
+    const char* ChannelName, UINT* res)
+{
+	WINPR_ASSERT(drdynvc);
+	WINPR_ASSERT(pChannelMgr);
+	WINPR_ASSERT(ChannelName);
+	WINPR_ASSERT(res);
+
+	DVCMAN* dvcman = (DVCMAN*)pChannelMgr;
+	rdpSettings* settings = drdynvc->rdpcontext ? drdynvc->rdpcontext->settings : nullptr;
+	freerdp* instance = drdynvc->rdpcontext ? drdynvc->rdpcontext->instance : nullptr;
+	if (!settings || !instance ||
+	    (freerdp_settings_get_uint32(settings, FreeRDP_MultitransportFlags) &
+	     TRANSPORT_TYPE_UDP_PREFERRED) == 0 ||
+	    strnlen(ChannelName, CHANNEL_NAME_LEN + 1) > CHANNEL_NAME_LEN)
+	{
+		*res = ERROR_NOT_FOUND;
+		return nullptr;
+	}
+
+	const UINT16 staticChannelId = freerdp_channels_get_id_by_name(instance, ChannelName);
+	const UINT16 drdynvcChannelId =
+	    freerdp_channels_get_id_by_name(instance, DRDYNVC_SVC_CHANNEL_NAME);
+	if (staticChannelId == 0 || staticChannelId == drdynvcChannelId ||
+	    dvcman_get_channel_by_id(pChannelMgr, ChannelId, FALSE) != nullptr ||
+	    HashTable_GetItemValue(dvcman->staticTunnelsByName, ChannelName) != nullptr)
+	{
+		*res = ERROR_NOT_FOUND;
+		return nullptr;
+	}
+
+	DVCMAN_CHANNEL* channel =
+	    dvcman_channel_new(drdynvc, pChannelMgr, ChannelId, ChannelName);
+	if (!channel)
+	{
+		*res = CHANNEL_RC_NO_MEMORY;
+		return nullptr;
+	}
+	channel->iface.Write = dvcman_write_channel;
+	channel->iface.Close = dvcman_close_channel_iface;
+	channel->staticTunnel = TRUE;
+	channel->staticChannelId = staticChannelId;
+	channel->state = DVC_CHANNEL_RUNNING;
+	if (!HashTable_Insert(dvcman->channelsById, &channel->channel_id, channel))
+	{
+		dvcman_channel_free(channel);
+		*res = ERROR_INTERNAL_ERROR;
+		return nullptr;
+	}
+	if (!HashTable_Insert(dvcman->staticTunnelsByName, channel->channel_name, channel))
+	{
+		HashTable_Remove(dvcman->channelsById, &channel->channel_id);
+		*res = ERROR_INTERNAL_ERROR;
+		return nullptr;
+	}
+
+	WLog_INFO(TAG, "static VC '%s' tunneled through DVC id=%" PRIu32, ChannelName, ChannelId);
+	*res = CHANNEL_RC_OK;
+	return channel;
+}
