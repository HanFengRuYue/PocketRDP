+void multitransport_force_tcp_reconnect(rdpMultitransport* multi)
+{
+	if (!multi || multi->downgradedToTcp)
+		return;
+	multi->downgradedToTcp = TRUE;
+	multi->reconnectRequested = TRUE;
+	multi->phase = FREERDP_TRANSPORT_PHASE_RECONNECTING_TCP;
+	multi->activeMask = 0;
+	multi->softSyncMask = 0;
+	multi->activeRouteCount = 0;
+	(void)freerdp_settings_set_bool(multi->rdp->settings, FreeRDP_SupportMultitransport, FALSE);
+	(void)freerdp_settings_set_uint32(multi->rdp->settings, FreeRDP_MultitransportFlags, 0);
+	rdpudp_tunnel_abort(multi->reliable.tunnel);
+	rdpudp_tunnel_abort(multi->lossy.tunnel);
+	WLog_WARN(TAG, "active RDP-UDP failed; reconnecting the same FreeRDP instance with TCP only");
+}
+
+static void multitransport_write_tunnel_snapshot(INT64* values,
+                                                 const rdpMultitransportTunnel* slot)
+{
+	rdpUdpTunnelSnapshot snapshot = slot ? slot->lastSnapshot : (rdpUdpTunnelSnapshot){ 0 };
+	if (slot && slot->tunnel)
+		rdpudp_tunnel_snapshot(slot->tunnel, &snapshot);
+	values[0] = snapshot.kind;
+	values[1] = snapshot.state;
+	values[2] = snapshot.negotiatedVersion;
+	values[3] = (INT64)snapshot.bytesReceived;
+	values[4] = (INT64)snapshot.bytesSent;
+	values[5] = (INT64)snapshot.packetsReceived;
+	values[6] = (INT64)snapshot.packetsSent;
+	values[7] = (INT64)snapshot.retransmits;
+	values[8] = (INT64)snapshot.fecRecovered;
+	values[9] = (INT64)snapshot.droppedPackets;
+	values[10] = (INT64)snapshot.srttMicros;
+	values[11] = (INT64)snapshot.idleMillis;
+}
+
+void multitransport_get_snapshot(const rdpMultitransport* multi,
+                                 INT64 values[FREERDP_TRANSPORT_SNAPSHOT_FIELDS])
+{
+	if (!values)
+		return;
+	ZeroMemory(values, sizeof(INT64) * FREERDP_TRANSPORT_SNAPSHOT_FIELDS);
+	values[0] = FREERDP_TRANSPORT_SNAPSHOT_VERSION;
+	if (!multi)
+		return;
+	rdpMultitransport* mutable = (rdpMultitransport*)multi;
+	EnterCriticalSection(&mutable->lock);
+	values[1] = multi->phase;
+	values[2] = multi->requestedMask;
+	values[3] = multi->readyMask;
+	values[4] = multi->activeMask;
+	values[5] = multi->softSyncMask;
+	values[6] = (multi->downgradedToTcp ? 1 : 0) | (multi->reconnectRequested ? 2 : 0);
+	values[7] = freerdp_settings_get_uint32(multi->rdp->settings, FreeRDP_SelectedProtocol);
+	values[8] = (INT64)multi->activeRouteCount;
+	values[9] = multi->failureStage;
+	values[10] = (UINT32)multi->tunnelHr;
+	values[11] = multi->socketError;
+	multitransport_write_tunnel_snapshot(&values[12], &multi->reliable);
+	multitransport_write_tunnel_snapshot(&values[24], &multi->lossy);
+	LeaveCriticalSection(&mutable->lock);
+}
