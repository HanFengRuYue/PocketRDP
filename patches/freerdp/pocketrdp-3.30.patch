+#define GDI_GFX_MAX_PIXELS 16777216ull
+#define GDI_GFX_MAX_SURFACE_BYTES (128ull * 1024ull * 1024ull)
+
+static BOOL gdi_gfx_dimensions_safe(UINT32 width, UINT32 height)
+{
+	return width > 0 && height > 0 && width <= GDI_GFX_MAX_DIMENSION &&
+	       height <= GDI_GFX_MAX_DIMENSION && (UINT64)width * height <= GDI_GFX_MAX_PIXELS;
