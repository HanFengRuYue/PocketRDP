+static void rdpudp2_pending_clear(rdpUdpPendingPacket* packet)
+{
+	if (!packet)
+		return;
+
+	free(packet->payload);
+	ZeroMemory(packet, sizeof(*packet));
+}
+
+static void rdpudp_pending_update_rtt(rdpUdpConnection* connection,
+	                                  const rdpUdpPendingPacket* packet)
+{
+	if (!connection || !connection->result || !packet || packet->retransmits != 0 ||
+	    packet->lastSentMs == 0)
+		return;
+	const UINT64 now = GetTickCount64();
+	if (now < packet->lastSentMs)
+		return;
+	const UINT64 sample = (now - packet->lastSentMs) * 1000u;
+	connection->result->srttMicros = connection->result->srttMicros == 0
+	                                            ? sample
+	                                            : (connection->result->srttMicros * 7u + sample) / 8u;
+}
+
+static rdpUdpPendingPacket* rdpudp2_pending_find_by_data_seq(rdpUdpConnection* connection,
+                                                              UINT16 dataSeq)
+{
+	WINPR_ASSERT(connection);
+	for (size_t x = 0; x < ARRAYSIZE(connection->pending); x++)
+	{
+		rdpUdpPendingPacket* packet = &connection->pending[x];
+		if (packet->inUse && (UINT16)packet->dataSequence == dataSeq)
+			return packet;
+	}
+
+	return nullptr;
+}
+
+static rdpUdpPendingPacket* rdpudp1_pending_find_by_data_seq(rdpUdpConnection* connection,
+                                                             UINT32 dataSeq)
+{
+	WINPR_ASSERT(connection);
+	for (size_t x = 0; x < ARRAYSIZE(connection->pending); x++)
+	{
+		rdpUdpPendingPacket* packet = &connection->pending[x];
+		if (packet->inUse && packet->dataSequence == dataSeq)
+			return packet;
+	}
+
+	return nullptr;
+}
+
+static rdpUdpPendingPacket* rdpudp2_pending_find_free(rdpUdpConnection* connection)
+{
+	WINPR_ASSERT(connection);
+	for (size_t x = 0; x < ARRAYSIZE(connection->pending); x++)
+	{
+		if (!connection->pending[x].inUse)
+			return &connection->pending[x];
+	}
+
+	return nullptr;
+}
+
+static rdpUdpRecvAckEntry* rdpudp2_recv_ack_find(rdpUdpConnection* connection, UINT16 dataSeq)
+{
+	WINPR_ASSERT(connection);
+	rdpUdpRecvAckEntry* entry = &connection->recvAcks[dataSeq % RDPUDP2_RECV_WINDOW];
+	return (entry->inUse && entry->dataSequence == dataSeq) ? entry : nullptr;
+}
+
+static void rdpudp2_recv_ack_clear(rdpUdpConnection* connection, UINT16 dataSeq)
+{
+	rdpUdpRecvAckEntry* entry = rdpudp2_recv_ack_find(connection, dataSeq);
+	if (entry)
+		ZeroMemory(entry, sizeof(*entry));
+}
+
+static void rdpudp2_recv_ack_clear_to(rdpUdpConnection* connection, UINT16 dataSeq)
+{
+	WINPR_ASSERT(connection);
+
+	for (size_t x = 0; x < ARRAYSIZE(connection->recvAcks); x++)
+	{
+		rdpUdpRecvAckEntry* entry = &connection->recvAcks[x];
+		if (entry->inUse && rdpudp2_sequence_le(entry->dataSequence, dataSeq))
+			ZeroMemory(entry, sizeof(*entry));
+	}
+}
+
+static BOOL rdpudp2_recv_ack_received(const rdpUdpConnection* connection, UINT16 dataSeq)
+{
+	WINPR_ASSERT(connection);
+	const rdpUdpRecvAckEntry* entry = &connection->recvAcks[dataSeq % RDPUDP2_RECV_WINDOW];
+	return entry->inUse && entry->dataSequence == dataSeq;
+}
+
+static void rdpudp2_recv_ack_promote(rdpUdpConnection* connection)
+{
+	WINPR_ASSERT(connection);
+
+	for (;;)
+	{
+		const UINT16 nextSeq = (UINT16)((connection->recvSequence + 1u) & 0xFFFFu);
+		if (!rdpudp2_recv_ack_received(connection, nextSeq))
+			break;
+
+		rdpudp2_recv_ack_clear(connection, nextSeq);
+		connection->recvSequence = nextSeq;
+	}
+
+	if (!rdpudp2_sequence_gt((UINT16)connection->recvAckHigh,
+	                         (UINT16)(connection->recvSequence & 0xFFFFu)))
+		connection->recvAckHigh = (UINT16)(connection->recvSequence & 0xFFFFu);
+}
+
+static void rdpudp2_recv_ack_note(rdpUdpConnection* connection, UINT16 dataSeq)
+{
+	WINPR_ASSERT(connection);
+
+	const UINT16 cumulative = (UINT16)(connection->recvSequence & 0xFFFFu);
+	if (rdpudp2_sequence_le(dataSeq, cumulative))
+		return;
+
+	const UINT16 expected = (UINT16)(cumulative + 1u);
+	const UINT16 distance = rdpudp2_sequence_distance(expected, dataSeq);
+	if (distance >= RDPUDP2_RECV_WINDOW)
+	{
+		WLog_WARN(TAG,
+		          "RDP-UDP2 receive ACK window overflow expected=%" PRIu16
+		          " received=%" PRIu16,
+		          expected, dataSeq);
+		return;
+	}
+
+	rdpUdpRecvAckEntry* entry = &connection->recvAcks[dataSeq % RDPUDP2_RECV_WINDOW];
+	entry->inUse = TRUE;
+	entry->dataSequence = dataSeq;
+
+	if (rdpudp2_sequence_gt(dataSeq, (UINT16)connection->recvAckHigh))
+		connection->recvAckHigh = dataSeq;
+
+	rdpudp2_recv_ack_promote(connection);
+}
+
+static void rdpudp2_recv_ack_apply_aoa(rdpUdpConnection* connection, UINT16 ackOfAcksSeq)
+{
+	WINPR_ASSERT(connection);
+
+	const UINT16 newCumulative = (UINT16)(ackOfAcksSeq - 1u);
+	if (!rdpudp2_sequence_gt(newCumulative, (UINT16)(connection->recvSequence & 0xFFFFu)))
+		return;
+
+	connection->recvSequence = newCumulative;
+	rdpudp2_recv_ack_clear_to(connection, newCumulative);
+	rdpudp2_recv_ack_promote(connection);
+}
+
+static rdpUdpRecvSegment* rdpudp2_recv_segment_find(rdpUdpConnection* connection,
+                                                    UINT32 channelSeq)
+{
+	WINPR_ASSERT(connection);
+
+	for (size_t x = 0; x < ARRAYSIZE(connection->recvSegments); x++)
+	{
+		rdpUdpRecvSegment* segment = &connection->recvSegments[x];
+		if (segment->inUse && segment->channelSequence == channelSeq)
+			return segment;
+	}
+
+	return nullptr;
+}
+
+static rdpUdpRecvSegment* rdpudp2_recv_segment_find_free(rdpUdpConnection* connection)
+{
+	WINPR_ASSERT(connection);
+
+	for (size_t x = 0; x < ARRAYSIZE(connection->recvSegments); x++)
+	{
+		if (!connection->recvSegments[x].inUse)
+			return &connection->recvSegments[x];
+	}
+
+	return nullptr;
+}
+
+static void rdpudp2_recv_segment_take(rdpUdpConnection* connection, rdpUdpRecvSegment* segment)
+{
+	WINPR_ASSERT(connection);
+	WINPR_ASSERT(segment);
+
+	free(connection->readPayload);
+	connection->readPayload = segment->payload;
+	connection->readPayloadLength = segment->payloadLength;
+	connection->readPayloadOffset = 0;
+	segment->payload = nullptr;
+	ZeroMemory(segment, sizeof(*segment));
+	connection->recvChannelSequence++;
+}
+
+static BOOL rdpudp2_queue_channel_payload(rdpUdpConnection* connection, UINT16 channelSeq,
+                                          const BYTE* payload, size_t payloadLength)
+{
+	WINPR_ASSERT(connection);
+	WINPR_ASSERT(payload || (payloadLength == 0));
+
+	if (payloadLength == 0)
+	{
+		if (channelSeq == connection->recvChannelSequence)
+			connection->recvChannelSequence++;
+		return TRUE;
+	}
+
+	const UINT16 expected = connection->recvChannelSequence;
+	if (rdpudp2_sequence_lt(channelSeq, expected))
+		return TRUE; /* Duplicate retransmission of a segment already delivered upstream. */
+
+	if (rdpudp2_sequence_distance(expected, channelSeq) >= RDPUDP2_RECV_WINDOW)
+	{
+		WLog_WARN(TAG,
+		          "RDP-UDP2 receive channel window overflow expected=%" PRIu16
+		          " received=%" PRIu16,
+		          expected, channelSeq);
+		return FALSE;
+	}
+
+	if (rdpudp2_recv_segment_find(connection, channelSeq))
+		return TRUE;
+
+	rdpUdpRecvSegment* segment = rdpudp2_recv_segment_find_free(connection);
+	if (!segment)
+	{
+		WLog_WARN(TAG, "RDP-UDP2 receive channel window is full");
+		return FALSE;
+	}
+
+	BYTE* copy = (BYTE*)malloc(payloadLength);
+	if (!copy)
+		return FALSE;
+	memcpy(copy, payload, payloadLength);
+
+	segment->inUse = TRUE;
+	segment->channelSequence = channelSeq;
+	segment->payload = copy;
+	segment->payloadLength = payloadLength;
+	return TRUE;
+}
+
+static int rdpudp2_read_buffered_payload(rdpUdpConnection* connection, BYTE* data, size_t length)
+{
+	WINPR_ASSERT(connection);
+	WINPR_ASSERT(data);
+
+	if (!connection->readPayload)
+	{
+		rdpUdpRecvSegment* next =
+		    rdpudp2_recv_segment_find(connection, connection->recvChannelSequence);
+		if (next)
+			rdpudp2_recv_segment_take(connection, next);
+	}
+
+	if (!connection->readPayload)
+		return 0;
+
+	const size_t remaining = connection->readPayloadLength - connection->readPayloadOffset;
+	const size_t copyLength = (remaining < length) ? remaining : length;
+	if (copyLength > 0)
+		memcpy(data, connection->readPayload + connection->readPayloadOffset, copyLength);
+
+	connection->readPayloadOffset += copyLength;
+	if (connection->readPayloadOffset >= connection->readPayloadLength)
+	{
+		free(connection->readPayload);
+		connection->readPayload = nullptr;
+		connection->readPayloadLength = 0;
+		connection->readPayloadOffset = 0;
+	}
+
+	return WINPR_ASSERTING_INT_CAST(int, copyLength);
+}
+
+static void rdpudp2_pending_mark_acked(rdpUdpConnection* connection, UINT16 dataSeq)
+{
+	rdpUdpPendingPacket* packet = rdpudp2_pending_find_by_data_seq(connection, dataSeq);
+	if (packet)
+	{
+		rdpudp_pending_update_rtt(connection, packet);
+		rdpudp2_pending_clear(packet);
+	}
+}
+
+static void rdpudp2_pending_mark_acked_to(rdpUdpConnection* connection, UINT16 dataSeq)
+{
+	WINPR_ASSERT(connection);
+	for (size_t x = 0; x < ARRAYSIZE(connection->pending); x++)
+	{
+		rdpUdpPendingPacket* packet = &connection->pending[x];
+		if (packet->inUse && rdpudp2_sequence_le((UINT16)packet->dataSequence, dataSeq))
+		{
+			rdpudp_pending_update_rtt(connection, packet);
+			rdpudp2_pending_clear(packet);
+		}
+	}
+}
+
+static int rdpudp_connection_send_raw(rdpUdpConnection* connection, const BYTE* data, size_t length)
+{
+	WINPR_ASSERT(connection);
+	WINPR_ASSERT(data || (length == 0));
+
+	const int ilength = WINPR_ASSERTING_INT_CAST(int, length);
+	const int sent = _send(connection->sock, (const char*)data, ilength, 0);
+	if (sent > 0)
+	{
+		connection->lastSendMs = GetTickCount64();
+		if (connection->result)
+		{
+			connection->result->packetsSent++;
+			connection->result->bytesSent += WINPR_ASSERTING_INT_CAST(UINT32, sent);
+		}
+	}
+	else if (connection->result)
+		connection->result->lastSocketError = rdpudp_socket_error();
+
+	return sent;
+}
+
+static int rdpudp_connection_recv_raw(rdpUdpConnection* connection, BYTE* data, size_t length,
+                                      int timeoutMs)
+{
+	WINPR_ASSERT(connection);
+	WINPR_ASSERT(data);
+
+	if (!rdpudp_wait_readable(connection->sock, timeoutMs))
+		return 0;
+
+	const int received =
+	    _recv(connection->sock, (char*)data, WINPR_ASSERTING_INT_CAST(int, length), 0);
+	if (received > 0)
+	{
+		connection->lastReceiveMs = GetTickCount64();
+		if (connection->result)
+		{
+			connection->result->packetsReceived++;
+			connection->result->bytesReceived += WINPR_ASSERTING_INT_CAST(UINT32, received);
+		}
+	}
+	else if (connection->result)
+		connection->result->lastSocketError = rdpudp_socket_error();
+
+	return received;
+}
+
+static UINT32 rdpudp1_retransmit_timeout_ms(const rdpUdpConnection* connection)
+{
+	return (connection && connection->negotiatedVersion == RDPUDP_PROTOCOL_VERSION_1)
+	           ? RDPUDP1_RETRANSMIT_TIMEOUT_V1_MS
+	           : RDPUDP1_RETRANSMIT_TIMEOUT_V2_MS;
+}
+
+static BOOL rdpudp1_source_packet_received(rdpUdpConnection* connection, UINT32 sourceSeq)
+{
+	WINPR_ASSERT(connection);
+	return rdpudp1_sequence_le(sourceSeq, connection->recvSequence) ||
+	       rdpudp2_recv_segment_find(connection, sourceSeq);
+}
+
+static BOOL rdpudp1_write_ack_vector(wStream* s, rdpUdpConnection* connection)
+{
+	WINPR_ASSERT(s);
+	WINPR_ASSERT(connection);
+
+	UINT32 highSeq = connection->recvAckHigh;
+	if (rdpudp1_sequence_lt(highSeq, connection->recvSequence))
+		highSeq = connection->recvSequence;
+
+	const UINT32 firstSeq = connection->recvSequence + 1u;
+	size_t vectorSize = 0;
+	BYTE vector[2048] = { 0 };
+
+	if (rdpudp1_sequence_le(firstSeq, highSeq))
+	{
+		BOOL haveRun = FALSE;
+		UINT8 runState = 0;
+		UINT8 runLength = 0;
+
+		for (UINT32 seq = firstSeq; rdpudp1_sequence_le(seq, highSeq); seq++)
+		{
+			const UINT8 state = rdpudp1_source_packet_received(connection, seq) ? 0 : 3;
+			if (!haveRun)
+			{
+				haveRun = TRUE;
+				runState = state;
+				runLength = 1;
+			}
+			else if (state == runState && runLength < 63)
+			{
+				runLength++;
+			}
+			else
+			{
+				if (vectorSize >= ARRAYSIZE(vector))
+					return FALSE;
+				vector[vectorSize++] = (BYTE)((runState << 6u) | runLength);
+				runState = state;
+				runLength = 1;
+			}
+		}
+
+		if (haveRun)
+		{
+			if (vectorSize >= ARRAYSIZE(vector))
+				return FALSE;
+			vector[vectorSize++] = (BYTE)((runState << 6u) | runLength);
+		}
+	}
+
+	if (vectorSize == 0)
+	{
+		vector[vectorSize++] = 1; /* one DATAGRAM_RECEIVED entry for snSourceAck */
+		highSeq = connection->recvSequence;
+	}
+
+	const size_t padding = (4u - ((sizeof(UINT16) + vectorSize) % 4u)) % 4u;
+	if (!Stream_EnsureRemainingCapacity(s, sizeof(UINT16) + vectorSize + padding))
+		return FALSE;
+
+	Stream_Write_UINT16_BE(s, (UINT16)vectorSize);
+	Stream_Write(s, vector, vectorSize);
+	Stream_Zero(s, padding);
+	connection->recvAckHigh = highSeq;
+	return TRUE;
+}
+
+static BOOL rdpudp1_write_ack_fields(rdpUdpConnection* connection, wStream* s, UINT16 extraFlags)
+{
+	WINPR_ASSERT(connection);
+	WINPR_ASSERT(s);
+
+	if (!Stream_EnsureRemainingCapacity(s, 12))
+		return FALSE;
+
+	UINT32 sourceAck = connection->recvAckHigh;
+	if (rdpudp1_sequence_lt(sourceAck, connection->recvSequence))
+		sourceAck = connection->recvSequence;
+
+	Stream_Write_UINT32_BE(s, sourceAck); /* snSourceAck */
+	Stream_Write_UINT16_BE(s, RDPUDP_RECEIVE_WINDOW);
+	Stream_Write_UINT16_BE(s, RDPUDP_FLAG_ACK | extraFlags);
+	return rdpudp1_write_ack_vector(s, connection);
+}
+
+static BOOL rdpudp_send_connection_ack(rdpUdpConnection* connection)
+{
+	WINPR_ASSERT(connection);
+
+	wStream* s = Stream_New(nullptr, 16);
+	if (!s)
+		return FALSE;
+
+	if (!rdpudp1_write_ack_fields(connection, s, 0))
+	{
+		Stream_Free(s, TRUE);
+		return FALSE;
+	}
+
+	const size_t length = Stream_GetPosition(s);
+	const int sent = rdpudp_connection_send_raw(connection, Stream_Buffer(s), length);
+	Stream_Free(s, TRUE);
+	return sent == WINPR_ASSERTING_INT_CAST(int, length);
+}
+
+static void rdpudp1_pending_mark_acked(rdpUdpConnection* connection, UINT32 sourceSeq)
+{
+	rdpUdpPendingPacket* packet = rdpudp1_pending_find_by_data_seq(connection, sourceSeq);
+	if (packet)
+	{
+		rdpudp_pending_update_rtt(connection, packet);
+		rdpudp2_pending_clear(packet);
+	}
+}
+
+static void rdpudp1_pending_mark_acked_to(rdpUdpConnection* connection, UINT32 sourceSeq)
+{
+	WINPR_ASSERT(connection);
+	for (size_t x = 0; x < ARRAYSIZE(connection->pending); x++)
+	{
+		rdpUdpPendingPacket* packet = &connection->pending[x];
+		if (packet->inUse && rdpudp1_sequence_le(packet->dataSequence, sourceSeq))
+		{
+			rdpudp_pending_update_rtt(connection, packet);
+			rdpudp2_pending_clear(packet);
+		}
+	}
+}
+
+static BOOL rdpudp1_send_source_segment(rdpUdpConnection* connection, UINT32 sourceSeq,
+                                        const BYTE* payload, size_t payloadLen)
+{
+	WINPR_ASSERT(connection);
+	WINPR_ASSERT(payload || (payloadLen == 0));
+
+	wStream* s = Stream_New(nullptr, RDPUDP_DEFAULT_MTU);
+	if (!s)
+		return FALSE;
+
+	if (!rdpudp1_write_ack_fields(connection, s, RDPUDP_FLAG_DATA))
+	{
+		Stream_Free(s, TRUE);
+		return FALSE;
+	}
+
+	const UINT32 codedSeq = connection->codedSequence++;
+	Stream_Write_UINT32_BE(s, codedSeq);
+	Stream_Write_UINT32_BE(s, sourceSeq);
+	if (payloadLen > 0)
+		Stream_Write(s, payload, payloadLen);
+
+	const size_t length = Stream_GetPosition(s);
+	const int sent = rdpudp_connection_send_raw(connection, Stream_Buffer(s), length);
+	Stream_Free(s, TRUE);
+	return sent == WINPR_ASSERTING_INT_CAST(int, length);
+}
+
+static BOOL rdpudp1_retransmit_packet(rdpUdpConnection* connection, rdpUdpPendingPacket* packet)
+{
+	WINPR_ASSERT(connection);
+	WINPR_ASSERT(packet);
+
+	if (!packet->inUse || !packet->payload)
+		return TRUE;
+
+	if (packet->retransmits >= RDPUDP1_MAX_RETRANSMITS)
+	{
+		WLog_WARN(TAG,
+		          "RDP-UDP packet sourceSeq=%" PRIu32 " exceeded retransmit limit",
+		          packet->dataSequence);
+		return FALSE;
+	}
+
+	if (!rdpudp1_send_source_segment(connection, packet->dataSequence, packet->payload,
+	                                packet->payloadLength))
+		return FALSE;
+
+	packet->lastSentMs = GetTickCount64();
+	packet->retransmits++;
+	if (connection->result)
+		connection->result->retransmits++;
+
+	WLog_DBG(TAG, "RDP-UDP retransmit sourceSeq=%" PRIu32 " count=%" PRIu32,
+	         packet->dataSequence, packet->retransmits);
+	return TRUE;
+}
+
+static BOOL rdpudp1_retransmit_due(rdpUdpConnection* connection)
+{
+	WINPR_ASSERT(connection);
+
+	if (connection->lossy)
+		return TRUE;
+
+	const UINT64 now = GetTickCount64();
+	const UINT32 retransmitTimeout = rdpudp1_retransmit_timeout_ms(connection);
+	for (size_t x = 0; x < ARRAYSIZE(connection->pending); x++)
+	{
+		rdpUdpPendingPacket* packet = &connection->pending[x];
+		if (!packet->inUse)
+			continue;
+
+		if (now >= packet->lastSentMs && now - packet->lastSentMs >= retransmitTimeout)
+		{
+			if (!rdpudp1_retransmit_packet(connection, packet))
+				return FALSE;
+		}
+	}
+
+	return TRUE;
+}
+
+static BOOL rdpudp1_maintenance(rdpUdpConnection* connection)
+{
+	WINPR_ASSERT(connection);
+
+	if (!rdpudp1_retransmit_due(connection))
+		return FALSE;
+
+	const UINT64 now = GetTickCount64();
+	if (connection->lastReceiveMs > 0 && now >= connection->lastReceiveMs &&
+	    now - connection->lastReceiveMs >= RDPUDP_IDLE_TIMEOUT_MS)
+		return FALSE;
+	const UINT64 lastActivity = (connection->lastSendMs > connection->lastKeepaliveMs)
+	                                ? connection->lastSendMs
+	                                : connection->lastKeepaliveMs;
+	if ((lastActivity == 0) || (now < lastActivity) ||
+	    (now - lastActivity < RDPUDP1_KEEPALIVE_INTERVAL_MS))
+		return TRUE;
+
+	const BOOL ok = rdpudp_send_connection_ack(connection);
+	if (ok)
+		connection->lastKeepaliveMs = now;
+	return ok;
+}
+
+static BOOL rdpudp2_send_packet(rdpUdpConnection* connection, UINT8 packetType, UINT16 flags,
+                                const BYTE* payload, size_t payloadLen)
+{
+	WINPR_ASSERT(connection);
+
+	wStream* s = Stream_New(nullptr, RDPUDP_DEFAULT_MTU + 1);
+	if (!s)
+		return FALSE;
+
+	if (!Stream_SetPosition(s, 1))
+	{
+		Stream_Free(s, TRUE);
+		return FALSE;
+	}
+
+	const UINT16 header = (UINT16)((flags & 0x0FFFu) | (RDPUDP2_LOG_WINDOW << 12u));
+	Stream_Write_UINT16(s, header);
+
+	if ((flags & RDPUDP2_FLAG_ACK) != 0)
+	{
+		const UINT16 ackSeq = (UINT16)(connection->recvSequence & 0xFFFFu);
+		Stream_Write_UINT16(s, ackSeq);
+		Stream_Zero(s, 3); /* receivedTS */
+		Stream_Write_UINT8(s, 0); /* sendAckTimeGap */
+		Stream_Write_UINT8(s, 0); /* no delayed ACK entries */
+	}
+
+	if ((flags & RDPUDP2_FLAG_DELAYACKINFO) != 0)
+	{
+		Stream_Write_UINT8(s, RDPUDP2_DEFAULT_MAX_DELAYED_ACKS);
+		Stream_Write_UINT16(s, RDPUDP2_DEFAULT_DELAY_ACK_TIMEOUT_MS);
+	}
+
+	if ((flags & RDPUDP2_FLAG_DATA) != 0)
+	{
+		const UINT16 dataSeq = (UINT16)(connection->sendSequence++ & 0xFFFFu);
+		const UINT16 channelSeq = connection->channelSequence++;
+		Stream_Write_UINT16(s, dataSeq);
+		Stream_Write_UINT16(s, channelSeq);
+		if (payloadLen > 0)
+			Stream_Write(s, payload, payloadLen);
+	}
+
+	size_t totalLength = Stream_GetPosition(s);
+	const size_t packetLength = totalLength - 1;
+	if (packetLength < 7)
+	{
+		Stream_Zero(s, 7 - packetLength);
+		totalLength = Stream_GetPosition(s);
+	}
+
+	const UINT8 shortLength =
+	    (packetLength < 7) ? WINPR_ASSERTING_INT_CAST(UINT8, packetLength) : 7;
+	BYTE* buffer = Stream_Buffer(s);
+	buffer[0] = (UINT8)(((packetType & 0x0Fu) << 1u) | (shortLength & 0x07u));
+	/* MS-RDPEUDP2 moves the prefix byte to byte 7 on the wire. */
+	BYTE tmp = buffer[0];
+	buffer[0] = buffer[7];
+	buffer[7] = tmp;
+
+	const int sent = rdpudp_connection_send_raw(connection, buffer, totalLength);
+	Stream_Free(s, TRUE);
+	return sent == WINPR_ASSERTING_INT_CAST(int, totalLength);
+}
+
+static BOOL rdpudp2_send_data_segment(rdpUdpConnection* connection, UINT16 flags,
+                                      UINT16 channelSeq, const BYTE* payload, size_t payloadLen,
+                                      UINT16* dataSeq)
+{
+	WINPR_ASSERT(connection);
+	WINPR_ASSERT(payload || (payloadLen == 0));
+	WINPR_ASSERT(dataSeq);
+
+	wStream* s = Stream_New(nullptr, RDPUDP_DEFAULT_MTU + 1);
+	if (!s)
+		return FALSE;
+
+	if (!Stream_SetPosition(s, 1))
+	{
+		Stream_Free(s, TRUE);
+		return FALSE;
+	}
+
+	flags |= RDPUDP2_FLAG_DATA;
+	const UINT16 header = (UINT16)((flags & 0x0FFFu) | (RDPUDP2_LOG_WINDOW << 12u));
+	Stream_Write_UINT16(s, header);
+
+	if ((flags & RDPUDP2_FLAG_DELAYACKINFO) != 0)
+	{
+		Stream_Write_UINT8(s, RDPUDP2_DEFAULT_MAX_DELAYED_ACKS);
+		Stream_Write_UINT16(s, RDPUDP2_DEFAULT_DELAY_ACK_TIMEOUT_MS);
+	}
+
+	*dataSeq = (UINT16)(connection->sendSequence++ & 0xFFFFu);
+	Stream_Write_UINT16(s, *dataSeq);
+	Stream_Write_UINT16(s, channelSeq);
+	if (payloadLen > 0)
+		Stream_Write(s, payload, payloadLen);
+
+	size_t totalLength = Stream_GetPosition(s);
+	const size_t packetLength = totalLength - 1;
+	if (packetLength < 7)
+	{
+		Stream_Zero(s, 7 - packetLength);
+		totalLength = Stream_GetPosition(s);
+	}
+
+	const UINT8 shortLength =
+	    (packetLength < 7) ? WINPR_ASSERTING_INT_CAST(UINT8, packetLength) : 7;
+	BYTE* buffer = Stream_Buffer(s);
+	buffer[0] = (UINT8)(((RDPUDP2_PACKET_TYPE_DATA & 0x0Fu) << 1u) | (shortLength & 0x07u));
+	BYTE tmp = buffer[0];
+	buffer[0] = buffer[7];
+	buffer[7] = tmp;
+
+	const int sent = rdpudp_connection_send_raw(connection, buffer, totalLength);
+	Stream_Free(s, TRUE);
+	return sent == WINPR_ASSERTING_INT_CAST(int, totalLength);
+}
+
+static BOOL rdpudp2_send_ack(rdpUdpConnection* connection)
+{
+	return rdpudp2_send_packet(connection, RDPUDP2_PACKET_TYPE_DATA, RDPUDP2_FLAG_ACK, nullptr, 0);
+}
+
+static BOOL rdpudp2_send_ack_vector(rdpUdpConnection* connection)
+{
+	WINPR_ASSERT(connection);
+
+	const UINT16 baseSeq = (UINT16)((connection->recvSequence + 1u) & 0xFFFFu);
+	const UINT16 highSeq = (UINT16)connection->recvAckHigh;
+	if (!rdpudp2_sequence_gt(highSeq, (UINT16)(connection->recvSequence & 0xFFFFu)))
+		return rdpudp2_send_ack(connection);
+
+	const UINT16 seqCount = (UINT16)(rdpudp2_sequence_distance(baseSeq, highSeq) + 1u);
+	const UINT8 vectorSize = WINPR_ASSERTING_INT_CAST(UINT8, (seqCount + 6u) / 7u);
+	wStream* s = Stream_New(nullptr, 8 + vectorSize);
+	if (!s)
+		return FALSE;
+
+	if (!Stream_SetPosition(s, 1))
+	{
+		Stream_Free(s, TRUE);
+		return FALSE;
+	}
+
+	const UINT16 header =
+	    (UINT16)((RDPUDP2_FLAG_ACKVEC & 0x0FFFu) | (RDPUDP2_LOG_WINDOW << 12u));
+	Stream_Write_UINT16(s, header);
+	Stream_Write_UINT16(s, baseSeq);
+	Stream_Write_UINT8(s, vectorSize); /* no timestamp */
+	for (UINT8 entryIndex = 0; entryIndex < vectorSize; entryIndex++)
+	{
+		UINT8 entry = 0;
+		for (int bit = 0; bit < 7; bit++)
+		{
+			const UINT16 seq = (UINT16)(baseSeq + (entryIndex * 7u) + (UINT8)bit);
+			if (rdpudp2_sequence_gt(seq, highSeq))
+				break;
+			if (rdpudp2_recv_ack_received(connection, seq))
+				entry |= (UINT8)(1u << bit);
+		}
+		Stream_Write_UINT8(s, entry);
+	}
+
+	size_t totalLength = Stream_GetPosition(s);
+	const size_t packetLength = totalLength - 1;
+	if (packetLength < 7)
+	{
+		Stream_Zero(s, 7 - packetLength);
+		totalLength = Stream_GetPosition(s);
+	}
+
+	const UINT8 shortLength =
+	    (packetLength < 7) ? WINPR_ASSERTING_INT_CAST(UINT8, packetLength) : 7;
+	BYTE* buffer = Stream_Buffer(s);
+	buffer[0] = (UINT8)(((RDPUDP2_PACKET_TYPE_DATA & 0x0Fu) << 1u) | (shortLength & 0x07u));
+	BYTE tmp = buffer[0];
+	buffer[0] = buffer[7];
+	buffer[7] = tmp;
+
+	const int sent = rdpudp_connection_send_raw(connection, buffer, totalLength);
+	Stream_Free(s, TRUE);
+	return sent == WINPR_ASSERTING_INT_CAST(int, totalLength);
+}
+
+static BOOL rdpudp2_retransmit_packet(rdpUdpConnection* connection, rdpUdpPendingPacket* packet)
+{
+	WINPR_ASSERT(connection);
+	WINPR_ASSERT(packet);
+
+	if (!packet->inUse || !packet->payload)
+		return TRUE;
+
+	if (packet->retransmits >= RDPUDP2_MAX_RETRANSMITS)
+	{
+		WLog_WARN(TAG,
+		          "RDP-UDP2 packet channelSeq=%" PRIu16 " dataSeq=%" PRIu16
+		          " exceeded retransmit limit",
+		          packet->channelSequence, (UINT16)packet->dataSequence);
+		return FALSE;
+	}
+
+	UINT16 newDataSeq = 0;
+	if (!rdpudp2_send_data_segment(connection, RDPUDP2_FLAG_DATA, packet->channelSequence,
+	                               packet->payload, packet->payloadLength, &newDataSeq))
+		return FALSE;
+
+	packet->dataSequence = newDataSeq;
+	packet->lastSentMs = GetTickCount64();
+	packet->retransmits++;
+	if (connection->result)
+		connection->result->retransmits++;
+
+	WLog_DBG(TAG,
+	         "RDP-UDP2 retransmit channelSeq=%" PRIu16 " newDataSeq=%" PRIu16
+	         " count=%" PRIu32,
+	         packet->channelSequence, (UINT16)packet->dataSequence, packet->retransmits);
+	return TRUE;
+}
+
+static BOOL rdpudp2_retransmit_by_data_seq(rdpUdpConnection* connection, UINT16 dataSeq)
+{
+	rdpUdpPendingPacket* packet = rdpudp2_pending_find_by_data_seq(connection, dataSeq);
+	return packet ? rdpudp2_retransmit_packet(connection, packet) : TRUE;
+}
+
+static BOOL rdpudp2_retransmit_due(rdpUdpConnection* connection)
+{
+	WINPR_ASSERT(connection);
+
+	const UINT64 now = GetTickCount64();
+	for (size_t x = 0; x < ARRAYSIZE(connection->pending); x++)
+	{
+		rdpUdpPendingPacket* packet = &connection->pending[x];
+		if (!packet->inUse)
+			continue;
+
+		if (now >= packet->lastSentMs &&
+		    now - packet->lastSentMs >= RDPUDP2_RETRANSMIT_TIMEOUT_MS)
+		{
+			if (!rdpudp2_retransmit_packet(connection, packet))
+				return FALSE;
+		}
+	}
+
+	return TRUE;
+}
+
+static BOOL rdpudp2_send_receive_ack(rdpUdpConnection* connection)
+{
+	WINPR_ASSERT(connection);
+
+	if (rdpudp2_sequence_gt((UINT16)connection->recvAckHigh,
+	                         (UINT16)(connection->recvSequence & 0xFFFFu)))
+		return rdpudp2_send_ack_vector(connection);
+	return rdpudp2_send_ack(connection);
+}
+
+static BOOL rdpudp2_maintenance(rdpUdpConnection* connection)
+{
+	WINPR_ASSERT(connection);
+
+	if (!rdpudp2_retransmit_due(connection))
+		return FALSE;
+
+	const UINT64 now = GetTickCount64();
+	if (connection->lastReceiveMs > 0 && now >= connection->lastReceiveMs &&
+	    now - connection->lastReceiveMs >= RDPUDP_IDLE_TIMEOUT_MS)
+		return FALSE;
+	const UINT64 lastActivity = (connection->lastSendMs > connection->lastKeepaliveMs)
+	                                ? connection->lastSendMs
+	                                : connection->lastKeepaliveMs;
+	if ((lastActivity == 0) || (now < lastActivity) ||
+	    (now - lastActivity < RDPUDP2_KEEPALIVE_INTERVAL_MS))
+		return TRUE;
+
+	if (!rdpudp2_send_receive_ack(connection))
+		return FALSE;
+
+	connection->lastKeepaliveMs = now;
+	WLog_DBG(TAG,
+	         "RDP-UDP2 keepalive sent cumulativeSeq=%" PRIu16 " recvHigh=%" PRIu16,
+	         (UINT16)(connection->recvSequence & 0xFFFFu), (UINT16)connection->recvAckHigh);
+	return TRUE;
+}
+
+static int rdpudp2_recv_payload(rdpUdpConnection* connection, BYTE* data, size_t length,
+                                int timeoutMs)
+{
+	const int buffered = rdpudp2_read_buffered_payload(connection, data, length);
+	if (buffered > 0)
+		return buffered;
+
+	BYTE buffer[RDPUDP_RECV_BUFFER_SIZE] = { 0 };
+	const int received = rdpudp_connection_recv_raw(connection, buffer, sizeof(buffer), timeoutMs);
+	if (received == 0)
+	{
+		return rdpudp2_maintenance(connection) ? 0 : -1;
+	}
+	if (received <= 0)
+		return received;
+	if (received < 8)
+		return -1;
+
+	BYTE tmp = buffer[0];
+	buffer[0] = buffer[7];
+	buffer[7] = tmp;
+
+	const UINT8 packetType = (buffer[0] >> 1u) & 0x0Fu;
+	const UINT8 shortLength = buffer[0] & 0x07u;
+	if (packetType == RDPUDP2_PACKET_TYPE_DUMMY)
+		return 0;
+
+	size_t packetLength = WINPR_ASSERTING_INT_CAST(size_t, received - 1);
+	if (shortLength < 7)
+		packetLength = shortLength;
+
+	wStream sbuffer = { 0 };
+	wStream* s = Stream_StaticInit(&sbuffer, &buffer[1], packetLength);
+	if (!Stream_CheckAndLogRequiredLength(TAG, s, 2))
+		return -1;
+
+	UINT16 header = 0;
+	Stream_Read_UINT16(s, header);
+	const UINT16 flags = header & 0x0FFFu;
+	if (((flags & RDPUDP2_FLAG_ACK) != 0) && ((flags & RDPUDP2_FLAG_ACKVEC) != 0))
+		return -1;
+
+	if ((flags & RDPUDP2_FLAG_ACK) != 0)
+	{
+		if (!Stream_CheckAndLogRequiredLength(TAG, s, 7))
+			return -1;
+		UINT16 ackSeq = 0;
+		Stream_Read_UINT16(s, ackSeq);
+		rdpudp2_pending_mark_acked_to(connection, ackSeq);
+		Stream_Seek(s, 4);
+		UINT8 ackMeta = 0;
+		Stream_Read_UINT8(s, ackMeta);
+		const UINT8 delayedAcks = ackMeta & 0x0Fu;
+		if (!Stream_SafeSeek(s, delayedAcks))
+			return -1;
+	}
+
+	if ((flags & RDPUDP2_FLAG_OVERHEAD) != 0)
+	{
+		if (!Stream_SafeSeek(s, 1))
+			return -1;
+	}
+
+	if ((flags & RDPUDP2_FLAG_DELAYACKINFO) != 0)
+	{
+		if (!Stream_SafeSeek(s, 3))
+			return -1;
+	}
+
+	if ((flags & RDPUDP2_FLAG_AOA) != 0)
+	{
+		if (!Stream_CheckAndLogRequiredLength(TAG, s, 2))
+			return -1;
+		UINT16 ackOfAcksSeq = 0;
+		Stream_Read_UINT16(s, ackOfAcksSeq);
+		rdpudp2_recv_ack_apply_aoa(connection, ackOfAcksSeq);
+	}
+
+	BOOL hasData = FALSE;
+	UINT16 dataSeq = 0;
+	if ((flags & RDPUDP2_FLAG_DATA) != 0)
+	{
+		if (!Stream_CheckAndLogRequiredLength(TAG, s, 4))
+			return -1;
+
+		Stream_Read_UINT16(s, dataSeq);
+		hasData = TRUE;
+	}
+
+	if ((flags & RDPUDP2_FLAG_ACKVEC) != 0)
+	{
+		if (!Stream_CheckAndLogRequiredLength(TAG, s, 3))
+			return -1;
+
+		UINT16 baseSeq = 0;
+		UINT8 vectorMeta = 0;
+		Stream_Read_UINT16(s, baseSeq);
+		Stream_Read_UINT8(s, vectorMeta);
+
+		const size_t vectorSize = vectorMeta & 0x7Fu;
+		const BOOL timestampPresent = (vectorMeta & 0x80u) != 0;
+		if (timestampPresent && !Stream_SafeSeek(s, 4))
+			return -1;
+		if (!Stream_CheckAndLogRequiredLength(TAG, s, vectorSize))
+			return -1;
+
+		UINT16 seq = baseSeq;
+		for (size_t i = 0; i < vectorSize; i++)
+		{
+			UINT8 entry = 0;
+			Stream_Read_UINT8(s, entry);
+			if ((entry & 0x80u) == 0)
+			{
+				for (int bit = 0; bit < 7; bit++, seq++)
+				{
+					if ((entry & (1u << bit)) != 0)
+						rdpudp2_pending_mark_acked(connection, seq);
+					else if (!rdpudp2_retransmit_by_data_seq(connection, seq))
+						return -1;
+				}
+			}
+			else
+			{
+				const BOOL receivedState = (entry & 0x40u) != 0;
+				const UINT8 runLength = entry & 0x3Fu;
+				for (UINT8 run = 0; run < runLength; run++, seq++)
+				{
+					if (receivedState)
+						rdpudp2_pending_mark_acked(connection, seq);
+					else if (!rdpudp2_retransmit_by_data_seq(connection, seq))
+						return -1;
+				}
+			}
+		}
+	}
+
+	if (hasData)
+	{
+		if (!Stream_CheckAndLogRequiredLength(TAG, s, 2))
+			return -1;
+
+		UINT16 channelSeq = 0;
+		Stream_Read_UINT16(s, channelSeq);
+		const size_t payloadLength = Stream_GetRemainingLength(s);
+		if (!rdpudp2_queue_channel_payload(connection, channelSeq, Stream_Pointer(s),
+		                                   payloadLength))
+			return -1;
+
+		rdpudp2_recv_ack_note(connection, dataSeq);
+		if (!rdpudp2_send_receive_ack(connection))
+			return -1;
+
+		return rdpudp2_read_buffered_payload(connection, data, length);
+	}
+
+	return 0;
+}
+
+static BOOL rdpudp1_skip_ack_vector_padding(wStream* s, size_t vectorSize)
+{
+	WINPR_ASSERT(s);
+	const size_t consumed = sizeof(UINT16) + vectorSize;
+	const size_t padding = (4u - (consumed % 4u)) % 4u;
+	return Stream_SafeSeek(s, padding);
+}
+
+static BOOL rdpudp1_process_ack_vector(rdpUdpConnection* connection, UINT32 sourceAck,
+                                       const BYTE* vector, size_t vectorSize)
+{
+	WINPR_ASSERT(connection);
+	WINPR_ASSERT(vector || (vectorSize == 0));
+
+	if (vectorSize == 0)
+	{
+		rdpudp1_pending_mark_acked_to(connection, sourceAck);
+		return TRUE;
+	}
+
+	UINT32 totalRun = 0;
+	for (size_t x = 0; x < vectorSize; x++)
+		totalRun += vector[x] & 0x3Fu;
+
+	if (totalRun == 0)
+	{
+		rdpudp1_pending_mark_acked(connection, sourceAck);
+		return TRUE;
+	}
+
+	UINT32 seq = sourceAck - totalRun + 1u;
+	for (size_t x = 0; x < vectorSize; x++)
+	{
+		const UINT8 entry = vector[x];
+		const UINT8 state = entry >> 6u;
+		const UINT8 runLength = entry & 0x3Fu;
+
+		for (UINT8 run = 0; run < runLength; run++, seq++)
+		{
+			if (state == 0)
+				rdpudp1_pending_mark_acked(connection, seq);
+			else if (state == 3)
+			{
+				if (connection->lossy)
+					continue;
+				rdpUdpPendingPacket* packet = rdpudp1_pending_find_by_data_seq(connection, seq);
+				if (packet && !rdpudp1_retransmit_packet(connection, packet))
+					return FALSE;
+			}
+		}
+	}
+
+	return TRUE;
+}
+
+static BOOL rdpudp1_handle_ack(rdpUdpConnection* connection, wStream* s, UINT32 sourceAck)
+{
+	WINPR_ASSERT(connection);
+	WINPR_ASSERT(s);
+
+	if (!Stream_CheckAndLogRequiredLength(TAG, s, 2))
+		return FALSE;
+
+	UINT16 vectorSize = 0;
+	Stream_Read_UINT16_BE(s, vectorSize);
+	if (vectorSize > 2048)
+		return FALSE;
+	if (!Stream_CheckAndLogRequiredLength(TAG, s, vectorSize))
+		return FALSE;
+
+	const BYTE* vector = Stream_Pointer(s);
+	if (!Stream_SafeSeek(s, vectorSize))
+		return FALSE;
+	if (!rdpudp1_skip_ack_vector_padding(s, vectorSize))
+		return FALSE;
+
+	return rdpudp1_process_ack_vector(connection, sourceAck, vector, vectorSize);
+}
+
+static void rdpudp1_promote_receive_ack(rdpUdpConnection* connection)
+{
+	WINPR_ASSERT(connection);
+
+	for (;;)
+	{
+		const UINT32 nextSeq = connection->recvSequence + 1u;
+		if (!rdpudp2_recv_segment_find(connection, nextSeq))
+			break;
+		connection->recvSequence = nextSeq;
+	}
+
+	if (rdpudp1_sequence_gt(connection->recvSequence, connection->recvAckHigh))
+		connection->recvAckHigh = connection->recvSequence;
+}
+
+static BOOL rdpudp1_queue_source_payload(rdpUdpConnection* connection, UINT32 sourceSeq,
+                                         const BYTE* payload, size_t payloadLength)
+{
+	WINPR_ASSERT(connection);
+	WINPR_ASSERT(payload || (payloadLength == 0));
+
+	if (sourceSeq == 0 || rdpudp1_sequence_le(sourceSeq, connection->recvReadSequence))
+		return TRUE;
+
+	const UINT32 expected = connection->recvReadSequence + 1u;
+	if (rdpudp1_sequence_distance(expected, sourceSeq) >= RDPUDP2_RECV_WINDOW)
+	{
+		WLog_WARN(TAG,
+		          "RDP-UDP receive source window overflow expected=%" PRIu32
+		          " received=%" PRIu32,
+		          expected, sourceSeq);
+		return FALSE;
+	}
+
+	if (rdpudp2_recv_segment_find(connection, sourceSeq))
+		return TRUE;
+
+	if (rdpudp1_sequence_gt(sourceSeq, connection->recvAckHigh))
+		connection->recvAckHigh = sourceSeq;
+	if (connection->lossy && sourceSeq != expected && connection->lossyOutOfOrderSinceMs == 0)
+		connection->lossyOutOfOrderSinceMs = GetTickCount64();
+
+	rdpUdpRecvSegment* segment = rdpudp2_recv_segment_find_free(connection);
+	if (!segment)
+	{
+		WLog_WARN(TAG, "RDP-UDP receive source window is full");
+		return FALSE;
+	}
+
+	BYTE* copy = nullptr;
+	if (payloadLength > 0)
+	{
+		copy = (BYTE*)malloc(payloadLength);
+		if (!copy)
+			return FALSE;
+		memcpy(copy, payload, payloadLength);
+	}
+
+	segment->inUse = TRUE;
+	segment->channelSequence = sourceSeq;
+	segment->payload = copy;
+	segment->payloadLength = payloadLength;
+
+	rdpudp1_promote_receive_ack(connection);
+	if (connection->recvSequence >= sourceSeq)
+		connection->lossyOutOfOrderSinceMs = 0;
+	return TRUE;
+}
+
+static void rdpudp1_recv_segment_take(rdpUdpConnection* connection, rdpUdpRecvSegment* segment)
+{
+	WINPR_ASSERT(connection);
+	WINPR_ASSERT(segment);
+
+	free(connection->readPayload);
+	connection->readPayload = segment->payload;
+	connection->readPayloadLength = segment->payloadLength;
+	connection->readPayloadOffset = 0;
+	connection->recvReadSequence = segment->channelSequence;
+	segment->payload = nullptr;
+	ZeroMemory(segment, sizeof(*segment));
+}
+
+static rdpUdpRecvSegment* rdpudp1_find_next_received_segment(rdpUdpConnection* connection)
+{
+	WINPR_ASSERT(connection);
+
+	const UINT32 expected = connection->recvReadSequence + 1u;
+	rdpUdpRecvSegment* best = nullptr;
+	UINT32 bestDistance = UINT32_MAX;
+	for (size_t x = 0; x < ARRAYSIZE(connection->recvSegments); x++)
+	{
+		rdpUdpRecvSegment* segment = &connection->recvSegments[x];
+		if (!segment->inUse || rdpudp1_sequence_le(segment->channelSequence, expected))
+			continue;
+
+		const UINT32 distance = rdpudp1_sequence_distance(expected, segment->channelSequence);
+		if (!best || distance < bestDistance)
+		{
+			best = segment;
+			bestDistance = distance;
+		}
+	}
+
+	return best;
+}
+
+static BOOL rdpudp1_lossy_skip_missing_if_due(rdpUdpConnection* connection)
+{
+	WINPR_ASSERT(connection);
+
+	if (!connection->lossy || connection->lossyOutOfOrderSinceMs == 0)
+		return FALSE;
+
+	const UINT64 now = GetTickCount64();
+	if (now >= connection->lossyOutOfOrderSinceMs &&
+	    now - connection->lossyOutOfOrderSinceMs < RDPUDP1_LOSSY_OUT_OF_ORDER_TIMEOUT_MS)
+		return FALSE;
+
+	rdpUdpRecvSegment* next = rdpudp1_find_next_received_segment(connection);
+	if (!next)
+	{
+		connection->lossyOutOfOrderSinceMs = 0;
+		return FALSE;
+	}
+
+	const UINT32 missingFrom = connection->recvReadSequence + 1u;
+	const UINT32 missingTo = next->channelSequence - 1u;
+	connection->recvReadSequence = missingTo;
+	connection->lossyOutOfOrderSinceMs = 0;
+	WLog_DBG(TAG,
+	         "RDP-UDP-L skipped missing sourceSeq range %" PRIu32 "-%" PRIu32
+	         " after out-of-order timeout",
+	         missingFrom, missingTo);
+	return TRUE;
+}
+
+static int rdpudp1_read_buffered_payload(rdpUdpConnection* connection, BYTE* data, size_t length)
+{
+	WINPR_ASSERT(connection);
+	WINPR_ASSERT(data);
+
+	if (!connection->readPayload)
+	{
+		rdpUdpRecvSegment* next =
+		    rdpudp2_recv_segment_find(connection, connection->recvReadSequence + 1u);
+		if (next)
+			rdpudp1_recv_segment_take(connection, next);
+	}
+
+	if (!connection->readPayload && rdpudp1_lossy_skip_missing_if_due(connection))
+	{
+		rdpUdpRecvSegment* next =
+		    rdpudp2_recv_segment_find(connection, connection->recvReadSequence + 1u);
+		if (next)
+			rdpudp1_recv_segment_take(connection, next);
+	}
+
+	if (!connection->readPayload)
+		return 0;
+
+	const size_t remaining = connection->readPayloadLength - connection->readPayloadOffset;
+	const size_t copyLength = (remaining < length) ? remaining : length;
+	if (copyLength > 0)
+		memcpy(data, connection->readPayload + connection->readPayloadOffset, copyLength);
+
+	connection->readPayloadOffset += copyLength;
+	if (connection->readPayloadOffset >= connection->readPayloadLength)
+	{
+		free(connection->readPayload);
+		connection->readPayload = nullptr;
+		connection->readPayloadLength = 0;
+		connection->readPayloadOffset = 0;
+	}
+
+	return WINPR_ASSERTING_INT_CAST(int, copyLength);
+}
+
+static int rdpudp1_recv_payload(rdpUdpConnection* connection, BYTE* data, size_t length,
+                                int timeoutMs)
+{
+	const int buffered = rdpudp1_read_buffered_payload(connection, data, length);
+	if (buffered > 0)
+		return buffered;
+
+	BYTE buffer[RDPUDP_RECV_BUFFER_SIZE] = { 0 };
+	const int received = rdpudp_connection_recv_raw(connection, buffer, sizeof(buffer), timeoutMs);
+	if (received == 0)
+		return rdpudp1_maintenance(connection) ? 0 : -1;
+	if (received <= 0)
+		return received;
+	if (received < 8)
+		return -1;
+
+	wStream sbuffer = { 0 };
+	wStream* s = Stream_StaticInit(&sbuffer, buffer, WINPR_ASSERTING_INT_CAST(size_t, received));
+
+	UINT32 sourceAck = 0;
+	UINT16 window = 0;
+	UINT16 flags = 0;
+	Stream_Read_UINT32_BE(s, sourceAck);
+	Stream_Read_UINT16_BE(s, window);
+	Stream_Read_UINT16_BE(s, flags);
+	WINPR_UNUSED(window);
+
+	if ((flags & RDPUDP_FLAG_ACK) != 0)
+	{
+		if (!rdpudp1_handle_ack(connection, s, sourceAck))
+			return -1;
+	}
+
+	if ((flags & RDPUDP_FLAG_ACK_OF_ACKS) != 0)
+	{
+		if (!Stream_SafeSeek(s, 4))
+			return -1;
+	}
+
+	if ((flags & RDPUDP_FLAG_DATA) == 0)
+		return 0;
+	if ((flags & RDPUDP_FLAG_FEC) != 0)
+		return 0;
+
+	if (!Stream_CheckAndLogRequiredLength(TAG, s, 8))
+		return -1;
+
+	UINT32 codedSeq = 0;
+	UINT32 sourceSeq = 0;
+	Stream_Read_UINT32_BE(s, codedSeq);
+	Stream_Read_UINT32_BE(s, sourceSeq);
+	WINPR_UNUSED(codedSeq);
+
+	const size_t payloadLength = Stream_GetRemainingLength(s);
+	if (!rdpudp1_queue_source_payload(connection, sourceSeq, Stream_Pointer(s), payloadLength))
+		return -1;
+
+	if (!rdpudp_send_connection_ack(connection))
+		return -1;
+
+	return rdpudp1_read_buffered_payload(connection, data, length);
+}
+
+static int rdpudp_connection_write_payload(rdpUdpConnection* connection, const BYTE* data,
+                                           size_t length)
+{
+	WINPR_ASSERT(connection);
+
+	if (connection->negotiatedVersion == RDPUDP_PROTOCOL_VERSION_1 ||
+	    connection->negotiatedVersion == RDPUDP_PROTOCOL_VERSION_2)
+	{
+		const size_t maxPayload = RDPUDP_DEFAULT_MTU - 32;
+		if (connection->lossy)
+		{
+			if (length == 0)
+				return 0;
+			if (length > maxPayload)
+			{
+				WLog_WARN(TAG,
+				          "RDP-UDP-L datagram length %" PRIuz
+				          " exceeds payload MTU %" PRIuz "; falling back to TCP",
+				          length, maxPayload);
+				return -1;
+			}
+
+			if (!rdpudp1_maintenance(connection))
+				return -1;
+
+			const UINT32 sourceSeq = connection->sendSequence++;
+			return rdpudp1_send_source_segment(connection, sourceSeq, data, length)
+			           ? WINPR_ASSERTING_INT_CAST(int, length)
+			           : -1;
+		}
+
+		size_t offset = 0;
+		while (offset < length)
+		{
+			if (!rdpudp1_maintenance(connection))
+				return -1;
+
+			const size_t chunk = ((length - offset) > maxPayload) ? maxPayload : (length - offset);
+			rdpUdpPendingPacket* pending = rdpudp2_pending_find_free(connection);
+			if (!pending)
+			{
+				if (!rdpudp1_retransmit_due(connection))
+					return -1;
+				pending = rdpudp2_pending_find_free(connection);
+				if (!pending)
+				{
+					WLog_WARN(TAG, "RDP-UDP send window is full; cannot queue %" PRIuz
+					               " bytes",
+					          chunk);
+					return -1;
+				}
+			}
+
+			BYTE* copy = (BYTE*)malloc(chunk);
+			if (!copy)
+				return -1;
+			memcpy(copy, data + offset, chunk);
+
+			const UINT32 sourceSeq = connection->sendSequence++;
+			if (!rdpudp1_send_source_segment(connection, sourceSeq, data + offset, chunk))
+			{
+				free(copy);
+				return -1;
+			}
+
+			pending->inUse = TRUE;
+			pending->dataSequence = sourceSeq;
+			pending->payload = copy;
+			pending->payloadLength = chunk;
+			pending->lastSentMs = GetTickCount64();
+			pending->retransmits = 0;
+			offset += chunk;
+		}
+
+		return WINPR_ASSERTING_INT_CAST(int, length);
+	}
+
+	if (connection->negotiatedVersion != RDPUDP_PROTOCOL_VERSION_3)
+		return -1;
+
+	const size_t maxPayload = RDPUDP_DEFAULT_MTU - 32;
+	size_t offset = 0;
+	while (offset < length)
+	{
+		if (!rdpudp2_maintenance(connection))
+			return -1;
+
+		const size_t chunk = ((length - offset) > maxPayload) ? maxPayload : (length - offset);
+		rdpUdpPendingPacket* pending = rdpudp2_pending_find_free(connection);
+		if (!pending)
+		{
+			if (!rdpudp2_retransmit_due(connection))
+				return -1;
+			pending = rdpudp2_pending_find_free(connection);
+			if (!pending)
+			{
+				WLog_WARN(TAG, "RDP-UDP2 send window is full; cannot queue %" PRIuz " bytes",
+				          chunk);
+				return -1;
+			}
+		}
+
+		BYTE* copy = (BYTE*)malloc(chunk);
+		if (!copy)
+			return -1;
+		memcpy(copy, data + offset, chunk);
+
+		const UINT16 channelSeq = connection->channelSequence++;
+		UINT16 dataSeq = 0;
+		UINT16 flags = RDPUDP2_FLAG_DATA;
+		if (!connection->sentDelayAckInfo)
+		{
+			flags |= RDPUDP2_FLAG_DELAYACKINFO;
+			connection->sentDelayAckInfo = TRUE;
+		}
+		if (!rdpudp2_send_data_segment(connection, flags, channelSeq, data + offset, chunk, &dataSeq))
+		{
+			free(copy);
+			return -1;
+		}
+
+		pending->inUse = TRUE;
+		pending->dataSequence = dataSeq;
+		pending->channelSequence = channelSeq;
+		pending->payload = copy;
+		pending->payloadLength = chunk;
+		pending->lastSentMs = GetTickCount64();
+		pending->retransmits = 0;
+		offset += chunk;
+	}
+
+	return WINPR_ASSERTING_INT_CAST(int, length);
+}
+
+static int rdpudp_connection_read_payload(rdpUdpConnection* connection, BYTE* data, size_t length,
+                                          int timeoutMs)
+{
+	WINPR_ASSERT(connection);
+
+	if (connection->negotiatedVersion == RDPUDP_PROTOCOL_VERSION_1 ||
+	    connection->negotiatedVersion == RDPUDP_PROTOCOL_VERSION_2)
+		return rdpudp1_recv_payload(connection, data, length, timeoutMs);
+
+	if (connection->negotiatedVersion != RDPUDP_PROTOCOL_VERSION_3)
+		return -1;
+
+	return rdpudp2_recv_payload(connection, data, length, timeoutMs);
+}
+
+typedef struct
+{
+	rdpUdpConnection* connection;
+	BOOL datagram;
+} BIO_RDPUDP;
+
+static int bio_rdpudp_write(BIO* bio, const char* buf, int size)
+{
+	BIO_RDPUDP* ptr = (BIO_RDPUDP*)BIO_get_data(bio);
+	if (!ptr || !ptr->connection || !buf || size < 0)
+		return -1;
+
+	BIO_clear_flags(bio, BIO_FLAGS_WRITE | BIO_FLAGS_READ | BIO_FLAGS_SHOULD_RETRY);
+	const int rc =
+	    rdpudp_connection_write_payload(ptr->connection, (const BYTE*)buf, (size_t)size);
+	if (rc < 0)
+		BIO_clear_flags(bio, BIO_FLAGS_SHOULD_RETRY);
+	return rc;
+}
+
+static int bio_rdpudp_read(BIO* bio, char* buf, int size)
+{
+	BIO_RDPUDP* ptr = (BIO_RDPUDP*)BIO_get_data(bio);
+	if (!ptr || !ptr->connection || !buf || size <= 0)
+		return -1;
+
+	BIO_clear_flags(bio, BIO_FLAGS_WRITE | BIO_FLAGS_READ | BIO_FLAGS_SHOULD_RETRY);
+	const int rc =
+	    rdpudp_connection_read_payload(ptr->connection, (BYTE*)buf, (size_t)size,
+	                                   ptr->connection->readTimeoutMs);
+	if (rc == 0)
+	{
+		BIO_set_flags(bio, BIO_FLAGS_READ | BIO_FLAGS_SHOULD_RETRY);
+		return -1;
+	}
+	if (rc < 0)
+		BIO_clear_flags(bio, BIO_FLAGS_SHOULD_RETRY);
+	return rc;
+}
+
+static int bio_rdpudp_puts(BIO* bio, const char* str)
+{
+	if (!str)
+		return 0;
+
+	const size_t max = (INT_MAX > SIZE_MAX) ? SIZE_MAX : INT_MAX;
+	const size_t size = strnlen(str, max);
+	if (size >= max)
+		return -1;
+	return BIO_write(bio, str, (int)size);
+}
+
+static int bio_rdpudp_gets(WINPR_ATTR_UNUSED BIO* bio, WINPR_ATTR_UNUSED char* str,
+                           WINPR_ATTR_UNUSED int size)
+{
+	return -2;
+}
+
+static long bio_rdpudp_ctrl(BIO* bio, int cmd, long arg1, void* arg2)
+{
+	BIO_RDPUDP* ptr = (BIO_RDPUDP*)BIO_get_data(bio);
+	rdpUdpConnection* connection = ptr ? ptr->connection : nullptr;
+
+	switch (cmd)
+	{
+		case BIO_CTRL_FLUSH:
+		case BIO_CTRL_DUP:
+			return 1;
+		case BIO_CTRL_PENDING:
+		case BIO_CTRL_WPENDING:
+			return 0;
+		case BIO_CTRL_GET_CLOSE:
+			return BIO_get_shutdown(bio);
+		case BIO_CTRL_SET_CLOSE:
+			BIO_set_shutdown(bio, (int)arg1);
+			return 1;
+#ifdef BIO_CTRL_DGRAM_QUERY_MTU
+		case BIO_CTRL_DGRAM_QUERY_MTU:
+#endif
+#ifdef BIO_CTRL_DGRAM_GET_MTU
+		case BIO_CTRL_DGRAM_GET_MTU:
+#endif
+#ifdef BIO_CTRL_DGRAM_GET_FALLBACK_MTU
+		case BIO_CTRL_DGRAM_GET_FALLBACK_MTU:
+#endif
+			return connection ? connection->mtu : (RDPUDP_DEFAULT_MTU - 64);
+#ifdef BIO_CTRL_DGRAM_SET_MTU
+		case BIO_CTRL_DGRAM_SET_MTU:
+			if (connection)
+				connection->mtu = arg1;
+			return arg1;
+#endif
+#ifdef BIO_CTRL_DGRAM_MTU_DISCOVER
+		case BIO_CTRL_DGRAM_MTU_DISCOVER:
+			return 1;
+#endif
+#ifdef BIO_CTRL_DGRAM_SET_RECV_TIMEOUT
+		case BIO_CTRL_DGRAM_SET_RECV_TIMEOUT:
+			if (connection && arg2)
+			{
+				const struct timeval* tv = (const struct timeval*)arg2;
+				const long timeoutMs = (tv->tv_sec * 1000L) + (tv->tv_usec / 1000L);
+				connection->recvTimeoutMs = timeoutMs;
+				if (timeoutMs > 0 && timeoutMs <= INT_MAX)
+					connection->readTimeoutMs = (int)timeoutMs;
+			}
+			return 1;
+#endif
+#ifdef BIO_CTRL_DGRAM_GET_RECV_TIMEOUT
+		case BIO_CTRL_DGRAM_GET_RECV_TIMEOUT:
+			if (connection && arg2)
+			{
+				struct timeval* tv = (struct timeval*)arg2;
+				tv->tv_sec = connection->recvTimeoutMs / 1000L;
+				tv->tv_usec = (connection->recvTimeoutMs % 1000L) * 1000L;
+			}
+			return 1;
+#endif
+#ifdef BIO_CTRL_DGRAM_SET_NEXT_TIMEOUT
+		case BIO_CTRL_DGRAM_SET_NEXT_TIMEOUT:
+			if (connection && arg2)
+			{
+				const struct timeval* tv = (const struct timeval*)arg2;
+				const long timeoutMs = (tv->tv_sec * 1000L) + (tv->tv_usec / 1000L);
+				if (timeoutMs > 0 && timeoutMs <= INT_MAX)
+					connection->readTimeoutMs = (int)timeoutMs;
+			}
+			return 1;
+#endif
+#ifdef BIO_CTRL_DGRAM_GET_RECV_TIMER_EXP
+		case BIO_CTRL_DGRAM_GET_RECV_TIMER_EXP:
+			return 0;
+#endif
+#ifdef BIO_CTRL_DGRAM_MTU_EXCEEDED
+		case BIO_CTRL_DGRAM_MTU_EXCEEDED:
+			return 0;
+#endif
+		default:
+			return 0;
+	}
+}
+
+static int bio_rdpudp_new(BIO* bio)
+{
+	BIO_RDPUDP* ptr = (BIO_RDPUDP*)calloc(1, sizeof(BIO_RDPUDP));
+	if (!ptr)
+		return 0;
+
+	BIO_set_data(bio, ptr);
+	BIO_set_init(bio, 1);
+	BIO_set_flags(bio, BIO_FLAGS_SHOULD_RETRY);
+	return 1;
+}
+
+static int bio_rdpudp_free(BIO* bio)
+{
+	if (!bio)
+		return 0;
+
+	BIO_RDPUDP* ptr = (BIO_RDPUDP*)BIO_get_data(bio);
+	free(ptr);
+	BIO_set_data(bio, nullptr);
+	BIO_set_init(bio, 0);
+	return 1;
+}
+
+static BIO_METHOD* BIO_s_rdpudp(BOOL datagram)
+{
+	static BIO_METHOD* streamBioMethods = nullptr;
+	static BIO_METHOD* datagramBioMethods = nullptr;
+	BIO_METHOD** bioMethods = datagram ? &datagramBioMethods : &streamBioMethods;
+	if (!*bioMethods)
+	{
+		*bioMethods = BIO_meth_new(datagram ? BIO_TYPE_DGRAM : BIO_TYPE_SOURCE_SINK,
+		                           datagram ? "RDPUDP-DGRAM" : "RDPUDP");
+		if (!*bioMethods)
+			return nullptr;
+		BIO_meth_set_write(*bioMethods, bio_rdpudp_write);
+		BIO_meth_set_read(*bioMethods, bio_rdpudp_read);
+		BIO_meth_set_puts(*bioMethods, bio_rdpudp_puts);
+		BIO_meth_set_gets(*bioMethods, bio_rdpudp_gets);
+		BIO_meth_set_ctrl(*bioMethods, bio_rdpudp_ctrl);
+		BIO_meth_set_create(*bioMethods, bio_rdpudp_new);
+		BIO_meth_set_destroy(*bioMethods, bio_rdpudp_free);
+	}
+	return *bioMethods;
+}
+
+static BIO* rdpudp_connection_new_bio(rdpUdpConnection* connection, BOOL datagram)
+{
+	BIO* bio = BIO_new(BIO_s_rdpudp(datagram));
+	if (!bio)
+		return nullptr;
+
+	BIO_RDPUDP* ptr = (BIO_RDPUDP*)BIO_get_data(bio);
+	if (!ptr)
+	{
+		BIO_free(bio);
+		return nullptr;
+	}
+
+	ptr->connection = connection;
+	ptr->datagram = datagram;
+	return bio;
+}
+
+static rdpUdpConnection* rdpudp_client_connect(rdpRdp* rdp, UINT32 requestId,
+                                               UINT16 requestedProtocol,
+                                               const BYTE cookie[RDPUDP_COOKIE_LEN],
+                                               rdpUdpClientBootstrapResult* result)
+{
+	WINPR_ASSERT(rdp);
+	WINPR_ASSERT(cookie);
+	WINPR_ASSERT(result);
+
+	ZeroMemory(result, sizeof(*result));
+	result->requestedProtocol = requestedProtocol;
+	result->lossy = requestedProtocol == INITIATE_REQUEST_PROTOCOL_UDPFECL;
+
+	if (requestedProtocol != INITIATE_REQUEST_PROTOCOL_UDPFECR &&
+	    requestedProtocol != INITIATE_REQUEST_PROTOCOL_UDPFECL)
+	{
+		result->failureStage = RDPUDP_CLIENT_FAILURE_UNSUPPORTED_PROTOCOL;
+		WLog_WARN(TAG, "unsupported RDP-UDP requestedProtocol=0x%04" PRIx16, requestedProtocol);
+		return nullptr;
+	}
+
+	rdpSettings* settings = rdp->settings;
+	WINPR_ASSERT(settings);
+
+	const char* hostname = freerdp_settings_get_string(settings, FreeRDP_ServerHostname);
+	const UINT32 port = freerdp_settings_get_uint32(settings, FreeRDP_ServerPort);
+	if (!hostname || port == 0 || port > UINT16_MAX)
+	{
+		result->failureStage = RDPUDP_CLIENT_FAILURE_INVALID_ENDPOINT;
+		WLog_WARN(TAG, "invalid RDP-UDP endpoint host=%s port=%" PRIu32,
+		          hostname ? hostname : "(null)", port);
+		return nullptr;
+	}
+
+	wStream* syn = Stream_New(nullptr, RDPUDP_DEFAULT_MTU);
+	if (!syn)
+		return nullptr;
+
+	UINT32 initialSequence = 0;
+	if (!rdpudp_write_syn(syn, requestedProtocol, cookie, &initialSequence))
+	{
+		Stream_Free(syn, TRUE);
+		return nullptr;
+	}
+	result->initialSequence = initialSequence;
+
+	SOCKET sock = rdpudp_connect_socket(rdp, &result->lastSocketError);
+	if (sock == INVALID_SOCKET)
+	{
+		result->failureStage = RDPUDP_CLIENT_FAILURE_SOCKET_CONNECT;
+		WLog_WARN(TAG, "RDP-UDP requestId=%" PRIu32 " connect to %s:%" PRIu32 " failed: %d",
+		          requestId, hostname, port, result->lastSocketError);
+		Stream_Free(syn, TRUE);
+		return nullptr;
+	}
+	result->socketOpened = TRUE;
+
+	BOOL ok = FALSE;
+	BYTE recvbuf[RDPUDP_RECV_BUFFER_SIZE] = { 0 };
+	const int synLength = WINPR_ASSERTING_INT_CAST(int, Stream_GetPosition(syn));
+	for (int attempt = 0; attempt < RDPUDP_SYN_SEND_ATTEMPTS && !ok; attempt++)
+	{
+		if (attempt > 0)
+			result->retransmits++;
+
+		const int sent = _send(sock, (const char*)Stream_Buffer(syn), synLength, 0);
+		if (sent != synLength)
+		{
+			result->failureStage = RDPUDP_CLIENT_FAILURE_SYN_SEND;
+			result->lastSocketError = rdpudp_socket_error();
+			WLog_WARN(TAG,
+			          "RDP-UDP requestId=%" PRIu32 " SYN send attempt %d/%d failed: sent=%d "
+			          "expected=%d error=%d",
+			          requestId, attempt + 1, RDPUDP_SYN_SEND_ATTEMPTS, sent, synLength,
+			          result->lastSocketError);
+			continue;
+		}
+
+		result->packetsSent++;
+		result->bytesSent += WINPR_ASSERTING_INT_CAST(UINT32, sent);
+		if (!rdpudp_wait_readable(sock, RDPUDP_SYN_TIMEOUT_MS))
+		{
+			result->failureStage = RDPUDP_CLIENT_FAILURE_SYN_TIMEOUT;
+			continue;
+		}
+
+		const int received = _recv(sock, (char*)recvbuf, sizeof(recvbuf), 0);
+		if (received <= 0)
+		{
+			result->failureStage = RDPUDP_CLIENT_FAILURE_SYN_RECV;
+			result->lastSocketError = rdpudp_socket_error();
+			continue;
+		}
+
+		result->packetsReceived++;
+		result->bytesReceived += WINPR_ASSERTING_INT_CAST(UINT32, received);
+		ok = rdpudp_parse_syn_ack(recvbuf, WINPR_ASSERTING_INT_CAST(size_t, received),
+		                          initialSequence, result);
+		if (!ok)
+			result->failureStage = RDPUDP_CLIENT_FAILURE_SYN_PARSE;
+	}
+
+	if (ok)
+	{
+		result->failureStage = RDPUDP_CLIENT_FAILURE_NONE;
+		WLog_INFO(TAG,
+		          "RDP-UDP requestId=%" PRIu32 " SYN/SYN-ACK succeeded host=%s port=%" PRIu32
+		          " mode=%s udpVersion=0x%04" PRIx16 " sent=%" PRIu64 "/%" PRIu64
+		          " recv=%" PRIu64 "/%" PRIu64,
+		          requestId, hostname, port, result->lossy ? "UDP-L" : "UDP-R",
+		          result->negotiatedVersion, result->packetsSent, result->bytesSent,
+		          result->packetsReceived, result->bytesReceived);
+	}
+	else
+	{
+		WLog_WARN(TAG,
+		          "RDP-UDP requestId=%" PRIu32 " SYN bootstrap failed host=%s port=%" PRIu32
+		          " mode=%s sent=%" PRIu64 "/%" PRIu64 " recv=%" PRIu64 "/%" PRIu64
+		          " lastError=%d",
+		          requestId, hostname, port, result->lossy ? "UDP-L" : "UDP-R",
+		          result->packetsSent, result->bytesSent, result->packetsReceived,
+		          result->bytesReceived, result->lastSocketError);
+	}
+
+	Stream_Free(syn, TRUE);
+	if (!ok)
+	{
+		closesocket(sock);
+		return nullptr;
+	}
+
+	rdpUdpConnection* connection = (rdpUdpConnection*)calloc(1, sizeof(rdpUdpConnection));
+	if (!connection)
+	{
+		result->failureStage = RDPUDP_CLIENT_FAILURE_RESOURCE;
+		closesocket(sock);
+		return nullptr;
+	}
+
+	connection->rdp = rdp;
+	connection->sock = sock;
+	connection->requestedProtocol = requestedProtocol;
+	connection->negotiatedVersion = result->negotiatedVersion;
+	connection->lossy = result->lossy;
+	connection->sendSequence = result->initialSequence + 1u;
+	connection->codedSequence = result->initialSequence + 1u;
+	connection->recvSequence = result->serverInitialSequence;
+	connection->recvReadSequence = result->serverInitialSequence;
+	connection->recvAckHigh = result->serverInitialSequence;
+	connection->channelSequence = 0;
+	connection->recvChannelSequence = 0;
+	connection->readTimeoutMs = RDPUDP_DATA_TIMEOUT_MS;
+	connection->mtu = RDPUDP_DEFAULT_MTU - 64;
+	connection->recvTimeoutMs = RDPUDP_DATA_TIMEOUT_MS;
+	connection->result = result;
+	connection->lastReceiveMs = GetTickCount64();
+
+	if (!rdpudp_send_connection_ack(connection))
+	{
+		result->failureStage = RDPUDP_CLIENT_FAILURE_FINAL_ACK;
+		WLog_WARN(TAG, "RDP-UDP requestId=%" PRIu32 " final ACK send failed", requestId);
+		rdpudp_connection_free(connection);
+		return nullptr;
+	}
+
+	return connection;
+}
+
+BOOL rdpudp_client_bootstrap(rdpRdp* rdp, UINT32 requestId, UINT16 requestedProtocol,
+                             const BYTE cookie[RDPUDP_COOKIE_LEN],
+                             rdpUdpClientBootstrapResult* result)
+{
+	rdpUdpConnection* connection =
+	    rdpudp_client_connect(rdp, requestId, requestedProtocol, cookie, result);
+	const BOOL ok = connection != nullptr;
+	rdpudp_connection_free(connection);
+	return ok;
+}
+
+static BOOL rdpemt_write_tunnel_header(wStream* s, UINT8 action, UINT16 payloadLength)
+{
+	WINPR_ASSERT(s);
+	if (!Stream_EnsureRemainingCapacity(s, RDPTUNNEL_HEADER_LENGTH + payloadLength))
+		return FALSE;
+
+	Stream_Write_UINT8(s, action & 0x0Fu);
+	Stream_Write_UINT16(s, payloadLength);
+	Stream_Write_UINT8(s, RDPTUNNEL_HEADER_LENGTH);
+	return TRUE;
+}
+
+BOOL rdpudp_test_write_create_request(wStream* s, UINT32 requestId,
+                                      const BYTE cookie[RDPUDP_COOKIE_LEN])
+{
+	WINPR_ASSERT(s);
+	WINPR_ASSERT(cookie);
+	if (!rdpemt_write_tunnel_header(s, RDPTUNNEL_ACTION_CREATEREQUEST,
+	                                RDPTUNNEL_CREATE_REQUEST_PAYLOAD_LENGTH))
+		return FALSE;
+	Stream_Write_UINT32(s, requestId);
+	Stream_Zero(s, 4);
+	Stream_Write(s, cookie, RDPUDP_COOKIE_LEN);
+	return TRUE;
+}
+
+static BOOL rdpemt_send_create_request(rdpTls* tls, UINT32 requestId,
+                                        const BYTE cookie[RDPUDP_COOKIE_LEN])
+{
+	WINPR_ASSERT(tls);
+	WINPR_ASSERT(cookie);
+
+	wStream* s = Stream_New(nullptr, RDPTUNNEL_HEADER_LENGTH +
+	                                     RDPTUNNEL_CREATE_REQUEST_PAYLOAD_LENGTH);
+	if (!s)
+		return FALSE;
+
+	if (!rdpudp_test_write_create_request(s, requestId, cookie))
+	{
+		Stream_Free(s, TRUE);
+		return FALSE;
+	}
+
+	const int written = freerdp_tls_write_all(tls, Stream_Buffer(s), Stream_GetPosition(s));
+	const BOOL ok = written == WINPR_ASSERTING_INT_CAST(int, Stream_GetPosition(s));
+	Stream_Free(s, TRUE);
+	return ok;
+}
+
+static int rdpemt_tls_read_exact(rdpTls* tls, BYTE* data, size_t length);
+static int rdpemt_tls_read_exact_timeout(rdpTls* tls, BYTE* data, size_t length,
+                                         UINT64 timeoutMs);
+
+static BOOL rdpemt_recv_create_response(rdpTls* tls, HRESULT* hr)
+{
+	WINPR_ASSERT(tls);
+	WINPR_ASSERT(hr);
+
+	BYTE header[RDPTUNNEL_HEADER_LENGTH] = { 0 };
+	const int headerStatus =
+	    rdpemt_tls_read_exact_timeout(tls, header, sizeof(header), RDPUDP_HANDSHAKE_TIMEOUT_MS);
+	if (headerStatus != RDPTUNNEL_HEADER_LENGTH)
+		return FALSE;
+
+	const UINT8 actionLow = header[0] & 0x0Fu;
+	const UINT8 actionHigh = (header[0] >> 4u) & 0x0Fu;
+	if (actionLow != RDPTUNNEL_ACTION_CREATERESPONSE &&
+	    actionHigh != RDPTUNNEL_ACTION_CREATERESPONSE)
+		return FALSE;
+
+	wStream sbuffer = { 0 };
+	wStream* s = Stream_StaticInit(&sbuffer, header, sizeof(header));
+	Stream_Seek(s, 1);
+	UINT16 payloadLength = 0;
+	UINT8 headerLength = 0;
+	Stream_Read_UINT16(s, payloadLength);
+	Stream_Read_UINT8(s, headerLength);
+	if (headerLength < RDPTUNNEL_HEADER_LENGTH ||
+	    payloadLength < RDPTUNNEL_CREATE_RESPONSE_PAYLOAD_LENGTH)
+		return FALSE;
+
+	if (headerLength > RDPTUNNEL_HEADER_LENGTH)
+	{
+		BYTE subheaders[256] = { 0 };
+		const size_t extra = headerLength - RDPTUNNEL_HEADER_LENGTH;
+		if (extra > sizeof(subheaders))
+			return FALSE;
+		const int subheaderStatus =
+		    rdpemt_tls_read_exact_timeout(tls, subheaders, extra, RDPUDP_HANDSHAKE_TIMEOUT_MS);
+		if (subheaderStatus != WINPR_ASSERTING_INT_CAST(int, extra))
+			return FALSE;
+	}
+
+	BYTE* payload = (BYTE*)malloc(payloadLength);
+	if (!payload)
+		return FALSE;
+
+	const int payloadStatus =
+	    rdpemt_tls_read_exact_timeout(tls, payload, payloadLength, RDPUDP_HANDSHAKE_TIMEOUT_MS);
+	if (payloadStatus != payloadLength)
+	{
+		free(payload);
+		return FALSE;
+	}
+
+	wStream payloadBuffer = { 0 };
+	s = Stream_StaticInit(&payloadBuffer, payload, payloadLength);
+	Stream_Read_INT32(s, *hr);
+	free(payload);
+	return TRUE;
+}
+
+static int rdpudp_tls_connect(rdpUdpConnection* connection, rdpTls* tls, BIO* bio)
+{
+	WINPR_ASSERT(connection);
+	WINPR_ASSERT(tls);
+	WINPR_ASSERT(bio);
+
+	rdpSettings* settings = connection->rdp ? connection->rdp->settings : nullptr;
+	const BOOL dtls = connection->requestedProtocol == INITIATE_REQUEST_PROTOCOL_UDPFECL;
+	const int originalTimeoutMs = connection->readTimeoutMs;
+	const long originalRecvTimeoutMs = connection->recvTimeoutMs;
+	UINT16 originalMinVersion = 0;
+	UINT16 originalMaxVersion = 0;
+	BOOL restoreVersions = FALSE;
+
+	connection->readTimeoutMs = RDPUDP_TLS_HANDSHAKE_READ_TIMEOUT_MS;
+	connection->recvTimeoutMs = RDPUDP_TLS_HANDSHAKE_READ_TIMEOUT_MS;
+
+	if (dtls && settings)
+	{
+		originalMinVersion = freerdp_settings_get_uint16(settings, FreeRDP_TLSMinVersion);
+		originalMaxVersion = freerdp_settings_get_uint16(settings, FreeRDP_TLSMaxVersion);
+		restoreVersions = TRUE;
+#ifdef DTLS1_2_VERSION
+		if (!freerdp_settings_set_uint16(settings, FreeRDP_TLSMinVersion, DTLS1_2_VERSION))
+			goto fail_restore;
+#else
+		if (!freerdp_settings_set_uint16(settings, FreeRDP_TLSMinVersion, 0))
+			goto fail_restore;
+#endif
+		if (!freerdp_settings_set_uint16(settings, FreeRDP_TLSMaxVersion, 0))
+			goto fail_restore;
+	}
+
+	const SSL_METHOD* method = freerdp_tls_get_ssl_method(dtls, TRUE);
+	TlsHandshakeResult result = freerdp_tls_connect_ex(tls, bio, method);
+	if (restoreVersions)
+	{
+		(void)freerdp_settings_set_uint16(settings, FreeRDP_TLSMinVersion, originalMinVersion);
+		(void)freerdp_settings_set_uint16(settings, FreeRDP_TLSMaxVersion, originalMaxVersion);
+	}
+
+	const UINT64 started = GetTickCount64();
+	while (result == TLS_HANDSHAKE_CONTINUE)
+	{
+		if (GetTickCount64() - started >= RDPUDP_HANDSHAKE_TIMEOUT_MS)
+			break;
+
+		HANDLE abort = nullptr;
+		if (tls->context)
+			abort = freerdp_abort_event(tls->context);
+		if (abort && WaitForSingleObject(abort, 10) == WAIT_OBJECT_0)
+			break;
+
+		result = freerdp_tls_handshake(tls);
+	}
+
+	connection->readTimeoutMs = originalTimeoutMs;
+	connection->recvTimeoutMs = originalRecvTimeoutMs;
+	return result == TLS_HANDSHAKE_SUCCESS ? 1 : -1;
+
+fail_restore:
+	if (restoreVersions)
+	{
+		(void)freerdp_settings_set_uint16(settings, FreeRDP_TLSMinVersion, originalMinVersion);
+		(void)freerdp_settings_set_uint16(settings, FreeRDP_TLSMaxVersion, originalMaxVersion);
+	}
+	connection->readTimeoutMs = originalTimeoutMs;
+	connection->recvTimeoutMs = originalRecvTimeoutMs;
+	return -1;
+}
+
+static rdpUdpTunnel* rdpudp_tunnel_new(rdpUdpConnection* connection, rdpTls* tls,
+                                       UINT16 requestedProtocol,
+                                       const rdpUdpClientBootstrapResult* result)
+{
+	WINPR_ASSERT(connection);
+	WINPR_ASSERT(tls);
+	WINPR_ASSERT(result);
+
+	rdpUdpTunnel* tunnel = (rdpUdpTunnel*)calloc(1, sizeof(rdpUdpTunnel));
+	if (!tunnel)
+		return nullptr;
+
+	tunnel->connection = connection;
+	tunnel->tls = tls;
+	tunnel->requestedProtocol = requestedProtocol;
+	tunnel->result = *result;
+	connection->result = &tunnel->result;
+	InitializeCriticalSection(&tunnel->lock);
+	tunnel->lockInitialized = TRUE;
+	tunnel->state = RDPUDP_TUNNEL_STATE_READY;
+	return tunnel;
+}
+
+#include "rdpudp_async.inc"
+
+rdpUdpTunnel* rdpudp_client_open_tunnel(rdpRdp* rdp, UINT32 requestId, UINT16 requestedProtocol,
+                                        const BYTE cookie[RDPUDP_COOKIE_LEN],
+                                        rdpUdpClientBootstrapResult* result)
+{
+	rdpUdpConnection* connection =
+	    rdpudp_client_connect(rdp, requestId, requestedProtocol, cookie, result);
+	if (!connection)
+		return nullptr;
+
+	rdpUdpTunnel* tunnel = nullptr;
+	rdpTls* tls = nullptr;
+	BIO* bio = nullptr;
+
+	if (connection->negotiatedVersion != RDPUDP_PROTOCOL_VERSION_1 &&
+	    connection->negotiatedVersion != RDPUDP_PROTOCOL_VERSION_2 &&
+	    connection->negotiatedVersion != RDPUDP_PROTOCOL_VERSION_3)
+	{
+		result->failureStage = RDPUDP_CLIENT_FAILURE_UNSUPPORTED_VERSION;
+		WLog_WARN(TAG,
+		          "RDP-UDP negotiated unsupported version 0x%04" PRIx16
+		          "; falling back to TCP",
+		          connection->negotiatedVersion);
+		goto out;
+	}
+
+	tls = freerdp_tls_new(rdp->context);
+	bio = rdpudp_connection_new_bio(connection, result->lossy);
+	if (!tls || !bio)
+	{
+		result->failureStage = RDPUDP_CLIENT_FAILURE_RESOURCE;
+		goto out;
+	}
+
+	const int tlsStatus = rdpudp_tls_connect(connection, tls, bio);
+	bio = nullptr; /* tls owns the BIO after tls_prepare succeeds. */
+	if (tlsStatus != 1)
+	{
+		result->failureStage = RDPUDP_CLIENT_FAILURE_TLS_HANDSHAKE;
+		WLog_WARN(TAG,
+		          "RDP-UDP requestId=%" PRIu32 " %s over UDP version 0x%04" PRIx16
+		          " failed",
+		          requestId, result->lossy ? "DTLS" : "TLS", connection->negotiatedVersion);
+		goto out;
+	}
+	result->tlsHandshakeSucceeded = TRUE;
+
+	if (!rdpemt_send_create_request(tls, requestId, cookie))
+	{
+		result->failureStage = RDPUDP_CLIENT_FAILURE_TUNNEL_REQUEST;
+		WLog_WARN(TAG, "RDP-UDP requestId=%" PRIu32 " Tunnel Create Request send failed",
+		          requestId);
+		goto out;
+	}
+
+	HRESULT hr = E_ABORT;
+	if (!rdpemt_recv_create_response(tls, &hr))
+	{
+		result->failureStage = RDPUDP_CLIENT_FAILURE_TUNNEL_RESPONSE;
+		WLog_WARN(TAG, "RDP-UDP requestId=%" PRIu32 " Tunnel Create Response read failed",
+		          requestId);
+		goto out;
+	}
+
+	result->tunnelHr = hr;
+	result->tunnelCreateSucceeded = (hr == 0);
+	WLog_Print(WLog_Get(TAG), result->tunnelCreateSucceeded ? WLOG_INFO : WLOG_WARN,
+	           "RDP-UDP requestId=%" PRIu32 " Tunnel Create Response hr=0x%08" PRIx32,
+	           requestId, (UINT32)hr);
+	if (!result->tunnelCreateSucceeded)
+	{
+		result->failureStage = RDPUDP_CLIENT_FAILURE_TUNNEL_HR;
+		goto out;
+	}
+
+	tunnel = rdpudp_tunnel_new(connection, tls, requestedProtocol, result);
+	if (!tunnel)
+	{
+		result->failureStage = RDPUDP_CLIENT_FAILURE_RESOURCE;
+		goto out;
+	}
+
+	result->failureStage = RDPUDP_CLIENT_FAILURE_NONE;
+	connection = nullptr;
+	tls = nullptr;
+
+out:
+	if (bio)
+		BIO_free(bio);
+	freerdp_tls_free(tls);
+	rdpudp_connection_free(connection);
+	return tunnel;
+}
+
+BOOL rdpudp_client_probe_tunnel(rdpRdp* rdp, UINT32 requestId, UINT16 requestedProtocol,
+                                const BYTE cookie[RDPUDP_COOKIE_LEN],
+                                rdpUdpClientBootstrapResult* result)
+{
+	rdpUdpTunnel* tunnel =
+	    rdpudp_client_open_tunnel(rdp, requestId, requestedProtocol, cookie, result);
+	const BOOL ok = tunnel != nullptr;
+	rdpudp_tunnel_free(tunnel);
+	return ok;
+}
+
+void rdpudp_tunnel_set_interactive(rdpUdpTunnel* tunnel, BOOL interactive)
+{
+	if (!tunnel || !tunnel->connection)
+		return;
+
+	tunnel->connection->readTimeoutMs = interactive ? 150 : RDPUDP_DATA_TIMEOUT_MS;
+}
+
+static int rdpemt_tls_read_exact(rdpTls* tls, BYTE* data, size_t length)
+{
+	WINPR_ASSERT(tls);
+	WINPR_ASSERT(data || (length == 0));
+
+	size_t offset = 0;
+	UINT64 partialStartMs = 0;
+	while (offset < length)
+	{
+		if (length - offset > INT_MAX)
+			return -1;
+
+		const int status = BIO_read(tls->bio, data + offset, (int)(length - offset));
+		if (status <= 0)
+		{
+			if (BIO_should_retry(tls->bio))
+			{
+				if (offset == 0)
+					return 0;
+				if (partialStartMs == 0)
+					partialStartMs = GetTickCount64();
+				if (GetTickCount64() - partialStartMs > 1000)
+					return -1;
+				continue;
+			}
+			return status;
+		}
+
+		if (offset == 0)
+			partialStartMs = GetTickCount64();
+		offset += (size_t)status;
+	}
+
+	return WINPR_ASSERTING_INT_CAST(int, length);
+}
+
+static int rdpemt_tls_read_exact_timeout(rdpTls* tls, BYTE* data, size_t length,
+                                         UINT64 timeoutMs)
+{
+	WINPR_ASSERT(tls);
+	WINPR_ASSERT(data || (length == 0));
+
+	const UINT64 started = GetTickCount64();
+	for (;;)
+	{
+		const int status = rdpemt_tls_read_exact(tls, data, length);
+		if (status != 0)
+			return status;
+
+		if (GetTickCount64() - started >= timeoutMs)
+			return 0;
+
+		HANDLE abort = nullptr;
+		if (tls->context)
+			abort = freerdp_abort_event(tls->context);
+		if (abort && WaitForSingleObject(abort, 10) == WAIT_OBJECT_0)
+			return -1;
+	}
+}
+
+BOOL rdpudp_tunnel_write_data(rdpUdpTunnel* tunnel, const BYTE* data, size_t length)
+{
+	if (!tunnel || !tunnel->tls || tunnel->aborted || (!data && (length > 0)) ||
+	    length > UINT16_MAX)
+		return FALSE;
+
+	BOOL ok = FALSE;
+	wStream* s = Stream_New(nullptr, RDPTUNNEL_HEADER_LENGTH + length);
+	if (!s)
+		return FALSE;
+
+	if (!rdpemt_write_tunnel_header(s, RDPTUNNEL_ACTION_DATA, (UINT16)length))
+		goto out;
+	if (length > 0)
+		Stream_Write(s, data, length);
+
+	EnterCriticalSection(&tunnel->lock);
+	const int written = freerdp_tls_write_all(tunnel->tls, Stream_Buffer(s), Stream_GetPosition(s));
+	LeaveCriticalSection(&tunnel->lock);
+	ok = written == WINPR_ASSERTING_INT_CAST(int, Stream_GetPosition(s));
+
+out:
+	Stream_Free(s, TRUE);
+	return ok;
+}
+
+int rdpudp_tunnel_read_data(rdpUdpTunnel* tunnel, BYTE* data, size_t length, int timeoutMs)
+{
+	if (!tunnel || !tunnel->tls || tunnel->aborted || !data || length == 0)
+		return -1;
+
+	BYTE header[RDPTUNNEL_HEADER_LENGTH] = { 0 };
+	const int oldTimeout = tunnel->connection ? tunnel->connection->readTimeoutMs : 0;
+	if (tunnel->connection && timeoutMs > 0)
+		tunnel->connection->readTimeoutMs = timeoutMs;
+
+	EnterCriticalSection(&tunnel->lock);
+	int status = rdpemt_tls_read_exact(tunnel->tls, header, sizeof(header));
+	if (status <= 0)
+		goto out_unlock;
+
+	const UINT8 actionLow = header[0] & 0x0Fu;
+	const UINT8 actionHigh = (header[0] >> 4u) & 0x0Fu;
+	const UINT8 action = (actionLow != 0) ? actionLow : actionHigh;
+	const UINT16 payloadLength = (UINT16)(header[1] | ((UINT16)header[2] << 8u));
+	const UINT8 headerLength = header[3];
+	if (headerLength < RDPTUNNEL_HEADER_LENGTH)
+	{
+		status = -1;
+		goto out_unlock;
+	}
+
+	if (headerLength > RDPTUNNEL_HEADER_LENGTH)
+	{
+		BYTE subheaders[256] = { 0 };
+		const size_t extra = headerLength - RDPTUNNEL_HEADER_LENGTH;
+		if (extra > sizeof(subheaders))
+		{
+			status = -1;
+			goto out_unlock;
+		}
+		status = rdpemt_tls_read_exact(tunnel->tls, subheaders, extra);
+		if (status <= 0)
+			goto out_unlock;
+	}
+
+	if (payloadLength > length)
+	{
+		status = -1;
+		goto out_unlock;
+	}
+
+	status = rdpemt_tls_read_exact(tunnel->tls, data, payloadLength);
+	if (status <= 0)
+		goto out_unlock;
+
+	status = (action == RDPTUNNEL_ACTION_DATA) ? payloadLength : 0;
+
+out_unlock:
+	LeaveCriticalSection(&tunnel->lock);
+	if (tunnel->connection && timeoutMs > 0)
+		tunnel->connection->readTimeoutMs = oldTimeout;
+	return status;
+}
+
+void rdpudp_tunnel_abort(rdpUdpTunnel* tunnel)
+{
+	if (!tunnel || tunnel->aborted)
+		return;
+
+	tunnel->aborted = TRUE;
+	if (tunnel->connection && tunnel->connection->sock != INVALID_SOCKET)
+	{
+		closesocket(tunnel->connection->sock);
+		tunnel->connection->sock = INVALID_SOCKET;
+	}
+}
+
+const rdpUdpClientBootstrapResult* rdpudp_tunnel_stats(const rdpUdpTunnel* tunnel)
+{
+	return tunnel ? &tunnel->result : nullptr;
+}
+
+void rdpudp_tunnel_free(rdpUdpTunnel* tunnel)
+{
+	if (!tunnel)
+		return;
+
+	rdpudp_tunnel_abort(tunnel);
+	if (tunnel->socketEvent)
+		(void)WSACloseEvent(tunnel->socketEvent);
+	BIO_free(tunnel->pendingBio);
+	freerdp_tls_free(tunnel->tls);
+	rdpudp_connection_free(tunnel->connection);
+	while (tunnel->rxHead)
+	{
+		rdpUdpFrame* frame = tunnel->rxHead;
+		tunnel->rxHead = frame->next;
+		free(frame);
+	}
+	free(tunnel->wireBuffer);
+	if (tunnel->lockInitialized)
+		DeleteCriticalSection(&tunnel->lock);
+	free(tunnel);
+}
diff --git a/libfreerdp/core/rdpudp.h b/libfreerdp/core/rdpudp.h
new file mode 100644
index 00000000..b4c3d8bc
--- /dev/null
+++ b/libfreerdp/core/rdpudp.h
@@ -0,0 +1,160 @@
+/**
+ * FreeRDP: A Remote Desktop Protocol Implementation
+ * RDP-UDP client bootstrap
+ *
+ * Licensed under the Apache License, Version 2.0
+ */
+
+#ifndef FREERDP_LIB_CORE_RDPUDP_H
+#define FREERDP_LIB_CORE_RDPUDP_H
+
+#include <freerdp/api.h>
+#include <freerdp/freerdp.h>
+
+#include <winpr/wtypes.h>
+#include <winpr/stream.h>
+
+#include "multitransport.h"
+
+typedef struct rdp_udp_tunnel rdpUdpTunnel;
+
+typedef enum
+{
+	RDPUDP_TUNNEL_STATE_IDLE = 0,
+	RDPUDP_TUNNEL_STATE_SYN_SENT = 1,
+	RDPUDP_TUNNEL_STATE_SECURITY_HANDSHAKE = 2,
+	RDPUDP_TUNNEL_STATE_RDPEMT_CREATE = 3,
+	RDPUDP_TUNNEL_STATE_READY = 4,
+	RDPUDP_TUNNEL_STATE_ACTIVE = 5,
+	RDPUDP_TUNNEL_STATE_FAILED = 6,
+	RDPUDP_TUNNEL_STATE_CLOSED = 7
+} rdpUdpTunnelState;
+
+typedef struct
+{
+	UINT32 kind;
+	UINT32 state;
+	UINT32 negotiatedVersion;
+	UINT64 bytesReceived;
+	UINT64 bytesSent;
+	UINT64 packetsReceived;
+	UINT64 packetsSent;
+	UINT64 retransmits;
+	UINT64 fecRecovered;
+	UINT64 droppedPackets;
+	UINT64 srttMicros;
+	UINT64 idleMillis;
+} rdpUdpTunnelSnapshot;
+
+enum
+{
+	RDPUDP_CLIENT_FAILURE_NONE = 0,
+	RDPUDP_CLIENT_FAILURE_UNSUPPORTED_PROTOCOL = 1,
+	RDPUDP_CLIENT_FAILURE_INVALID_ENDPOINT = 2,
+	RDPUDP_CLIENT_FAILURE_SOCKET_CONNECT = 3,
+	RDPUDP_CLIENT_FAILURE_SYN_SEND = 4,
+	RDPUDP_CLIENT_FAILURE_SYN_TIMEOUT = 5,
+	RDPUDP_CLIENT_FAILURE_SYN_RECV = 6,
+	RDPUDP_CLIENT_FAILURE_SYN_PARSE = 7,
+	RDPUDP_CLIENT_FAILURE_RESOURCE = 8,
+	RDPUDP_CLIENT_FAILURE_FINAL_ACK = 9,
+	RDPUDP_CLIENT_FAILURE_UNSUPPORTED_VERSION = 10,
+	RDPUDP_CLIENT_FAILURE_TLS_HANDSHAKE = 11,
+	RDPUDP_CLIENT_FAILURE_TUNNEL_REQUEST = 12,
+	RDPUDP_CLIENT_FAILURE_TUNNEL_RESPONSE = 13,
+	RDPUDP_CLIENT_FAILURE_TUNNEL_HR = 14,
+	RDPUDP_CLIENT_FAILURE_TRANSPORT_TIMEOUT = 15
+};
+
+typedef struct
+{
+	BOOL socketOpened;
+	BOOL synAckReceived;
+	BOOL tlsHandshakeSucceeded;
+	BOOL tunnelCreateSucceeded;
+	BOOL lossy;
+	UINT16 requestedProtocol;
+	UINT16 negotiatedVersion;
+	UINT32 initialSequence;
+	UINT32 serverInitialSequence;
+	UINT64 packetsSent;
+	UINT64 packetsReceived;
+	UINT64 bytesSent;
+	UINT64 bytesReceived;
+	UINT64 retransmits;
+	UINT64 fecRecovered;
+	UINT64 droppedPackets;
+	UINT64 srttMicros;
+	UINT32 failureStage;
+	HRESULT tunnelHr;
+	int lastSocketError;
+} rdpUdpClientBootstrapResult;
+
+WINPR_ATTR_NODISCARD
+FREERDP_LOCAL rdpUdpTunnel* rdpudp_tunnel_begin(rdpRdp* rdp, UINT32 requestId,
+                                                UINT16 requestedProtocol,
+                                                const BYTE cookie[RDPUDP_COOKIE_LEN]);
+
+WINPR_ATTR_NODISCARD
+FREERDP_LOCAL BOOL rdpudp_tunnel_poll(rdpUdpTunnel* tunnel);
+
+WINPR_ATTR_NODISCARD
+FREERDP_LOCAL HANDLE rdpudp_tunnel_get_event(const rdpUdpTunnel* tunnel);
+
+WINPR_ATTR_NODISCARD
+FREERDP_LOCAL rdpUdpTunnelState rdpudp_tunnel_get_state(const rdpUdpTunnel* tunnel);
+
+WINPR_ATTR_NODISCARD
+FREERDP_LOCAL BOOL rdpudp_tunnel_pop_data(rdpUdpTunnel* tunnel, BYTE* data, size_t capacity,
+                                          size_t* length);
+
+FREERDP_LOCAL void rdpudp_tunnel_set_active(rdpUdpTunnel* tunnel);
+
+FREERDP_LOCAL void rdpudp_tunnel_snapshot(const rdpUdpTunnel* tunnel,
+                                          rdpUdpTunnelSnapshot* snapshot);
+
+/* Deterministic wire-codec entry points used by the native protocol tests and fuzz harnesses. */
+FREERDP_API BOOL rdpudp_test_write_syn(wStream* s, UINT16 requestedProtocol,
+                                       const BYTE cookie[RDPUDP_COOKIE_LEN],
+                                       UINT32* initialSequence);
+FREERDP_API BOOL rdpudp_test_parse_syn_ack(const BYTE* data, size_t length,
+                                           UINT32 initialSequence,
+                                           rdpUdpClientBootstrapResult* result);
+FREERDP_API UINT16 rdpudp_test_sequence16_distance(UINT16 from, UINT16 to);
+FREERDP_API UINT32 rdpudp_test_sequence32_distance(UINT32 from, UINT32 to);
+FREERDP_API BOOL rdpudp_test_write_create_request(wStream* s, UINT32 requestId,
+                                                  const BYTE cookie[RDPUDP_COOKIE_LEN]);
+
+WINPR_ATTR_NODISCARD
+FREERDP_LOCAL BOOL rdpudp_client_bootstrap(rdpRdp* rdp, UINT32 requestId, UINT16 requestedProtocol,
+                                           const BYTE cookie[RDPUDP_COOKIE_LEN],
+                                           rdpUdpClientBootstrapResult* result);
+
+WINPR_ATTR_NODISCARD
+FREERDP_LOCAL BOOL rdpudp_client_probe_tunnel(rdpRdp* rdp, UINT32 requestId,
+                                              UINT16 requestedProtocol,
+                                              const BYTE cookie[RDPUDP_COOKIE_LEN],
+                                              rdpUdpClientBootstrapResult* result);
+
+WINPR_ATTR_NODISCARD
+FREERDP_LOCAL rdpUdpTunnel* rdpudp_client_open_tunnel(rdpRdp* rdp, UINT32 requestId,
+                                                      UINT16 requestedProtocol,
+                                                      const BYTE cookie[RDPUDP_COOKIE_LEN],
+                                                      rdpUdpClientBootstrapResult* result);
+
+FREERDP_LOCAL void rdpudp_tunnel_set_interactive(rdpUdpTunnel* tunnel, BOOL interactive);
+
+WINPR_ATTR_NODISCARD
+FREERDP_LOCAL BOOL rdpudp_tunnel_write_data(rdpUdpTunnel* tunnel, const BYTE* data, size_t length);
+
+WINPR_ATTR_NODISCARD
+FREERDP_LOCAL int rdpudp_tunnel_read_data(rdpUdpTunnel* tunnel, BYTE* data, size_t length,
+                                          int timeoutMs);
+
+FREERDP_LOCAL void rdpudp_tunnel_abort(rdpUdpTunnel* tunnel);
+
+FREERDP_LOCAL const rdpUdpClientBootstrapResult* rdpudp_tunnel_stats(const rdpUdpTunnel* tunnel);
+
+FREERDP_LOCAL void rdpudp_tunnel_free(rdpUdpTunnel* tunnel);
+
+#endif /* FREERDP_LIB_CORE_RDPUDP_H */
diff --git a/libfreerdp/core/rdpudp_async.inc b/libfreerdp/core/rdpudp_async.inc
new file mode 100644
index 00000000..91df7a9d
--- /dev/null
+++ b/libfreerdp/core/rdpudp_async.inc
@@ -0,0 +1,432 @@
+/* Main-loop-owned asynchronous RDP-UDP/RDPEMT state machine. Included by rdpudp.c after the
+ * wire codec, BIO adapter, TLS helpers and rdpUdpTunnel allocation helpers are defined. */
+
+static void rdpudp_async_fail(rdpUdpTunnel* tunnel, UINT32 stage)
+{
+	WINPR_ASSERT(tunnel);
+	if (tunnel->state == RDPUDP_TUNNEL_STATE_FAILED ||
+	    tunnel->state == RDPUDP_TUNNEL_STATE_CLOSED)
+		return;
+	tunnel->result.failureStage = stage;
+	tunnel->state = RDPUDP_TUNNEL_STATE_FAILED;
+}
+
+static BOOL rdpudp_async_queue(rdpUdpTunnel* tunnel, const BYTE* data, size_t length)
+{
+	if ((!data && length > 0) || length > UINT16_MAX ||
+	    tunnel->rxQueuedFrames >= RDPUDP_MAX_QUEUED_FRAMES ||
+	    length > RDPUDP_MAX_QUEUED_BYTES - tunnel->rxQueuedBytes)
+	{
+		tunnel->result.droppedPackets++;
+		return FALSE;
+	}
+	rdpUdpFrame* frame = (rdpUdpFrame*)malloc(sizeof(*frame) + length);
+	if (!frame)
+		return FALSE;
+	frame->next = nullptr;
+	frame->length = length;
+	if (length > 0)
+		memcpy(frame->data, data, length);
+	if (tunnel->rxTail)
+		tunnel->rxTail->next = frame;
+	else
+		tunnel->rxHead = frame;
+	tunnel->rxTail = frame;
+	tunnel->rxQueuedBytes += length;
+	tunnel->rxQueuedFrames++;
+	return TRUE;
+}
+
+static BOOL rdpudp_async_consume_wire(rdpUdpTunnel* tunnel)
+{
+	size_t offset = 0;
+	while (tunnel->wireLength - offset >= RDPTUNNEL_HEADER_LENGTH)
+	{
+		const BYTE* header = tunnel->wireBuffer + offset;
+		const UINT8 low = header[0] & 0x0Fu;
+		const UINT8 high = (header[0] >> 4u) & 0x0Fu;
+		const UINT8 action = low != 0 ? low : high;
+		const UINT16 payloadLength = (UINT16)(header[1] | ((UINT16)header[2] << 8u));
+		const UINT8 headerLength = header[3];
+		if (headerLength < RDPTUNNEL_HEADER_LENGTH)
+			return FALSE;
+		const size_t frameLength = (size_t)headerLength + payloadLength;
+		if (frameLength > RDPUDP_MAX_RDPEMT_FRAME)
+			return FALSE;
+		if (tunnel->wireLength - offset < frameLength)
+			break;
+		const BYTE* payload = header + headerLength;
+		if (tunnel->state == RDPUDP_TUNNEL_STATE_RDPEMT_CREATE)
+		{
+			if (action != RDPTUNNEL_ACTION_CREATERESPONSE ||
+			    payloadLength < RDPTUNNEL_CREATE_RESPONSE_PAYLOAD_LENGTH)
+				return FALSE;
+			wStream buffer = WINPR_C_ARRAY_INIT;
+			wStream* s = Stream_StaticInit(&buffer, (BYTE*)payload, payloadLength);
+			HRESULT hr = E_ABORT;
+			Stream_Read_INT32(s, hr);
+			tunnel->result.tunnelHr = hr;
+			tunnel->result.tunnelCreateSucceeded = hr == 0;
+			if (hr != 0)
+			{
+				tunnel->result.failureStage = RDPUDP_CLIENT_FAILURE_TUNNEL_HR;
+				return FALSE;
+			}
+			tunnel->result.failureStage = RDPUDP_CLIENT_FAILURE_NONE;
+			tunnel->state = RDPUDP_TUNNEL_STATE_READY;
+			tunnel->stateStartedMs = GetTickCount64();
+		}
+		else if (action == RDPTUNNEL_ACTION_DATA)
+		{
+			if (!rdpudp_async_queue(tunnel, payload, payloadLength))
+				return FALSE;
+		}
+		else
+			return FALSE;
+		offset += frameLength;
+	}
+	if (offset > 0)
+	{
+		const size_t remaining = tunnel->wireLength - offset;
+		if (remaining > 0)
+			memmove(tunnel->wireBuffer, tunnel->wireBuffer + offset, remaining);
+		tunnel->wireLength = remaining;
+	}
+	return TRUE;
+}
+
+static BOOL rdpudp_async_read_plaintext(rdpUdpTunnel* tunnel)
+{
+	for (;;)
+	{
+		if (tunnel->wireCapacity - tunnel->wireLength < 4096)
+		{
+			size_t capacity = tunnel->wireCapacity ? tunnel->wireCapacity * 2 : 8192;
+			if (capacity > RDPUDP_MAX_RDPEMT_FRAME || capacity <= tunnel->wireCapacity)
+				capacity = RDPUDP_MAX_RDPEMT_FRAME;
+			if (capacity - tunnel->wireLength < 4096)
+				return FALSE;
+			BYTE* replacement = (BYTE*)realloc(tunnel->wireBuffer, capacity);
+			if (!replacement)
+				return FALSE;
+			tunnel->wireBuffer = replacement;
+			tunnel->wireCapacity = capacity;
+		}
+		const int rc = BIO_read(tunnel->tls->bio, tunnel->wireBuffer + tunnel->wireLength,
+		                        WINPR_ASSERTING_INT_CAST(int,
+		                                                   tunnel->wireCapacity - tunnel->wireLength));
+		if (rc > 0)
+		{
+			tunnel->wireLength += (size_t)rc;
+			if (!rdpudp_async_consume_wire(tunnel))
+				return FALSE;
+			continue;
+		}
+		if (BIO_should_retry(tunnel->tls->bio))
+			return TRUE;
+		return rc == 0;
+	}
+}
+
+rdpUdpTunnel* rdpudp_tunnel_begin(rdpRdp* rdp, UINT32 requestId, UINT16 requestedProtocol,
+                                  const BYTE cookie[RDPUDP_COOKIE_LEN])
+{
+	if (!rdp || !rdp->settings || !cookie)
+		return nullptr;
+	rdpUdpTunnel* tunnel = (rdpUdpTunnel*)calloc(1, sizeof(*tunnel));
+	rdpUdpConnection* connection = (rdpUdpConnection*)calloc(1, sizeof(*connection));
+	if (!tunnel || !connection)
+	{
+		free(tunnel);
+		free(connection);
+		return nullptr;
+	}
+	tunnel->connection = connection;
+	tunnel->requestId = requestId;
+	tunnel->requestedProtocol = requestedProtocol;
+	memcpy(tunnel->cookie, cookie, sizeof(tunnel->cookie));
+	tunnel->result.requestedProtocol = requestedProtocol;
+	tunnel->result.lossy = requestedProtocol == INITIATE_REQUEST_PROTOCOL_UDPFECL;
+	InitializeCriticalSection(&tunnel->lock);
+	tunnel->lockInitialized = TRUE;
+	connection->rdp = rdp;
+	connection->sock = INVALID_SOCKET;
+	connection->requestedProtocol = requestedProtocol;
+	connection->lossy = tunnel->result.lossy;
+	connection->readTimeoutMs = 0;
+	connection->recvTimeoutMs = 0;
+	connection->result = &tunnel->result;
+	if (requestedProtocol != INITIATE_REQUEST_PROTOCOL_UDPFECR &&
+	    requestedProtocol != INITIATE_REQUEST_PROTOCOL_UDPFECL)
+	{
+		rdpudp_async_fail(tunnel, RDPUDP_CLIENT_FAILURE_UNSUPPORTED_PROTOCOL);
+		return tunnel;
+	}
+
+	const char* hostname = freerdp_settings_get_string(rdp->settings, FreeRDP_ServerHostname);
+	const UINT32 port = freerdp_settings_get_uint32(rdp->settings, FreeRDP_ServerPort);
+	if (!hostname || port == 0 || port > UINT16_MAX)
+	{
+		rdpudp_async_fail(tunnel, RDPUDP_CLIENT_FAILURE_INVALID_ENDPOINT);
+		return tunnel;
+	}
+	wStream* syn = Stream_New(nullptr, RDPUDP_DEFAULT_MTU);
+	if (!syn || !rdpudp_write_syn(syn, requestedProtocol, cookie, &tunnel->result.initialSequence))
+	{
+		Stream_Free(syn, TRUE);
+		rdpudp_async_fail(tunnel, RDPUDP_CLIENT_FAILURE_RESOURCE);
+		return tunnel;
+	}
+	tunnel->synPacketLength = Stream_GetPosition(syn);
+	memcpy(tunnel->synPacket, Stream_Buffer(syn), tunnel->synPacketLength);
+	Stream_Free(syn, TRUE);
+	connection->sock = rdpudp_connect_socket(rdp, &tunnel->result.lastSocketError);
+	if (connection->sock == INVALID_SOCKET)
+	{
+		rdpudp_async_fail(tunnel, RDPUDP_CLIENT_FAILURE_SOCKET_CONNECT);
+		return tunnel;
+	}
+	tunnel->result.socketOpened = TRUE;
+	tunnel->socketEvent = WSACreateEvent();
+	if (!tunnel->socketEvent ||
+	    WSAEventSelect(connection->sock, tunnel->socketEvent, FD_READ | FD_CLOSE) != 0)
+	{
+		tunnel->result.lastSocketError = WSAGetLastError();
+		rdpudp_async_fail(tunnel, RDPUDP_CLIENT_FAILURE_SOCKET_CONNECT);
+		return tunnel;
+	}
+	const int sent = _send(connection->sock, (const char*)tunnel->synPacket,
+	                       WINPR_ASSERTING_INT_CAST(int, tunnel->synPacketLength), 0);
+	if (sent != WINPR_ASSERTING_INT_CAST(int, tunnel->synPacketLength))
+	{
+		tunnel->result.lastSocketError = rdpudp_socket_error();
+		rdpudp_async_fail(tunnel, RDPUDP_CLIENT_FAILURE_SYN_SEND);
+		return tunnel;
+	}
+	tunnel->result.bytesSent += (UINT32)sent;
+	tunnel->result.packetsSent++;
+	tunnel->synAttempts = 1;
+	tunnel->lastSynMs = tunnel->stateStartedMs = GetTickCount64();
+	tunnel->state = RDPUDP_TUNNEL_STATE_SYN_SENT;
+	return tunnel;
+}
+
+static BOOL rdpudp_async_start_security(rdpUdpTunnel* tunnel)
+{
+	rdpUdpConnection* connection = tunnel->connection;
+	connection->negotiatedVersion = tunnel->result.negotiatedVersion;
+	connection->sendSequence = tunnel->result.initialSequence + 1u;
+	connection->codedSequence = tunnel->result.initialSequence + 1u;
+	connection->recvSequence = tunnel->result.serverInitialSequence;
+	connection->recvReadSequence = tunnel->result.serverInitialSequence;
+	connection->recvAckHigh = tunnel->result.serverInitialSequence;
+	connection->mtu = RDPUDP_DEFAULT_MTU - 64;
+	connection->lastReceiveMs = GetTickCount64();
+	if (!rdpudp_send_connection_ack(connection))
+		return FALSE;
+	tunnel->tls = freerdp_tls_new(connection->rdp->context);
+	tunnel->pendingBio = rdpudp_connection_new_bio(connection, connection->lossy);
+	if (!tunnel->tls || !tunnel->pendingBio)
+		return FALSE;
+
+	rdpSettings* settings = connection->rdp->settings;
+	const UINT16 oldMin = freerdp_settings_get_uint16(settings, FreeRDP_TLSMinVersion);
+	const UINT16 oldMax = freerdp_settings_get_uint16(settings, FreeRDP_TLSMaxVersion);
+	if (connection->lossy)
+	{
+#ifdef DTLS1_2_VERSION
+		(void)freerdp_settings_set_uint16(settings, FreeRDP_TLSMinVersion, DTLS1_2_VERSION);
+#else
+		(void)freerdp_settings_set_uint16(settings, FreeRDP_TLSMinVersion, 0);
+#endif
+		(void)freerdp_settings_set_uint16(settings, FreeRDP_TLSMaxVersion, 0);
+	}
+	const SSL_METHOD* method = freerdp_tls_get_ssl_method(connection->lossy, TRUE);
+	const TlsHandshakeResult rc = freerdp_tls_connect_ex(tunnel->tls, tunnel->pendingBio, method);
+	tunnel->pendingBio = nullptr; /* freerdp_tls_connect_ex owns the BIO after prepare */
+	if (connection->lossy)
+	{
+		(void)freerdp_settings_set_uint16(settings, FreeRDP_TLSMinVersion, oldMin);
+		(void)freerdp_settings_set_uint16(settings, FreeRDP_TLSMaxVersion, oldMax);
+	}
+	if (rc != TLS_HANDSHAKE_SUCCESS && rc != TLS_HANDSHAKE_CONTINUE)
+		return FALSE;
+	tunnel->state = RDPUDP_TUNNEL_STATE_SECURITY_HANDSHAKE;
+	tunnel->stateStartedMs = GetTickCount64();
+	if (rc == TLS_HANDSHAKE_SUCCESS)
+	{
+		tunnel->result.tlsHandshakeSucceeded = TRUE;
+		if (!rdpemt_send_create_request(tunnel->tls, tunnel->requestId, tunnel->cookie))
+			return FALSE;
+		tunnel->state = RDPUDP_TUNNEL_STATE_RDPEMT_CREATE;
+	}
+	return TRUE;
+}
+
+BOOL rdpudp_tunnel_poll(rdpUdpTunnel* tunnel)
+{
+	if (!tunnel || tunnel->aborted || tunnel->state == RDPUDP_TUNNEL_STATE_FAILED ||
+	    tunnel->state == RDPUDP_TUNNEL_STATE_CLOSED)
+		return FALSE;
+	const UINT64 now = GetTickCount64();
+	if (tunnel->state != RDPUDP_TUNNEL_STATE_READY &&
+	    tunnel->state != RDPUDP_TUNNEL_STATE_ACTIVE &&
+	    now - tunnel->stateStartedMs >= RDPUDP_ASYNC_HANDSHAKE_TIMEOUT_MS)
+	{
+		rdpudp_async_fail(tunnel, tunnel->state == RDPUDP_TUNNEL_STATE_SYN_SENT
+		                                ? RDPUDP_CLIENT_FAILURE_SYN_TIMEOUT
+		                                : RDPUDP_CLIENT_FAILURE_TUNNEL_RESPONSE);
+		return FALSE;
+	}
+	if (tunnel->state == RDPUDP_TUNNEL_STATE_SYN_SENT)
+	{
+		BYTE packet[RDPUDP_RECV_BUFFER_SIZE] = { 0 };
+		const int received = _recv(tunnel->connection->sock, (char*)packet, sizeof(packet), 0);
+		if (received > 0)
+		{
+			tunnel->result.bytesReceived += (UINT32)received;
+			tunnel->result.packetsReceived++;
+			if (rdpudp_parse_syn_ack(packet, (size_t)received, tunnel->result.initialSequence,
+			                         &tunnel->result))
+			{
+				if (!rdpudp_async_start_security(tunnel))
+					rdpudp_async_fail(tunnel, RDPUDP_CLIENT_FAILURE_TLS_HANDSHAKE);
+				return tunnel->state != RDPUDP_TUNNEL_STATE_FAILED;
+			}
+			tunnel->result.failureStage = RDPUDP_CLIENT_FAILURE_SYN_PARSE;
+		}
+		else if (received < 0)
+		{
+			const int error = WSAGetLastError();
+			if (error != WSAEWOULDBLOCK && error != WSAEINPROGRESS)
+			{
+				tunnel->result.lastSocketError = error;
+				rdpudp_async_fail(tunnel, RDPUDP_CLIENT_FAILURE_SYN_RECV);
+				return FALSE;
+			}
+		}
+		if (now - tunnel->lastSynMs >= RDPUDP_SYN_TIMEOUT_MS)
+		{
+			if (tunnel->synAttempts >= RDPUDP_SYN_SEND_ATTEMPTS)
+			{
+				rdpudp_async_fail(tunnel, RDPUDP_CLIENT_FAILURE_SYN_TIMEOUT);
+				return FALSE;
+			}
+			const int sent = _send(tunnel->connection->sock, (const char*)tunnel->synPacket,
+			                       WINPR_ASSERTING_INT_CAST(int, tunnel->synPacketLength), 0);
+			if (sent <= 0)
+			{
+				tunnel->result.lastSocketError = rdpudp_socket_error();
+				rdpudp_async_fail(tunnel, RDPUDP_CLIENT_FAILURE_SYN_SEND);
+				return FALSE;
+			}
+			tunnel->result.bytesSent += (UINT32)sent;
+			tunnel->result.packetsSent++;
+			tunnel->result.retransmits++;
+			tunnel->synAttempts++;
+			tunnel->lastSynMs = now;
+		}
+		return TRUE;
+	}
+	if (tunnel->state == RDPUDP_TUNNEL_STATE_SECURITY_HANDSHAKE)
+	{
+		const TlsHandshakeResult rc = freerdp_tls_handshake(tunnel->tls);
+		if (rc != TLS_HANDSHAKE_SUCCESS && rc != TLS_HANDSHAKE_CONTINUE)
+		{
+			rdpudp_async_fail(tunnel, RDPUDP_CLIENT_FAILURE_TLS_HANDSHAKE);
+			return FALSE;
+		}
+		if (rc == TLS_HANDSHAKE_SUCCESS)
+		{
+			tunnel->result.tlsHandshakeSucceeded = TRUE;
+			if (!rdpemt_send_create_request(tunnel->tls, tunnel->requestId, tunnel->cookie))
+			{
+				rdpudp_async_fail(tunnel, RDPUDP_CLIENT_FAILURE_TUNNEL_REQUEST);
+				return FALSE;
+			}
+			tunnel->state = RDPUDP_TUNNEL_STATE_RDPEMT_CREATE;
+			tunnel->stateStartedMs = now;
+		}
+		return TRUE;
+	}
+	if (!rdpudp_async_read_plaintext(tunnel))
+	{
+		rdpudp_async_fail(tunnel, tunnel->state == RDPUDP_TUNNEL_STATE_RDPEMT_CREATE
+		                                ? RDPUDP_CLIENT_FAILURE_TUNNEL_RESPONSE
+		                                : RDPUDP_CLIENT_FAILURE_SYN_RECV);
+		return FALSE;
+	}
+	BOOL maintenanceOk = TRUE;
+	if (tunnel->connection->negotiatedVersion == RDPUDP_PROTOCOL_VERSION_1 ||
+	    tunnel->connection->negotiatedVersion == RDPUDP_PROTOCOL_VERSION_2)
+		maintenanceOk = rdpudp1_maintenance(tunnel->connection);
+	else if (tunnel->connection->negotiatedVersion == RDPUDP_PROTOCOL_VERSION_3)
+		maintenanceOk = rdpudp2_maintenance(tunnel->connection);
+	if (!maintenanceOk)
+	{
+		rdpudp_async_fail(tunnel, RDPUDP_CLIENT_FAILURE_TRANSPORT_TIMEOUT);
+		return FALSE;
+	}
+	return TRUE;
+}
+
+HANDLE rdpudp_tunnel_get_event(const rdpUdpTunnel* tunnel)
+{
+	return tunnel ? tunnel->socketEvent : nullptr;
+}
+
+rdpUdpTunnelState rdpudp_tunnel_get_state(const rdpUdpTunnel* tunnel)
+{
+	return tunnel ? tunnel->state : RDPUDP_TUNNEL_STATE_CLOSED;
+}
+
+BOOL rdpudp_tunnel_pop_data(rdpUdpTunnel* tunnel, BYTE* data, size_t capacity, size_t* length)
+{
+	if (length)
+		*length = 0;
+	if (!tunnel || !data || !length || !tunnel->rxHead)
+		return FALSE;
+	rdpUdpFrame* frame = tunnel->rxHead;
+	if (frame->length > capacity)
+		return FALSE;
+	tunnel->rxHead = frame->next;
+	if (!tunnel->rxHead)
+		tunnel->rxTail = nullptr;
+	memcpy(data, frame->data, frame->length);
+	*length = frame->length;
+	tunnel->rxQueuedBytes -= frame->length;
+	tunnel->rxQueuedFrames--;
+	free(frame);
+	return TRUE;
+}
+
+void rdpudp_tunnel_set_active(rdpUdpTunnel* tunnel)
+{
+	if (tunnel && tunnel->state == RDPUDP_TUNNEL_STATE_READY)
+		tunnel->state = RDPUDP_TUNNEL_STATE_ACTIVE;
+}
+
+void rdpudp_tunnel_snapshot(const rdpUdpTunnel* tunnel, rdpUdpTunnelSnapshot* snapshot)
+{
+	if (!snapshot)
+		return;
+	ZeroMemory(snapshot, sizeof(*snapshot));
+	if (!tunnel)
+		return;
+	snapshot->kind = tunnel->result.requestedProtocol == INITIATE_REQUEST_PROTOCOL_UDPFECL
+	                     ? 2u
+	                     : (tunnel->result.negotiatedVersion == RDPUDP_PROTOCOL_VERSION_3 ? 4u
+	                                                                                       : 1u);
+	snapshot->state = tunnel->state;
+	snapshot->negotiatedVersion = tunnel->result.negotiatedVersion;
+	snapshot->bytesReceived = tunnel->result.bytesReceived;
+	snapshot->bytesSent = tunnel->result.bytesSent;
+	snapshot->packetsReceived = tunnel->result.packetsReceived;
+	snapshot->packetsSent = tunnel->result.packetsSent;
+	snapshot->retransmits = tunnel->result.retransmits;
+	snapshot->fecRecovered = tunnel->result.fecRecovered;
+	snapshot->droppedPackets = tunnel->result.droppedPackets;
+	snapshot->srttMicros = tunnel->result.srttMicros;
+	if (tunnel->connection && tunnel->connection->lastReceiveMs > 0)
+		snapshot->idleMillis = GetTickCount64() - tunnel->connection->lastReceiveMs;
+}
