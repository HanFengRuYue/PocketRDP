+static int android_verify_x509_certificate(freerdp* instance, const BYTE* data, size_t length,
+                                           const char* hostname, UINT16 port, DWORD flags)
+{
+	if (!instance || !data || length == 0 || length > ANDROID_X509_MAX_PEM_BYTES)
