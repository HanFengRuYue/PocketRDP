+	UINT32 requestId;
+	BYTE cookie[RDPUDP_COOKIE_LEN];
+	BYTE synPacket[RDPUDP_DEFAULT_MTU];
+	size_t synPacketLength;
+	UINT32 synAttempts;
+	UINT64 stateStartedMs;
+	UINT64 lastSynMs;
+	HANDLE socketEvent;
+	BIO* pendingBio;
+	BYTE* wireBuffer;
+	size_t wireLength;
+	size_t wireCapacity;
+	rdpUdpFrame* rxHead;
+	rdpUdpFrame* rxTail;
+	size_t rxQueuedBytes;
+	size_t rxQueuedFrames;
+};
