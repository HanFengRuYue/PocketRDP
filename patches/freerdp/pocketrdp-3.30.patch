+static UINT drdynvc_tunnel_static_channel(DrdynvcClientContext* context, const char* channelName,
+                                          const BYTE* data, UINT32 dataLength, BOOL* routed)
+{
+	if (routed)
+		*routed = FALSE;
+	if (!context || !context->handle || !channelName || !data || dataLength == 0 || !routed)
+		return ERROR_INVALID_PARAMETER;
+
+	drdynvcPlugin* drdynvc = (drdynvcPlugin*)context->handle;
+	DVCMAN* dvcman = (DVCMAN*)drdynvc->channel_mgr;
+	if (!dvcman || !dvcman->staticTunnelsByName)
+		return CHANNEL_RC_OK;
+
+	HashTable_Lock(dvcman->staticTunnelsByName);
+	DVCMAN_CHANNEL* channel =
+	    (DVCMAN_CHANNEL*)HashTable_GetItemValue(dvcman->staticTunnelsByName, channelName);
+	if (channel && channel->state == DVC_CHANNEL_RUNNING)
+		InterlockedIncrement(&channel->refCounter);
+	else
+		channel = nullptr;
+	HashTable_Unlock(dvcman->staticTunnelsByName);
+	if (!channel)
+		return CHANNEL_RC_OK;
+
+	*routed = TRUE;
+	const UINT status = channel->iface.Write(&channel->iface, dataLength, data, nullptr);
+	dvcman_channel_unref(channel);
+	return status;
+}
