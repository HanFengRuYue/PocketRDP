+ */
+
+#include <stdint.h>
+#include <string.h>
+
+#include "../rdpudp.h"
+
+int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size)
+{
+	if (!data)
+		return 0;
+	rdpUdpClientBootstrapResult result = WINPR_C_ARRAY_INIT;
+	UINT32 expectedSequence = 0;
+	if (size >= sizeof(expectedSequence))
+		memcpy(&expectedSequence, data, sizeof(expectedSequence));
+	(void)rdpudp_test_parse_syn_ack(data, size, expectedSequence, &result);
+	return 0;
+}
diff --git a/libfreerdp/core/test/TestRdpUdp.c b/libfreerdp/core/test/TestRdpUdp.c
new file mode 100644
index 00000000..125828d2
--- /dev/null
+++ b/libfreerdp/core/test/TestRdpUdp.c
@@ -0,0 +1,80 @@
+/**
+ * FreeRDP: A Remote Desktop Protocol Implementation
+ * Deterministic RDP-UDP/RDPEMT wire-codec tests
+ *
+ * Licensed under the Apache License, Version 2.0
+ */
+
+#include <string.h>
+
+#include <winpr/crt.h>
+#include <winpr/stream.h>
+
+#include "../rdpudp.h"
+
+static BOOL test_sequence_wrap(void)
+{
+	return (rdpudp_test_sequence16_distance(0xFFFEu, 1u) == 3u) &&
+	       (rdpudp_test_sequence32_distance(0xFFFFFFFEu, 1u) == 3u);
+}
+
+static BOOL test_syn_and_syn_ack(void)
+{
+	BYTE cookie[RDPUDP_COOKIE_LEN] = { 0 };
+	for (size_t x = 0; x < ARRAYSIZE(cookie); x++)
+		cookie[x] = (BYTE)x;
+	wStream* syn = Stream_New(nullptr, 1232);
+	if (!syn)
+		return FALSE;
+	UINT32 sequence = 0;
+	BOOL ok = rdpudp_test_write_syn(syn, INITIATE_REQUEST_PROTOCOL_UDPFECR, cookie, &sequence) &&
+	          Stream_GetPosition(syn) == 1232;
+	Stream_Free(syn, TRUE);
+	if (!ok)
+		return FALSE;
+
+	BYTE ack[20] = { 0 };
+	wStream sbuffer = WINPR_C_ARRAY_INIT;
+	wStream* s = Stream_StaticInit(&sbuffer, ack, sizeof(ack));
+	Stream_Write_UINT32_BE(s, sequence);
+	Stream_Write_UINT16_BE(s, 1024);
+	Stream_Write_UINT16_BE(s, 0x1005); /* SYN | ACK | SYNEX */
+	Stream_Write_UINT32_BE(s, 0xAABBCCDDu);
+	Stream_Write_UINT16_BE(s, 1232);
+	Stream_Write_UINT16_BE(s, 1132);
+	Stream_Write_UINT16_BE(s, 1);      /* VERSION_INFO_VALID */
+	Stream_Write_UINT16_BE(s, 0x0101); /* UDP2 v3 */
+
+	rdpUdpClientBootstrapResult result = WINPR_C_ARRAY_INIT;
+	ok = rdpudp_test_parse_syn_ack(ack, sizeof(ack), sequence, &result) &&
+	     result.synAckReceived && result.serverInitialSequence == 0xAABBCCDDu &&
+	     result.negotiatedVersion == 0x0101;
+	if (rdpudp_test_parse_syn_ack(ack, sizeof(ack) - 5, sequence, &result))
+		ok = FALSE;
+	ack[13] = 0; /* invalid upstream MTU */
+	if (rdpudp_test_parse_syn_ack(ack, sizeof(ack), sequence, &result))
+		ok = FALSE;
+	return ok;
+}
+
+static BOOL test_rdpemt_create_request(void)
+{
+	BYTE cookie[RDPUDP_COOKIE_LEN] = { 0 };
+	for (size_t x = 0; x < ARRAYSIZE(cookie); x++)
+		cookie[x] = (BYTE)(0xF0u + x);
+	BYTE buffer[28] = { 0 };
+	wStream sbuffer = WINPR_C_ARRAY_INIT;
+	wStream* s = Stream_StaticInit(&sbuffer, buffer, sizeof(buffer));
+	if (!rdpudp_test_write_create_request(s, 0x11223344u, cookie) ||
+	    Stream_GetPosition(s) != sizeof(buffer))
+		return FALSE;
+	const BYTE prefix[] = { 0x00, 0x18, 0x00, 0x04, 0x44, 0x33, 0x22, 0x11,
+	                        0x00, 0x00, 0x00, 0x00 };
+	return memcmp(buffer, prefix, sizeof(prefix)) == 0 &&
+	       memcmp(buffer + sizeof(prefix), cookie, sizeof(cookie)) == 0;
+}
+
+int TestRdpUdp(WINPR_ATTR_UNUSED int argc, WINPR_ATTR_UNUSED char* argv[])
+{
+	return test_sequence_wrap() && test_syn_and_syn_ack() && test_rdpemt_create_request() ? 0 : -1;
+}
