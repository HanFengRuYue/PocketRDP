+static int rdpudp_socket_error(void)
+{
+#if defined(_WIN32)
+	return WSAGetLastError();
+#else
+	return errno;
+#endif
+}
+
+static BOOL rdpudp_sha256_cookie(const BYTE cookie[RDPUDP_COOKIE_LEN],
+                                 BYTE hash[WINPR_SHA256_DIGEST_LENGTH])
+{
+	return winpr_Digest(WINPR_MD_SHA256, cookie, RDPUDP_COOKIE_LEN, hash,
+	                    WINPR_SHA256_DIGEST_LENGTH);
+}
+
+static BOOL rdpudp_write_syn(wStream* s, UINT16 requestedProtocol,
+                             const BYTE cookie[RDPUDP_COOKIE_LEN], UINT32* initialSequence)
+{
+	WINPR_ASSERT(s);
+	WINPR_ASSERT(cookie);
+	WINPR_ASSERT(initialSequence);
+
+	UINT32 sequence = 0;
+	if (winpr_RAND(&sequence, sizeof(sequence)) < 0)
+		return FALSE;
+
+	const BOOL lossy = requestedProtocol == INITIATE_REQUEST_PROTOCOL_UDPFECL;
+	UINT16 flags = RDPUDP_FLAG_SYN | RDPUDP_FLAG_SYNEX;
+	if (lossy)
+		flags |= RDPUDP_FLAG_SYNLOSSY;
+
+	if (!Stream_EnsureRemainingCapacity(s, RDPUDP_DEFAULT_MTU))
+		return FALSE;
+
+	/* RDP-UDP uses network byte order. */
+	Stream_Write_UINT32_BE(s, 0xFFFFFFFFu);          /* snSourceAck */
+	Stream_Write_UINT16_BE(s, RDPUDP_RECEIVE_WINDOW); /* uReceiveWindowSize */
+	Stream_Write_UINT16_BE(s, flags);                /* uFlags */
+	Stream_Write_UINT32_BE(s, sequence);             /* snInitialSequenceNumber */
+	Stream_Write_UINT16_BE(s, RDPUDP_DEFAULT_MTU);   /* uUpStreamMtu */
+	Stream_Write_UINT16_BE(s, RDPUDP_DEFAULT_MTU);   /* uDownStreamMtu */
+
+	/* SYNEX advertises RDP-UDP v3, which is the UDP2 data-transfer version. */
+	Stream_Write_UINT16_BE(s, RDPUDP_VERSION_INFO_VALID);
+	Stream_Write_UINT16_BE(s, RDPUDP_PROTOCOL_VERSION_3);
+
+	BYTE cookieHash[WINPR_SHA256_DIGEST_LENGTH] = { 0 };
+	if (!rdpudp_sha256_cookie(cookie, cookieHash))
+		return FALSE;
+	Stream_Write(s, cookieHash, sizeof(cookieHash));
+
+	const size_t written = Stream_GetPosition(s);
+	if (written > RDPUDP_DEFAULT_MTU)
+		return FALSE;
+	Stream_Zero(s, RDPUDP_DEFAULT_MTU - written);
+
+	*initialSequence = sequence;
+	return TRUE;
+}
+
+static BOOL rdpudp_wait_readable(SOCKET sock, int timeoutMs)
+{
+	fd_set rfds;
+	FD_ZERO(&rfds);
+	FD_SET(sock, &rfds);
+
+	struct timeval tv;
+	tv.tv_sec = timeoutMs / 1000;
+	tv.tv_usec = (timeoutMs % 1000) * 1000;
+
+	const int rc = select((int)sock + 1, &rfds, nullptr, nullptr, &tv);
+	return rc > 0 && FD_ISSET(sock, &rfds);
+}
+
+static BOOL rdpudp_parse_syn_ack(const BYTE* data, size_t length, UINT32 initialSequence,
+                                 rdpUdpClientBootstrapResult* result)
+{
+	WINPR_ASSERT(data);
+	WINPR_ASSERT(result);
+
+	if (length < 16)
+		return FALSE;
+
+	wStream* s = Stream_New((BYTE*)data, length);
+	if (!s)
+		return FALSE;
+
+	UINT32 sourceAck = 0;
+	UINT16 window = 0;
+	UINT16 flags = 0;
+	UINT32 serverInitialSequence = 0;
+	UINT16 upstreamMtu = 0;
+	UINT16 downstreamMtu = 0;
+	Stream_Read_UINT32_BE(s, sourceAck);
+	Stream_Read_UINT16_BE(s, window);
+	Stream_Read_UINT16_BE(s, flags);
+	Stream_Read_UINT32_BE(s, serverInitialSequence);
+	Stream_Read_UINT16_BE(s, upstreamMtu);
+	Stream_Read_UINT16_BE(s, downstreamMtu);
+
+	const BOOL isSynAck = ((flags & (RDPUDP_FLAG_SYN | RDPUDP_FLAG_ACK)) ==
+	                       (RDPUDP_FLAG_SYN | RDPUDP_FLAG_ACK));
+	const BOOL ackMatches = sourceAck == initialSequence;
+	const BOOL mtuOk = upstreamMtu >= RDPUDP_MIN_MTU && upstreamMtu <= RDPUDP_DEFAULT_MTU &&
+	                   downstreamMtu >= RDPUDP_MIN_MTU && downstreamMtu <= RDPUDP_DEFAULT_MTU;
+
+	if (!isSynAck || !ackMatches || !mtuOk)
+	{
+		Stream_Free(s, FALSE);
+		return FALSE;
+	}
+
+	if ((flags & RDPUDP_FLAG_CORRELATION_ID) != 0)
+	{
+		if (!Stream_SafeSeek(s, 32))
+		{
+			Stream_Free(s, FALSE);
+			return FALSE;
+		}
+	}
+
+	result->negotiatedVersion = RDPUDP_PROTOCOL_VERSION_1;
+	if ((flags & RDPUDP_FLAG_SYNEX) != 0 && Stream_GetRemainingLength(s) >= 4)
+	{
+		UINT16 synExFlags = 0;
+		UINT16 udpVersion = 0;
+		Stream_Read_UINT16_BE(s, synExFlags);
+		Stream_Read_UINT16_BE(s, udpVersion);
+		if ((synExFlags & RDPUDP_VERSION_INFO_VALID) != 0)
+			result->negotiatedVersion = udpVersion;
+	}
+
+	result->synAckReceived = TRUE;
+	result->serverInitialSequence = serverInitialSequence;
+	Stream_Free(s, FALSE);
+	return TRUE;
+}
+
+BOOL rdpudp_test_write_syn(wStream* s, UINT16 requestedProtocol,
+                           const BYTE cookie[RDPUDP_COOKIE_LEN], UINT32* initialSequence)
+{
+	return rdpudp_write_syn(s, requestedProtocol, cookie, initialSequence);
+}
+
+BOOL rdpudp_test_parse_syn_ack(const BYTE* data, size_t length, UINT32 initialSequence,
+                               rdpUdpClientBootstrapResult* result)
+{
+	return rdpudp_parse_syn_ack(data, length, initialSequence, result);
+}
+
+static SOCKET rdpudp_connect_socket(rdpRdp* rdp, int* lastSocketError)
+{
+	WINPR_ASSERT(rdp);
+	WINPR_ASSERT(lastSocketError);
+	SOCKET tcpSocket = INVALID_SOCKET;
+	if (!transport_get_socket(rdp->transport, &tcpSocket))
+	{
+		*lastSocketError = WSAENOTSOCK;
+		return INVALID_SOCKET;
+	}
+
+	struct sockaddr_storage peer = WINPR_C_ARRAY_INIT;
+	socklen_t peerLength = sizeof(peer);
+	if (getpeername((int)tcpSocket, (struct sockaddr*)&peer, &peerLength) != 0 ||
+	    (peer.ss_family != AF_INET && peer.ss_family != AF_INET6))
+	{
+		*lastSocketError = rdpudp_socket_error();
+		return INVALID_SOCKET;
+	}
+
+	SOCKET sock = _socket(peer.ss_family, SOCK_DGRAM, IPPROTO_UDP);
+	if (sock == INVALID_SOCKET)
+	{
+		*lastSocketError = rdpudp_socket_error();
+		return INVALID_SOCKET;
+	}
+	if (_connect(sock, (const struct sockaddr*)&peer, (int)peerLength) != 0)
+	{
+		*lastSocketError = rdpudp_socket_error();
+		closesocket(sock);
+		return INVALID_SOCKET;
+	}
+	return sock;
+}
+
+static void rdpudp_connection_free(rdpUdpConnection* connection)
+{
+	if (!connection)
+		return;
+
+	if (connection->sock != INVALID_SOCKET)
+		closesocket(connection->sock);
+
+	for (size_t x = 0; x < ARRAYSIZE(connection->pending); x++)
+		free(connection->pending[x].payload);
+	for (size_t x = 0; x < ARRAYSIZE(connection->recvSegments); x++)
+		free(connection->recvSegments[x].payload);
+	free(connection->readPayload);
+
+	free(connection);
+}
+
+static BOOL rdpudp2_sequence_lt(UINT16 a, UINT16 b)
+{
+	return (INT16)(a - b) < 0;
+}
+
+static BOOL rdpudp2_sequence_le(UINT16 a, UINT16 b)
+{
+	return (INT16)(a - b) <= 0;
+}
+
+static BOOL rdpudp2_sequence_gt(UINT16 a, UINT16 b)
+{
+	return (INT16)(a - b) > 0;
+}
+
+static UINT16 rdpudp2_sequence_distance(UINT16 from, UINT16 to)
+{
+	return (UINT16)(to - from);
+}
+
+static BOOL rdpudp1_sequence_lt(UINT32 a, UINT32 b)
+{
+	return (INT32)(a - b) < 0;
+}
+
+static BOOL rdpudp1_sequence_le(UINT32 a, UINT32 b)
+{
+	return (INT32)(a - b) <= 0;
+}
+
+static BOOL rdpudp1_sequence_gt(UINT32 a, UINT32 b)
+{
+	return (INT32)(a - b) > 0;
+}
+
+static UINT32 rdpudp1_sequence_distance(UINT32 from, UINT32 to)
+{
+	return to - from;
+}
+
+UINT16 rdpudp_test_sequence16_distance(UINT16 from, UINT16 to)
+{
+	return rdpudp2_sequence_distance(from, to);
+}
+
+UINT32 rdpudp_test_sequence32_distance(UINT32 from, UINT32 to)
+{
+	return rdpudp1_sequence_distance(from, to);
+}
