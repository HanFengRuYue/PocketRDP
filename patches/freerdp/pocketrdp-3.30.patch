+	multi->phase = FREERDP_TRANSPORT_PHASE_TCP;
+	InitializeCriticalSection(&multi->lock);
+	multi->lockInitialized = TRUE;
 	return multi;
 }
 
 void multitransport_free(rdpMultitransport* multitransport)
 {
+	if (!multitransport)
+		return;
+	if (multitransport->pollTimer)
+	{
+		(void)CancelWaitableTimer(multitransport->pollTimer);
+		(void)CloseHandle(multitransport->pollTimer);
+	}
+	rdpudp_tunnel_free(multitransport->reliable.tunnel);
+	rdpudp_tunnel_free(multitransport->lossy.tunnel);
+	if (multitransport->lockInitialized)
+		DeleteCriticalSection(&multitransport->lock);
 	free(multitransport);
 }
