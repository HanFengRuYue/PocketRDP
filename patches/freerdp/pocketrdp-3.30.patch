+	EnterCriticalSection(&multi->lock);
+	multi->pendingRouteCount = 0;
+	size_t usedTunnels = 0;
+	for (size_t listIndex = 0; listIndex < count; listIndex++)
+	{
+		const MultitransportSoftSyncList* list = &lists[listIndex];
+		UINT32 mask = 0;
+		if (list->tunnelType == TUNNELTYPE_UDPFECR)
+			mask = multi->readyMask & (FREERDP_UDP_MASK_RELIABLE | FREERDP_UDP_MASK_UDP2);
+		else if (list->tunnelType == TUNNELTYPE_UDPFECL)
+			mask = multi->readyMask & FREERDP_UDP_MASK_LOSSY;
+		else
+			goto fail;
+
+		if (mask == 0)
+			continue;
+		if (usedTunnels >= acceptedCapacity)
+			goto fail;
+		acceptedTunnelTypes[usedTunnels++] = list->tunnelType;
+		for (size_t idIndex = 0; idIndex < list->channelCount; idIndex++)
+		{
+			const UINT32 channelId = list->channelIds[idIndex];
+			if (multi->pendingRouteCount >= MULTITRANSPORT_MAX_DVC_ROUTES ||
+			    multitransport_route_mask(multi->pendingRoutes, multi->pendingRouteCount, channelId) !=
