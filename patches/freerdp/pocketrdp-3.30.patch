diff --git a/libfreerdp/gdi/gfx.c b/libfreerdp/gdi/gfx.c
index ec94f96e..9e85eef9 100644
--- a/libfreerdp/gdi/gfx.c
+++ b/libfreerdp/gdi/gfx.c
@@ -34,6 +34,47 @@
 #include <math.h>
 
 #define TAG FREERDP_TAG("gdi")
+#define GDI_GFX_MAX_DIMENSION 8192u
+#define GDI_GFX_MAX_PIXELS 16777216ull
+#define GDI_GFX_MAX_SURFACE_BYTES (128ull * 1024ull * 1024ull)
+
+static BOOL gdi_gfx_dimensions_safe(UINT32 width, UINT32 height)
+{
+	return width > 0 && height > 0 && width <= GDI_GFX_MAX_DIMENSION &&
+	       height <= GDI_GFX_MAX_DIMENSION && (UINT64)width * height <= GDI_GFX_MAX_PIXELS;
+}
+
+static BOOL gdi_gfx_surface_budget_allows(RdpgfxClientContext* context, UINT64 requested)
+{
+	WINPR_ASSERT(context);
+	if (requested > GDI_GFX_MAX_SURFACE_BYTES || !context->GetSurfaceIds ||
+	    !context->GetSurfaceData)
+		return FALSE;
+
+	UINT16 count = 0;
+	UINT16* surfaceIds = nullptr;
+	if (context->GetSurfaceIds(context, &surfaceIds, &count) != CHANNEL_RC_OK)
+		return FALSE;
+
+	UINT64 total = requested;
+	for (UINT16 index = 0; index < count; index++)
+	{
+		const gdiGfxSurface* surface =
+		    (const gdiGfxSurface*)context->GetSurfaceData(context, surfaceIds[index]);
+		if (!surface)
+			continue;
+		const UINT64 bytes = (UINT64)surface->scanline * surface->height;
+		if (bytes > GDI_GFX_MAX_SURFACE_BYTES || total > GDI_GFX_MAX_SURFACE_BYTES - bytes)
+		{
+			free(surfaceIds);
+			return FALSE;
+		}
+		total += bytes;
+	}
+
+	free(surfaceIds);
+	return TRUE;
+}
 
