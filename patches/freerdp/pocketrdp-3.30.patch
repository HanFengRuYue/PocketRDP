+			    (rdpMultitransportRoute){ .channelId = channelId, .tunnelMask = mask };
+		}
+	}
+	multi->softSyncResponsePending = TRUE;
+	*acceptedCount = usedTunnels;
+	LeaveCriticalSection(&multi->lock);
