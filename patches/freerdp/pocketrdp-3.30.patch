+	rdpCertificate* cert = freerdp_certificate_new_from_pem(pem);
+	free(pem);
+	if (!cert)
+		return 0;
+
+	char* commonName = freerdp_certificate_get_common_name(cert, nullptr);
+	char* subject = freerdp_certificate_get_subject(cert);
+	char* issuer = freerdp_certificate_get_issuer(cert);
+	char* fingerprint = freerdp_certificate_get_fingerprint(cert);
+
+	const DWORD result = android_verify_certificate_ex(
+	    instance, hostname, port, commonName ? commonName : "", subject ? subject : "",
+	    issuer ? issuer : "", fingerprint ? fingerprint : "", flags);
+
+	free(commonName);
+	free(subject);
+	free(issuer);
+	free(fingerprint);
+	freerdp_certificate_free(cert);
