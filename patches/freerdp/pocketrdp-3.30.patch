+
+char* jniStringToUtf8(JNIEnv* env, jstring input, size_t* length)
+{
+	jsize utf16Length = 0;
+	jchar* utf16 = jniCopyStringChars(env, input, &utf16Length);
+	if (!utf16)
+		return nullptr;
+
+	size_t utf8Length = 0;
+	char* result = ConvertWCharToUtf8Alloc((const WCHAR*)utf16, &utf8Length);
+	free(utf16);
+	if (length)
+		*length = result ? utf8Length : 0;
+	return result;
+}
+
+jstring jniNewStringUTF(JNIEnv* env, const char* in, int len)
+{
+	if (!env || !in)
+		return nullptr;
+
+	if (len < 0)
+	{
+		const size_t inputLength = strlen(in);
+		if (inputLength > INT32_MAX)
+			return nullptr;
+		len = (int)inputLength;
+	}
+	else if (memchr(in, '\0', (size_t)len) != nullptr)
+	{
+		/* The conversion API is NUL-terminated. Reject embedded NUL instead of returning
+		 * a silently truncated Java string. */
+		return nullptr;
+	}
+
+	char* terminated = (char*)calloc((size_t)len + 1ull, sizeof(char));
+	if (!terminated)
+		return nullptr;
+	memcpy(terminated, in, (size_t)len);
+
+	size_t utf16Length = 0;
+	WCHAR* utf16 = ConvertUtf8ToWCharAlloc(terminated, &utf16Length);
+	free(terminated);
+	if (!utf16 || utf16Length > INT32_MAX)
+	{
+		free(utf16);
+		return nullptr;
+	}
 
+	jstring out = (*env)->NewString(env, (const jchar*)utf16, (jsize)utf16Length);
+	free(utf16);
 	return out;
 }
