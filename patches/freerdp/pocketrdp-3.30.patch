+void multitransport_soft_sync_response_complete(rdpMultitransport* multi, BOOL written)
+{
+	if (!multi)
+		return;
+	EnterCriticalSection(&multi->lock);
+	if (!multi->softSyncResponsePending)
+	{
+		LeaveCriticalSection(&multi->lock);
+		return;
+	}
+	if (!written)
+	{
+		multi->pendingRouteCount = 0;
+		multi->softSyncResponsePending = FALSE;
+		LeaveCriticalSection(&multi->lock);
+		return;
+	}
+	memcpy(multi->activeRoutes, multi->pendingRoutes,
+	       multi->pendingRouteCount * sizeof(multi->pendingRoutes[0]));
+	multi->activeRouteCount = multi->pendingRouteCount;
+	multi->pendingRouteCount = 0;
+	multi->softSyncResponsePending = FALSE;
+	multi->activeMask = 0;
+	for (size_t index = 0; index < multi->activeRouteCount; index++)
+		multi->activeMask |= multi->activeRoutes[index].tunnelMask;
+	multi->softSyncMask = multi->activeMask;
+	if ((multi->activeMask & (FREERDP_UDP_MASK_RELIABLE | FREERDP_UDP_MASK_UDP2)) != 0)
+		rdpudp_tunnel_set_active(multi->reliable.tunnel);
+	if ((multi->activeMask & FREERDP_UDP_MASK_LOSSY) != 0)
+		rdpudp_tunnel_set_active(multi->lossy.tunnel);
+	multi->phase = multi->activeMask != 0 ? FREERDP_TRANSPORT_PHASE_ACTIVE
+	                                     : FREERDP_TRANSPORT_PHASE_TCP;
+	LeaveCriticalSection(&multi->lock);
+}
+
+BOOL multitransport_send_dvc_data(rdpMultitransport* multi, UINT32 channelId, const BYTE* data,
+                                  size_t length, BOOL* routed)
+{
+	if (routed)
+		*routed = FALSE;
+	if (!multi || !routed || !data || length == 0)
+		return FALSE;
+	EnterCriticalSection(&multi->lock);
+	const UINT32 mask = multitransport_route_mask(multi->activeRoutes, multi->activeRouteCount,
+	                                               channelId);
+	if (mask == 0)
+	{
+		LeaveCriticalSection(&multi->lock);
+		return TRUE;
+	}
+	*routed = TRUE;
+	rdpUdpTunnel* tunnel = (mask & FREERDP_UDP_MASK_LOSSY) != 0 ? multi->lossy.tunnel
+	                                                           : multi->reliable.tunnel;
+	const BOOL ok = rdpudp_tunnel_get_state(tunnel) == RDPUDP_TUNNEL_STATE_ACTIVE &&
+	                rdpudp_tunnel_write_data(tunnel, data, length);
+	if (!ok)
+	{
+		multi->failureStage = 104; /* active tunnel write failed */
+		multi->phase = FREERDP_TRANSPORT_PHASE_UDP_FAILED;
+		multi->reconnectRequested = TRUE;
+	}
+	LeaveCriticalSection(&multi->lock);
+	return ok;
+}
