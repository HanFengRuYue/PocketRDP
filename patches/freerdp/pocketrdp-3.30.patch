+static UINT drdynvc_send_soft_sync_response(drdynvcPlugin* drdynvc, const UINT32* tunnelTypes,
+                                            size_t tunnelCount)
+{
+	DVCMAN* dvcman = drdynvc ? (DVCMAN*)drdynvc->channel_mgr : nullptr;
+	if (!dvcman || tunnelCount > 2)
+		return CHANNEL_RC_BAD_CHANNEL_HANDLE;
+	wStream* response = StreamPool_Take(dvcman->pool, 6 + tunnelCount * sizeof(UINT32));
+	if (!response)
+		return CHANNEL_RC_NO_MEMORY;
+	Stream_Write_UINT8(response, SOFT_SYNC_RESPONSE_PDU << 4);
+	Stream_Zero(response, 1);
+	Stream_Write_UINT32(response, WINPR_ASSERTING_INT_CAST(UINT32, tunnelCount));
+	for (size_t index = 0; index < tunnelCount; index++)
+		Stream_Write_UINT32(response, tunnelTypes[index]);
+	drdynvc->softSyncResponse = response;
+	const UINT status = drdynvc_send(drdynvc, response, nullptr);
+	if (status != CHANNEL_RC_OK)
+		drdynvc->softSyncResponse = nullptr;
+	return status;
+}
+
+static UINT drdynvc_process_soft_sync_request(drdynvcPlugin* drdynvc, UINT8 Sp, UINT8 cbChId,
+                                              wStream* s)
+{
+	WINPR_ASSERT(drdynvc);
+	if (Sp != 0 || cbChId != 0 || !Stream_CheckAndLogRequiredLength(TAG, s, 9))
+		return ERROR_INVALID_DATA;
+	/* MS-RDPEDYC Length starts at the Length field itself; it excludes the
+	 * command header and the one-byte Pad field that precedes it. */
+	const size_t declaredPayloadLength = Stream_GetRemainingLength(s) - 1;
+	Stream_Seek(s, 1);
+	UINT32 declaredLength = 0;
+	UINT16 flags = 0;
+	UINT16 tunnelCount = 0;
+	Stream_Read_UINT32(s, declaredLength);
+	Stream_Read_UINT16(s, flags);
+	Stream_Read_UINT16(s, tunnelCount);
+	if (declaredLength != declaredPayloadLength || (flags & SOFT_SYNC_TCP_FLUSHED) == 0 ||
+	    tunnelCount > 2 || ((flags & SOFT_SYNC_CHANNEL_LIST_PRESENT) == 0 && tunnelCount != 0))
+		return ERROR_INVALID_DATA;
+
+	UINT32 channelIds[2][1024] = { 0 };
+	MultitransportSoftSyncList lists[2] = WINPR_C_ARRAY_INIT;
+	for (UINT16 tunnelIndex = 0; tunnelIndex < tunnelCount; tunnelIndex++)
+	{
+		if (!Stream_CheckAndLogRequiredLength(TAG, s, 6))
+			return ERROR_INVALID_DATA;
+		UINT32 tunnelType = 0;
+		UINT16 channelCount = 0;
+		Stream_Read_UINT32(s, tunnelType);
+		Stream_Read_UINT16(s, channelCount);
+		if ((tunnelType != TUNNELTYPE_UDPFECR && tunnelType != TUNNELTYPE_UDPFECL) ||
+		    channelCount > ARRAYSIZE(channelIds[0]) ||
+		    !Stream_CheckAndLogRequiredLength(TAG, s, (size_t)channelCount * sizeof(UINT32)))
+			return ERROR_INVALID_DATA;
+		lists[tunnelIndex].tunnelType = tunnelType;
+		lists[tunnelIndex].channelIds = channelIds[tunnelIndex];
+		lists[tunnelIndex].channelCount = channelCount;
+		for (UINT16 idIndex = 0; idIndex < channelCount; idIndex++)
+		{
+			Stream_Read_UINT32(s, channelIds[tunnelIndex][idIndex]);
+			DVCMAN_CHANNEL* channel = dvcman_get_channel_by_id(
+			    drdynvc->channel_mgr, channelIds[tunnelIndex][idIndex], FALSE);
+			if (!channel || (channel->staticTunnel && tunnelType != TUNNELTYPE_UDPFECR))
+				return ERROR_INVALID_DATA;
+		}
+	}
+	if (Stream_GetRemainingLength(s) != 0)
+		return ERROR_INVALID_DATA;
+
+	rdpMultitransport* multi =
+	    drdynvc->rdpcontext && drdynvc->rdpcontext->rdp
+	        ? drdynvc->rdpcontext->rdp->multitransport
+	        : nullptr;
+	UINT32 accepted[2] = { 0 };
+	size_t acceptedCount = 0;
+	if (!multitransport_prepare_soft_sync(multi, lists, tunnelCount, accepted,
+	                                      ARRAYSIZE(accepted), &acceptedCount))
+		return ERROR_INVALID_DATA;
+	const UINT status = drdynvc_send_soft_sync_response(drdynvc, accepted, acceptedCount);
+	if (status != CHANNEL_RC_OK)
+		multitransport_soft_sync_response_complete(multi, FALSE);
+	return status;
+}
